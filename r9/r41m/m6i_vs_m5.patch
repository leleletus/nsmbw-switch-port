+  set_snd_prio(g_prio_lo);
+  if (g_boost.load(std::memory_order_acquire) != 0) set_snd_prio(g_prio_hi);  // alguien la pidio entretanto
+  else if (t0) st_boost_ns.fetch_add(now_ns() - t0, std::memory_order_relaxed);
+}
