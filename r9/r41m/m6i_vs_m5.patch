+      "vec4 fetch(int x, int gy) {\n"
+      "  vec4 c = texelFetch(uEfb, ivec2(x, uEfbH - 1 - gy), 0);\n"
+      "  if (uHasAlpha == 0) c.a = 1.0;\n"
+      "  return c;\n"
+      "}\n"
+      "vec4 conv(vec4 c) {\n"
+      "  if (uFmt == 0 || uFmt == 1 || uFmt == 8) {\n"
+      "    c = c.rrrr;\n"
+      "  } else if (uFmt == 2 || uFmt == 3) {\n"
+      "    c = c.rrra;\n"
+      "  } else if (uFmt == 4) {\n"
+      "    c = vec4(c.rgb, 1.0);\n"
+      "  } else if (uFmt == 7) {\n"
+      "    c = c.aaaa;\n"
+      "  } else if (uFmt == 9) {\n"
+      "    c = c.gggg;\n"
+      "  } else if (uFmt == 10) {\n"
+      "    c = c.bbbb;\n"
+      "  } else if (uFmt == 11) {\n"
+      "    c = c.rrrg;\n"
+      "  } else if (uFmt == 12) {\n"
+      "    c = c.gggb;\n"
+      "  }\n"
+      "  return c;\n"
+      "}\n"
+      "void main() {\n"
+      "  ivec2 d = ivec2(gl_FragCoord.xy);\n";
