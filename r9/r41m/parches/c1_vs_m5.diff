+  for (;;) {
+    sleep_us(1000000);
+    const uint64_t r = c38_frames_render(), g = c38_frames_game(), now = now_ns();
+    if (r != lr || g != lg) { lr = r; lg = g; t_prog = now; episode = 0; continue; }
+    const double st = (now - t_prog) / 1e9;
+    if (st >= 5.0 * (episode + 1) && episode < 4 && total < 8) {
