+      "#version 330 core\n"
+      "void main() {\n"
+      "  vec2 p = vec2((gl_VertexID & 1) * 4.0 - 1.0, (gl_VertexID & 2) * 2.0 - 1.0);\n"
+      "  gl_Position = vec4(p, 0.0, 1.0);\n"
