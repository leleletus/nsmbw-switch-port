+          if (k == 0) return false;
+          --k;
+          f0 = ldf(keys + 12 * k);
+          if (std::isnan(f0)) return false;
+          cr.fcmpd(fr, f0);
+          ++npolls;
+        } while (cr.lt);
+        ic += 1;
+      } else {      // forward: lfsu f0,12(r4) ; fcmpo f0,f1 ; cror ; beq (poll) ; addi r4,r4,-12
+        do {
+          ic += 4;
+          if (k + 1 >= count) return false;
+          ++k;
+          f0 = ldf(keys + 12 * k);
+          if (std::isnan(f0)) return false;
+          cr.fcmpd(f0, fr); cr.eq = cr.lt | cr.eq;
+          ++npolls;
+        } while (cr.eq);
+        ic += 1;
+        --k;
+      }
+      if (!x1_quiet_polls(ctx, npolls)) return false;
+      r4 = r3 + 8 + 12 * k;
+      ic += 5;
+      const uint8_t *kp = keys + 12 * k;
+      f0 = ldf(kp);
+      cr.fcmpd(fr, f0);
+      if (cr.eq) {
+        f1 = ldf(kp + 4);
+        if (std::isnan(f1)) return false;
+        nf = 4;
+      } else {
+        if (k + 1 >= count) return false;
+        const uint8_t *kc = x1_ram(m, r2 - 19172, 12);
+        if (!kc || !x1_disjoint(kc, 12, gst, 16)) return false;
+        ic += 25;
+        f10 = F.subd(fr, f0);
+        f1 = ldf(kp + 12);
+        f7 = ldf(kp + 4);
+        f11 = F.sub(f1, f0);
+        f0 = ldf(kp + 16);
+        f2 = ldf(kc + 4);
+        f1 = ldf(kc + 8);
+        float in[7] = {f1, f7, f0, f2, ldf(kp + 20), ldf(kc + 0), ldf(kp + 8)};
+        for (float v : in) if (!std::isfinite(v)) return false;
