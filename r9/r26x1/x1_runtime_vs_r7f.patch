+// MSL strcmp (802E1AB4): byte compare until 4-byte alignment, then word compare with the
+// (w - 0x01010101) & ~w & 0x80808080 zero test, then the bytes of the last word. The three loops' polls only
+// when all of them would be quiet. No memory writes; reads through host pointers of plain RAM (else give up).
+bool n2h_802E1AB4(CPUContext &ctx) {
+  MMU &m = ctx.mmu;
+  uint32_t r0 = ctx.gpr[0], r3 = ctx.gpr[3], r4 = ctx.gpr[4], r5 = ctx.gpr[5], r6 = ctx.gpr[6], r7 = ctx.gpr[7],
+           r8 = ctx.gpr[8], ctr = ctx.ctr, ca = (ctx.xer >> 29) & 1;
+  const bool xso = (ctx.xer >> 31) & 1;
+  bool lt = ctx.cr[0].lt, gt = ctx.cr[0].gt, eq = ctx.cr[0].eq, so = ctx.cr[0].so;
+  uint64_t ic = ctx.inst_count, npolls = 0;
+  bool fail = false;
+  auto rd8 = [&](uint32_t ea) -> uint32_t { const uint8_t *p = n2_ram(m, ea, 1); if (!p) { fail = true; return 0; } return *p; };
+  auto rd32 = [&](uint32_t ea) -> uint32_t { const uint8_t *p = n2_ram(m, ea, 4); if (!p) { fail = true; return 0; } return ld32(p); };
+  auto rec = [&](uint32_t v) { lt = (int32_t)v < 0; gt = (int32_t)v > 0; eq = v == 0; };             // subf. / and. (no SO, as G5 emits)
+  auto cmpwi0 = [&](uint32_t v) { lt = (int32_t)v < 0; gt = (int32_t)v > 0; eq = v == 0; so = xso; };
+  auto cmplw = [&](uint32_t a, uint32_t b) { lt = a < b; gt = a > b; eq = a == b; so = xso; };
+  enum { WORD, BYTES, DONE } st;
+  ic += 6;
+  r5 = rd8(r3); r0 = rd8(r4); if (fail) return false;
+  r0 = r5 - r0; rec(r0);
+  if (!eq) { r3 = r0; st = DONE; goto out; }
+  ic += 10;
+  r0 = r4 & 3; r6 = r3 & 3;
+  cmplw(r0, r6);
+  if (!eq) { st = BYTES; goto bytes; }
+  cmpwi0(r6);
+  if (eq) { st = WORD; goto word; }
+  cmpwi0(r5);
+  if (eq) { r3 = 0; goto out; }
+  ic += 4;
+  { const uint64_t res = (uint64_t)(uint32_t)~r6 + 3u + 1u; r0 = (uint32_t)res; ca = (uint32_t)(res >> 32) & 1u; }  // subfic r0,r6,3
+  ctr = r0;
+  cmpwi0(r0);
+  if (!eq) {
+    for (;;) {
+      ic += 6;
+      r3 += 1; r5 = rd8(r3); r4 += 1; r0 = rd8(r4); if (fail) return false;
+      r0 = r5 - r0; rec(r0);
+      if (!eq) { r3 = r0; goto out; }
+      ic += 4;
+      cmpwi0(r5);
+      if (eq) { r3 = 0; goto out; }
+      ic += 1;
+      ++npolls;             // poll 0x802E1B2C (bdnz)
+      if (--ctr == 0) break;
+      if (npolls > 4096) return false;
+    }
+  }
+  ic += 2;
+  r3 += 1; r4 += 1;
+word:
+  ic += 10;
+  r7 = rd32(r3);
+  r5 = 0x80810000u;
+  r6 = 0x80808080u;
+  r8 = rd32(r4); if (fail) return false;
+  r5 = r7 + 0xFEFF0000u; r5 = r5 + 0xFFFFFEFFu;  // addis/addi: r7 - 0x01010101
+  r5 = r5 & ~r7;
+  r0 = r5 & r6; rec(r0);
+  if (eq) {
+    for (;;) {  // B78: cmplw r7,r8 ; beq B60 (poll 0x802E1B7C)
+      ic += 2;
+      cmplw(r7, r8);
+      ++npolls;
+      if (!eq) break;
+      if (npolls > 65536) return false;
+      ic += 6;  // B60
+      r3 += 4; r7 = rd32(r3); r4 += 4; r8 = rd32(r4); if (fail) return false;
+      r5 = r7 + 0xFEFF0000u;
+      r0 = r5 + 0xFFFFFEFFu;
+      r0 = r0 & r6; rec(r0);
+      if (!eq) break;
+    }
+  }
+  ic += 6;  // B80
+  r5 = rd8(r3); r0 = rd8(r4); if (fail) return false;
+  r0 = r5 - r0; rec(r0);
+  if (!eq) { r3 = r0; goto out; }
+bytes:
+  ic += 4;  // B98
+  cmpwi0(r5);
+  if (eq) { r3 = 0; goto out; }
+  for (;;) {
+    ic += 6;  // BA8
+    r3 += 1; r5 = rd8(r3); r4 += 1; r0 = rd8(r4); if (fail) return false;
+    r0 = r5 - r0; rec(r0);
+    if (!eq) { r3 = r0; goto out; }
+    ic += 2;
+    cmpwi0(r5);
+    ++npolls;  // poll 0x802E1BC4
+    if (eq) break;
+    if (npolls > 65536) return false;
+  }
+  ic += 2;
+  r3 = 0;
+out:
+  (void)st;
+  if (npolls) {
+    const int32_t left = ctx.poll_left.load(std::memory_order_relaxed);
+    if ((int64_t)left <= (int64_t)npolls || !n1_no_flags(ctx)) return false;
+    ctx.poll_left.store(left - (int32_t)npolls, std::memory_order_relaxed);
+  }
+  ctx.gpr[0] = r0; ctx.gpr[3] = r3; ctx.gpr[4] = r4; ctx.gpr[5] = r5; ctx.gpr[6] = r6; ctx.gpr[7] = r7; ctx.gpr[8] = r8;
+  ctx.ctr = ctr;
+  ctx.xer = (ctx.xer & ~(1u << 29)) | (ca << 29);
+  ctx.cr[0].lt = lt; ctx.cr[0].gt = gt; ctx.cr[0].eq = eq; ctx.cr[0].so = so;
+  ctx.inst_count = ic;
+  ctx.pc = ctx.lr;
+  return true;
+}
