+// 80240240: curve with quantized keys {frame (GQR6), value (GQR3), slope (GQR7)} of 6 bytes after
+// {u16 count; f32 s4, scale, offset} at r3; value = scale * q + offset. The search compares the frame quantized
+// with GQR6 through the stack (lha) with the raw 16-bit key frames (lhau -6 backward, poll 0x80240300; lhau +6
+// forward, poll 0x80240310).
+// inst_count: 80240240: +16 ; 80280: +9 ; 802A4: +21 ; back 802F8 / fwd 80308: +3 per iteration, +1 at exit ;
+// 80318: +8 ; 80338: +31 ; 803B4: +2.
+bool x1h_80240240(CPUContext &ctx) {
+  MMU &m = ctx.mmu;
+  if (g_watch_addr) return false;
+  const double f1d = ctx.fpr[1];
+  if (!std::isfinite(f1d)) return false;
+  const double fr = f1d;  // the frame: any finite double (compares in double, fsubs = ppc_single(f1 - x))
+  const uint32_t r1 = ctx.gpr[1], r2 = ctx.gpr[2], r3 = ctx.gpr[3];
+  uint8_t *gst = x1_ram(m, r1 - 16, 16);
+  const uint8_t *hdr = x1_ram(m, r3, 16);
+  if (!gst || !hdr) return false;
+  const uint32_t count = (uint32_t)hdr[0] << 8 | hdr[1];
+  if (count == 0) return false;
+  const uint32_t tbytes = 16 + 6 * count + 4;  // (+4: a float-type psq_l of the last key's slope reads past it)
+  const uint8_t *tab = x1_ram(m, r3, tbytes);
+  if (!tab || !x1_disjoint(tab, tbytes, gst, 16)) return false;
+  const uint8_t *keys = tab + 16;
+  const X1Gq q3(ctx.gqr[3]), q6(ctx.gqr[6]), q7(ctx.gqr[7]);
+  if (!q3.valid() || !q6.valid() || !q7.valid()) return false;
+  const bool so = (ctx.xer >> 31) & 1;
+  uint8_t fs[16];
+  std::memcpy(fs, gst, 16);
+  st32(fs + 0, r1);
+  X1F F;
+  X1Cr cr;
+  uint64_t ic = ctx.inst_count + 16;
+  uint32_t r5 = r3 + 16, r6 = count;
+  uint32_t r0 = (r6 - 1) * 6u, r4 = r3 + r0 + 16;
+  float f0 = q6.load(keys), f1 = 0, f2 = 0, f3 = 0, f4 = 0, f5 = 0, f6 = 0, f7 = 0, f8 = 0, f9 = 0, f10 = 0, f11 = 0;
+  // ps1 of the registers a psq_l leaves last (1.0) instead of a fill
+  bool f0q = true, f2q = false, f6q = false, f7q = false;
+  int nf = 0;  // 3: f0-f2 ; 4: f0-f3 ; 12: f0-f11
+  const float scale = ldf(hdr + 8), offs = ldf(hdr + 12);
+  if (!std::isfinite(scale) || !std::isfinite(offs)) return false;
+  // the value of a key: psq_l f2,2(rK),1,3 ; lfs f1,8(r3) ; lfs f0,12(r3) ; fmadds f1,f1,f2,f0
+  auto value_tail = [&](const uint8_t *kp) {
+    f2 = q3.load(kp + 2); f2q = true;
+    f0 = offs; f0q = false;
+    f1 = F.madd(scale, f2, offs);
+    nf = 3;
+  };
