+// host pointer of [ea, ea+n) when all of it is plain guest RAM, else nullptr
+NWII_FORCEINLINE uint8_t *n2_ram(MMU &m, uint32_t ea, uint32_t n) {
+  const uint32_t p = ea & 0x3FFFFFFF;
+  if (p >= 0x10u && p + n <= MMU::kMem1Size && p + n > p) return m.mem1.data() + p;
+  // r26x1: n bounded first (kLCSize - n must not wrap for a large n; every caller here has n <= 4 KB anyway)
+  if (n <= MMU::kMem2Size && p - 0x10000000u <= MMU::kMem2Size - n) return m.mem2.data() + (p - 0x10000000u);
+  if (n <= MMU::kLCSize && ea - MMU::kLCBase <= MMU::kLCSize - n) return m.lc.data() + (ea - MMU::kLCBase);
+  return nullptr;
+}
+NWII_FORCEINLINE bool n2_disjoint(const uint8_t *a, uint32_t na, const uint8_t *b, uint32_t nb) {
+  return a + na <= b || b + nb <= a;
+}
+NWII_FORCEINLINE uint32_t ld32(const uint8_t *p) { uint32_t v; std::memcpy(&v, p, 4); return __builtin_bswap32(v); }
+NWII_FORCEINLINE void st32(uint8_t *p, uint32_t v) { v = __builtin_bswap32(v); std::memcpy(p, &v, 4); }
+NWII_FORCEINLINE void st64(uint8_t *p, uint64_t v) { v = __builtin_bswap64(v); std::memcpy(p, &v, 8); }
+NWII_FORCEINLINE float f32b(uint32_t u) { float f; std::memcpy(&f, &u, 4); return f; }
+NWII_FORCEINLINE uint32_t b32f(float f) { uint32_t u; std::memcpy(&u, &f, 4); return u; }
+NWII_FORCEINLINE uint64_t b64d(double d) { uint64_t u; std::memcpy(&u, &d, 8); return u; }
+// a single that the generated code would not reproduce by plain copy: NaN (quieted by float->double) or
+// subnormal (flushed by psq_st)
+NWII_FORCEINLINE bool odd_bits(uint32_t u) {
+  const uint32_t e = u & 0x7F800000u, f = u & 0x007FFFFFu;
+  return f != 0 && (e == 0 || e == 0x7F800000u);
+}
+// computed single that the double emulation could round differently (single subnormal range)
+NWII_FORCEINLINE bool tiny(float r) {
+  const float a = std::fabs(r);
+  return a < 0x1p-125f && a != 0.0f;
+}
+// NaN inputs: which NaN comes out of an operation with two NaN operands depends on the instruction and its
+// operand order (double vs single FMA, x86 libm fma vs fmaf...): the float bodies leave all of them to the
+// generated code (a NaN made inside the body, e.g. inf*0, is the default NaN on both paths).
+NWII_FORCEINLINE bool any_nan_f(const float *v, int n) {
+  bool r = false;
+  for (int i = 0; i < n; ++i) r |= std::isnan(v[i]);
+  return r;
+}
+NWII_FORCEINLINE bool gqr0_float(const CPUContext &c) { return (c.gqr[0] & 0x00070007u) == 0; }
+NWII_FORCEINLINE void setps(CPUContext &c, int r, float a, float b) { c.fpr[r] = a; c.ps1[r] = b; }
+
