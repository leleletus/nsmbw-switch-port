+  ctx.cr[0].lt = lt; ctx.cr[0].gt = gt; ctx.cr[0].eq = eq; ctx.cr[0].so = un;
+  ctx.gpr[0] = r0; ctx.gpr[4] = r4; ctx.gpr[5] = r5; ctx.gpr[6] = r6; ctx.gpr[7] = r7;
+  ctx.inst_count = ic;
+  ctx.pc = ctx.lr;
