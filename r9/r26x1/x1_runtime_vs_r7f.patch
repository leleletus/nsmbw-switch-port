+// sqrt (802E8868: "b __ieee754_sqrt" + fdlibm's e_sqrt.c at 802E8620, one generated function func_802E8868
+// entered at 0x802E8868). Bit-by-bit square root: loop 1 (22 iterations, r7 = 2^21..1) builds the high word
+// q (r12) with s0 (r11) and the remainder ix0 (r6) / ix1 (r0); loop 2 (32 iterations, r7 = 2^31..1) builds the
+// low word q1 (r10) with s1 (r9); then the rounding block (z = one - tiny; fcmpu f0,f0 ...) and the result
+// assembled through the stack. Every branch of both loops goes through a poll (0x802E8754 / 0x802E87CC), plus the
+// one of the "b" at the entry (0x802E8868). Here: x > 0 finite and normal (exponent 1..0x7FE: the usual
+// case) and +-0 (returned as is); negative, subnormal, inf and NaN go to the generated code (they write errno or run the normalisation
+// loops). The loops are the generated code's statements with the comparisons as selects (no data-dependent
+// branches), registers in locals, inst_count with the generated code's per-block sums:
+//   entry 0x802E8868: +1 ; 8620: +13 ; 8654: +6 ; 8684: +3 ; 86D8: +9 ; 86FC: +10 ; loop-1 test 8750: +2 ;
+//   loop-1 body 8724: +6, 873C: +5 ; 8758: +2 ; loop-2 test 87C8: +2 ; loop-2 body 8760: +7, taken part 877C: +8,
+//   879C: +4, 87AC: +2, then 87B4: +5 ; 87D0: +14 ; 8808: +5 ; 8824: +2 ; 882C: +7 ; 8848: +6 ; 8860: +2.
+bool x1h_802E8868(CPUContext &ctx) {
+  MMU &m = ctx.mmu;
+  if (g_watch_addr) return false;
+  const uint64_t xb = b64d(ctx.fpr[1]);
+  const uint32_t hx = (uint32_t)(xb >> 32), lx = (uint32_t)xb;
+  const uint32_t ex = (hx >> 20) & 0x7FFu;
+  const bool zero = ((hx & 0x7FFFFFFFu) | lx) == 0;
+  if (!zero && ((int32_t)hx <= 0 || ex == 0 || ex == 0x7FFu)) return false;
+  const uint32_t r1in = ctx.gpr[1], r2 = ctx.gpr[2];
+  uint8_t *stk = x1_ram(m, r1in - 32, 32);
+  const uint8_t *kp = x1_ram(m, r2 - 13512, 8);
