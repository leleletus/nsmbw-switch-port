+  st32(d + 24, u0); st32(d + 28, u0);
+  st32(d + 32, u0); st32(d + 36, u0);
+  st32(d + 16, u0); st32(d + 20, u1);
+  st32(d + 0, u1); st32(d + 4, u0);
+  st32(d + 40, u1); st32(d + 44, u0);
+  const float c0 = f32b(u0), c1 = f32b(u1);
