+// The single interrupt poll of a function that runs no loop iteration: it can only be skipped when the inline
+// part of the generated poll would find nothing (poll_left > 1, and MSR[EE] clear or no flag): then it is
+// just the poll_left decrement. Otherwise the generated code runs (nothing touched yet).
+NWII_FORCEINLINE bool quiet_poll(CPUContext &c) {
+  const int32_t left = c.poll_left.load(std::memory_order_relaxed);
+  if (left <= 1 || !n1_no_flags(c)) return false;
+  c.poll_left.store(left - 1, std::memory_order_relaxed);
+  return true;
+}
+NWII_FORCEINLINE void fcmp0(CPUContext &c, double a, double b) {
+  const bool un = std::isnan(a) || std::isnan(b);
+  c.cr[0].lt = !un && a < b; c.cr[0].gt = !un && a > b; c.cr[0].eq = !un && a == b; c.cr[0].so = un;
+}
+NWII_FORCEINLINE void fillr(CPUContext &c, int r, double v) { c.fpr[r] = v; c.ps1[r] = v; }
