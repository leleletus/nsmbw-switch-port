+  r7 = 0x80000000u;
+  // ---- loop 2: test at 87C8 (cmpwi r7,0 ; bne 8760, poll 0x802E87CC)
+  for (;;) {
+    ic += 2;
+    c0lt = (int32_t)r7 < 0; c0gt = (int32_t)r7 > 0; c0eq = r7 == 0; c0so = so;
+    if (!P.fast()) {
