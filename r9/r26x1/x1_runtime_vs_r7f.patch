+      if (P.slow(0x802E8868u)) return true;
+      ctx.inst_count -= 1;
+    }
+    P.flush();
+    st32(stk + 0, r1in);
+    st64(stk + 8, b64d(ctx.fpr[1]));
+    const bool so = (ctx.xer >> 31) & 1;
+    ctx.cr[0].lt = false; ctx.cr[0].gt = false; ctx.cr[0].eq = true; ctx.cr[0].so = so;
+    ctx.cr[1].lt = (int32_t)hx < 0; ctx.cr[1].gt = false; ctx.cr[1].eq = hx == 0; ctx.cr[1].so = so;
