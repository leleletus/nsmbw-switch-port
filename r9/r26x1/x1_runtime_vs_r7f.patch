+    ca = (ctx.xer >> 29) & 1;
+    c0eq = ctx.cr[0].eq;
+    r0 = ctx.gpr[0]; r3 = ctx.gpr[3]; r4 = ctx.gpr[4]; r5 = ctx.gpr[5]; r6 = ctx.gpr[6]; r7 = ctx.gpr[7];
