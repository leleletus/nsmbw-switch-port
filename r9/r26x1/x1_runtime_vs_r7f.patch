+  } else {
+    ic += 9;
+    const uint8_t *kl = keys + 6 * (count - 1);
+    f0 = q6.load(kl);
+    cr.fcmpd(f0, fr); cr.eq = cr.lt | cr.eq;
+    if (cr.eq) {
+      value_tail(kl);
+    } else {
+      ic += 21;
+      f0 = q6.load(keys);
+      fs[10] = (uint8_t)(r6 >> 8); fs[11] = (uint8_t)r6;   // sth r6,10(r1)
+      f3 = F.subd(fr, f0);
+      f2 = q3.load(fs + 10);                               // psq_l f2,10(r1),1,3
+      f0 = ldf(hdr + 4);
+      if (!std::isfinite(f0)) return false;
+      f2 = F.mul(f3, f2);
+      f0 = F.mul(f0, f2); f0q = false;
+      q3.store(fs + 12, (double)f0);                       // psq_st f0,12(r1),1,3
+      r5 = r1 - 16 + 8;
+      r0 = ((uint32_t)fs[12] << 8 | fs[13]) * 6u;
+      uint32_t k = r0 / 6u;
+      q6.store(fs + 8, (double)fr);                        // psq_st f1,8(r1),1,6
+      if (F.bad || k >= count) return false;
