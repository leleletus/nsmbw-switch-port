+// r26x1 (front X1): more hand-written native bodies for hot nw4r / RVL SDK / MSL math functions of the game
+// thread, on top of the ones of front N (native_n1.cpp, native_n2.cpp). Same contract as N (native_n1.h): a body
+// returns true only after leaving ctx and guest memory exactly as the generated code leaves them at its blr (every
+// register it writes, the volatile ones too, the ps1 halves, CR, XER, inst_count with the generated code's own
+// per-block sums, the stack bytes, the same interrupt polls with the same state), and returns false without
+// touching anything when a precondition does not hold (the generated code then runs as before).
+//
+// Interrupt polls inside loops: a poll whose inline part (poll_due) would find nothing to do (poll_left > 1 and
+// MSR[EE] clear or no flag set) only decrements poll_left, in a local copy; any other poll is done for real with
+// ctx in the exact state the generated code spills at that poll (ctx.pc = the poll address); if it delivers an
+// interrupt the body returns true right there (the generated function would `return;` there too, and run_game
+// resumes at that poll address through the function's entry switch). After a slow poll that delivers nothing,
+// the locals are reloaded from ctx as the generated code does.
+#include "runtime/native_n1.h"
+#include "runtime/native_n1_fp.h"
+
+#include <bit>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+namespace nwii {
+namespace runtime {
+namespace {
+
+// host pointer of [ea, ea+n) when all of it is plain guest RAM, else nullptr (as native_n2.cpp)
+NWII_FORCEINLINE uint8_t *x1_ram(MMU &m, uint32_t ea, uint32_t n) {
+  const uint32_t p = ea & 0x3FFFFFFF;
+  if (p >= 0x10u && p + n <= MMU::kMem1Size && p + n > p) return m.mem1.data() + p;
+  // (n bounded first: the curve tables / matrix arrays have a variable n, and kLCSize - n must not wrap; found by the
+  // comparator with random pointers: a table of 390 KB "fitted" in the 256 KB locked cache)
+  if (n <= MMU::kMem2Size && p - 0x10000000u <= MMU::kMem2Size - n) return m.mem2.data() + (p - 0x10000000u);
+  if (n <= MMU::kLCSize && ea - MMU::kLCBase <= MMU::kLCSize - n) return m.lc.data() + (ea - MMU::kLCBase);
+  return nullptr;
+}
+NWII_FORCEINLINE bool x1_disjoint(const uint8_t *a, uint32_t na, const uint8_t *b, uint32_t nb) {
+  return a + na <= b || b + nb <= a;
+}
+NWII_FORCEINLINE uint32_t ld32(const uint8_t *p) { uint32_t v; std::memcpy(&v, p, 4); return __builtin_bswap32(v); }
+NWII_FORCEINLINE uint64_t ld64(const uint8_t *p) { uint64_t v; std::memcpy(&v, p, 8); return __builtin_bswap64(v); }
+NWII_FORCEINLINE void st32(uint8_t *p, uint32_t v) { v = __builtin_bswap32(v); std::memcpy(p, &v, 4); }
+NWII_FORCEINLINE void st64(uint8_t *p, uint64_t v) { v = __builtin_bswap64(v); std::memcpy(p, &v, 8); }
+NWII_FORCEINLINE uint64_t b64d(double d) { uint64_t u; std::memcpy(&u, &d, 8); return u; }
+NWII_FORCEINLINE double d64b(uint64_t u) { double d; std::memcpy(&d, &u, 8); return d; }
+
+// Local poll countdown of a native loop (see the header comment). fast() = a quiet poll, counted locally;
+// otherwise the caller spills its state, calls slow(pc), and reloads its state if it returns false.
+struct X1Poll {
+  CPUContext &c;
+  int32_t start, left;
+  bool quiet;
+  explicit X1Poll(CPUContext &cc)
+      : c(cc), start(cc.poll_left.load(std::memory_order_relaxed)), left(start), quiet(n1_no_flags(cc)) {}
+  NWII_FORCEINLINE bool fast() {
+    if (NWII_LIKELY(left > 1 && quiet)) { --left; return true; }
+    return false;
+  }
+  // the local count back to ctx unless another thread kicked poll_left meanwhile (the kick stays)
+  NWII_FORCEINLINE void flush() {
+    if (left != start) {
+      const int32_t now = c.poll_left.load(std::memory_order_relaxed);
+      if (now == start) c.poll_left.store(left, std::memory_order_relaxed);
+      start = left = (now == start) ? left : now;
+    }
+  }
+  // a poll for real: ctx must already hold the state of this poll. true = an interrupt was delivered.
+  NWII_NOINLINE bool slow(uint32_t pc) {
+    flush();
+    c.pc = pc;
+    bool irq = false;
+    if (poll_due(c)) {
+      ++g_n1_slow;
+      irq = process_pending_callbacks_slow(c);
+    }
+    start = left = c.poll_left.load(std::memory_order_relaxed);
+    quiet = n1_no_flags(c);
+    return irq;
+  }
+};
