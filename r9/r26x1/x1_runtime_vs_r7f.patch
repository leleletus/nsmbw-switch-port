+// nw4r::math MTX34 paired-single leaves, round-N2 method (singles on host pointers, see native_n2.cpp): every load
+// comes before the first store in both, so any overlap of dst with the sources ends the same way when the stores
+// go in program order. NaN inputs, results in the single subnormal range and GQR0 not float -> generated code.
+namespace {
+NWII_FORCEINLINE bool x1_gqr0_float(const CPUContext &c) { return (c.gqr[0] & 0x00070007u) == 0; }
+NWII_FORCEINLINE void setps(CPUContext &c, int r, float a, float b) { c.fpr[r] = a; c.ps1[r] = b; }
+NWII_FORCEINLINE void stf(uint8_t *p, float v) { uint32_t u; std::memcpy(&u, &v, 4); st32(p, u); }
+}  // namespace
