+  const uint32_t r1n = r1 - 32;
+  float f[12];
+  bool q[12] = {};
+  uint32_t wm = 0;  // FPRs written
+  auto setf = [&](int r, float v) { f[r] = v; q[r] = false; wm |= 1u << r; };
+  auto setq = [&](int r, float v) { f[r] = v; q[r] = true; wm |= 1u << r; };
