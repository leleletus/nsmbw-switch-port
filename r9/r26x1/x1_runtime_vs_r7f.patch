+// 80240100: curve with float keys {f32 frame, value, slope} (12 bytes) after {u16 count; f32 s4} at r3.
+//   first/last key clamps; idx = u16(s4 * ((f1 - key0) * count)) through the stack (GQR3); linear search
+//   backward (lfsu -12, poll 0x80240198) or forward (lfsu +12, poll 0x802401AC); exact key hit; else Hermite.
+// inst_count: 8240100: +13 ; 80134: +6 ; 8014C: +17 ; back 80190: +3 per iteration, +1 at exit ;
+// fwd 801A0: +4 per iteration, +1 at exit ; 801B4: +5 ; 801C8: +25 ; 8022C: +2.
+bool x1h_80240100(CPUContext &ctx) {
+  MMU &m = ctx.mmu;
+  if (g_watch_addr) return false;
+  const double f1d = ctx.fpr[1];
+  if (!std::isfinite(f1d)) return false;
+  const double fr = f1d;  // the frame: any finite double (compares in double, fsubs = ppc_single(f1 - x))
+  const uint32_t r1 = ctx.gpr[1], r2 = ctx.gpr[2], r3 = ctx.gpr[3];
+  uint8_t *gst = x1_ram(m, r1 - 16, 16);
+  const uint8_t *hdr = x1_ram(m, r3, 8);
+  if (!gst || !hdr) return false;
+  const uint32_t count = (uint32_t)hdr[0] << 8 | hdr[1];
+  if (count == 0) return false;
+  const uint32_t tbytes = 8 + 12 * count;
+  const uint8_t *tab = x1_ram(m, r3, tbytes);
+  if (!tab || !x1_disjoint(tab, tbytes, gst, 16)) return false;
+  const uint8_t *keys = tab + 8;
+  const X1Gq q3(ctx.gqr[3]);
+  if (!q3.valid()) return false;
+  uint8_t fs[16];
+  std::memcpy(fs, gst, 16);
+  st32(fs + 0, r1);
+  const uint32_t r1n = r1 - 16;
+  X1F F;
+  X1Cr cr;
+  uint64_t ic = ctx.inst_count + 13;
+  const uint32_t r5 = r3 + 8, r6 = count;
+  uint32_t r0 = (r6 - 1) * 12u, r4 = r3 + r0 + 8;
+  float f0 = ldf(keys), f2 = 0, f3 = 0, f4 = 0, f5 = 0, f6 = 0, f7 = 0, f8 = 0, f9 = 0, f10 = 0, f11 = 0, f1 = 0;
+  double p2 = 0;  // ps1 of f2 when it is a psq_l result
+  int nf = 0;     // how many FPRs the path writes: 2 (f0,f1), 4 (f0-f3, f2 filled), 12 (f0-f11)
+  if (std::isnan(f0)) return false;
+  cr.fcmpd(fr, f0); cr.eq = cr.lt | cr.eq;
+  if (cr.eq) {
+    f1 = ldf(keys + 4);
+    if (std::isnan(f1)) return false;
+    nf = 2;
+  } else {
+    ic += 6;
+    f0 = ldf(tab + r0 + 8);
+    if (std::isnan(f0)) return false;
+    cr.fcmpd(f0, fr); cr.eq = cr.lt | cr.eq;
+    if (cr.eq) {
+      f1 = ldf(tab + r0 + 12);
+      if (std::isnan(f1)) return false;
+      nf = 2;
+    } else {
+      ic += 17;
+      f0 = ldf(keys);
+      fs[8] = (uint8_t)(r6 >> 8); fs[9] = (uint8_t)r6;   // sth r6,8(r1)
+      f3 = F.subd(fr, f0);
