+        f6 = F.res(f11);
+        f9 = in[4];
+        f4 = in[5];
+        f8 = in[6];
+        f5 = F.add(f6, f6);
+        f3 = F.mul(f6, f6);
+        f6 = F.nmsub(f11, f3, f5);
+        f3 = F.mul(f10, f6);
+        f5 = F.msub(f10, f6, f4);
+        f1 = F.msub(f2, f3, f1);
+        f2 = F.mul(f3, f9);
+        f4 = F.mul(f10, f5);
+        f0 = F.mul(f1, f0);
