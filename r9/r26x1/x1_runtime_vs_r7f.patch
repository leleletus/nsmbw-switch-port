+  }
+  if (nf >= 12) {
+    fillf(ctx, 4, f4); fillf(ctx, 5, f5); fillf(ctx, 6, f6); fillf(ctx, 7, f7);
+    fillf(ctx, 8, f8); fillf(ctx, 9, f9); fillf(ctx, 10, f10); fillf(ctx, 11, f11);
+  }
+  ctx.cr[0].lt = cr.lt; ctx.cr[0].gt = cr.gt; ctx.cr[0].eq = cr.eq; ctx.cr[0].so = cr.so;
+  ctx.gpr[0] = r0; ctx.gpr[4] = r4; ctx.gpr[5] = r5; ctx.gpr[6] = r6;
+  ctx.inst_count = ic;
+  ctx.pc = ctx.lr;
+  return true;
+}
