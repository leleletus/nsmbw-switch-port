+// 80238200 (MTX34 times a scale matrix, translation column: t' = M * (v, 1)): r3 = dst, r4 = src, r5 = v.
+// 27 instructions; the ps_sum0 keep the incoming ps1 of f10 (ppc_single of it, then of that again: idempotent).
+//   psq_l f2,0(r4) ; psq_l f0,0(r5) ; psq_l f3,8(r4) ; psq_l f4,16(r4) ; ps_mul f8,f2,f0 ; psq_l f1,8(r5),1,0 ;
+//   psq_l f5,24(r4) ; ps_madd f9,f3,f1,f8 ; psq_l f6,32(r4) ; ps_mul f8,f4,f0 ; psq_l f7,40(r4) ; psq_st f3,8(r3) ;
+//   ps_sum0 f10,f9,f10,f9 ; ps_madd f9,f5,f1,f8 ; psq_st f5,24(r3) ; ps_mul f8,f6,f0 ; psq_st f10,12(r3),1,0 ;
+//   ps_sum0 f10,f9,f10,f9 ; ps_madd f9,f7,f1,f8 ; psq_st f7,40(r3) ; psq_st f10,28(r3),1,0 ; ps_sum0 f10,f9,f10,f9 ;
+//   psq_st f2,0(r3) ; psq_st f4,16(r3) ; psq_st f6,32(r3) ; psq_st f10,44(r3),1,0 ; blr
+bool x1h_80238200(CPUContext &c) {
