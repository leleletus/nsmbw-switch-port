+  if (!P.fast()) {
+    ctx.inst_count = ic;
+    if (P.slow(0x802E8868u)) return true;
+    ic = ctx.inst_count;
+    // registers are reloaded below from ctx (they cannot have changed unless an interrupt was delivered)
