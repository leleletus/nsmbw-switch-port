+// 802381A0 (MTX34 scale: dst = src * diag(v)): r3 = dst, r4 = src, r5 = v. 21 instructions.
+//   psq_l f0,0(r5) ; psq_l f2,0(r4) ; psq_l f4,16(r4) ; psq_l f5,32(r4) ; ps_mul f2,f2,f0 ; ps_mul f4,f4,f0 ;
+//   psq_l f1,8(r5),1,0 ; ps_mul f5,f5,f0 ; psq_l f3,8(r4) ; psq_l f0,24(r4) ; psq_l f6,40(r4) ; ps_mul f3,f3,f1 ;
+//   psq_st f2,0(r3) ; ps_mul f0,f0,f1 ; ps_mul f6,f6,f1 ; psq_st f3,8(r3) ; psq_st f4,16(r3) ; psq_st f0,24(r3) ;
+//   psq_st f5,32(r3) ; psq_st f6,40(r3) ; blr
+bool x1h_802381A0(CPUContext &c) {
+  MMU &m = c.mmu;
+  if (g_watch_addr || !x1_gqr0_float(c)) return false;
+  const uint8_t *pv = x1_ram(m, c.gpr[5], 12), *ps = x1_ram(m, c.gpr[4], 48);
+  uint8_t *pd = x1_ram(m, c.gpr[3], 48);
+  if (!pv || !ps || !pd) return false;
+  float M[12], V[3];
+  bool nan = false;
+  for (int i = 0; i < 12; ++i) { M[i] = ldf(ps + 4 * i); nan |= std::isnan(M[i]); }
+  for (int i = 0; i < 3; ++i) { V[i] = ldf(pv + 4 * i); nan |= std::isnan(V[i]); }
+  if (nan) return false;
+  X1F F;
+  const float a0 = F.mul(M[0], V[0]), a1 = F.mul(M[1], V[1]);    // f2
+  const float b0 = F.mul(M[4], V[0]), b1 = F.mul(M[5], V[1]);    // f4
+  const float c0 = F.mul(M[8], V[0]), c1 = F.mul(M[9], V[1]);    // f5
+  const float d0 = F.mul(M[2], V[2]), d1 = F.mul(M[3], 1.0f);    // f3
+  const float e0 = F.mul(M[6], V[2]), e1 = F.mul(M[7], 1.0f);    // f0
+  const float g0 = F.mul(M[10], V[2]), g1 = F.mul(M[11], 1.0f);  // f6
+  if (F.bad) return false;
+  stf(pd + 0, a0); stf(pd + 4, a1);
+  stf(pd + 8, d0); stf(pd + 12, d1);
+  stf(pd + 16, b0); stf(pd + 20, b1);
+  stf(pd + 24, e0); stf(pd + 28, e1);
+  stf(pd + 32, c0); stf(pd + 36, c1);
+  stf(pd + 40, g0); stf(pd + 44, g1);
+  setps(c, 0, e0, e1);
+  setps(c, 1, V[2], 1.0f);
+  setps(c, 2, a0, a1);
+  setps(c, 3, d0, d1);
+  setps(c, 4, b0, b1);
+  setps(c, 5, c0, c1);
+  setps(c, 6, g0, g1);
+  c.inst_count += 21;
+  c.pc = c.lr;
+  return true;
+}
