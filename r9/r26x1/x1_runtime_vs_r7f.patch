+// ---------------------------------------------------------------------------------------------------------
+// nw4r g3d animation curves: the float-key (80240100) and quantized-key (80240240) siblings of 802403C0.
+// Same method as N4 (all guest reads first; the search loops' polls only when all of them would be quiet,
+// then just the countdown; the 16-byte stack frame in a local copy written at the end), but the arithmetic in
+// host single precision instead of the double emulation of every instruction, which is exact here:
+//  * every operand is a single except f1 (the frame, any finite double: compared in double, and its fsubs is
+//    computed as the emulation does, ppc_single(f1 - x)); the keys come from lfs / psq_l (float or a
+//    dequantized integer: (float)int * scale, a single); every result is rounded to single by the instruction;
+//  * fsubs/fadds of two singles: the double difference is exact unless the exponents are > 29 apart, and then
+//    it is so close to the larger operand that rounding it again to single cannot cross a single midpoint;
+//    fmuls: the double product of two singles is exact (force25 of a single is itself); fmadds/fmsubs/ps_nmsub:
+//    ppc_madd_s + ppc_single = one rounding of the exact a*c+b (cpu_context.h) = std::fma in single;
+//    fres: ppc_fres itself (its result is a single when it is finite and in range: checked);
+//  * results in the single subnormal range (double rounding at the subnormal position), infinities and NaN
+//    make the body give up before writing anything (the generated code runs), as do NaN/inf inputs;
+//  * every FPR the code writes is a "fill" (ps0 = ps1) except psq_l W=1 (ps1 = 1.0), kept as such.
+namespace {
+struct X1Gq {  // one GQR, decoded once (CPUContext::psq_load / psq_store bodies, W = 1)
+  uint32_t lt, st;
+  float lscale;
+  double sscale;
+  explicit X1Gq(uint32_t g)
+      : lt((g >> 16) & 7), st(g & 7), lscale((float)gqr_pow2(-gqr_scale(g >> 24))), sscale(gqr_pow2(gqr_scale(g >> 8))) {}
+  uint32_t lsize() const { return lt == 0 ? 4 : (lt == 4 || lt == 6) ? 1 : 2; }
+  uint32_t ssize() const { return st == 0 ? 4 : (st == 4 || st == 6) ? 1 : 2; }
+  bool valid() const { return (lt == 0 || lt >= 4) && (st == 0 || st >= 4); }
+  // the loaded value (always a single: the double of a float)
+  float load(const uint8_t *p) const {
+    switch (lt) {
+    case 0: { const uint32_t u = (uint32_t)p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]; float f; std::memcpy(&f, &u, 4); return f; }
+    case 4: return (float)p[0] * lscale;
+    case 5: return (float)(uint16_t)(p[0] << 8 | p[1]) * lscale;
+    case 6: return (float)(int8_t)p[0] * lscale;
+    case 7: return (float)(int16_t)(p[0] << 8 | p[1]) * lscale;
+    default: return 0.0f;
+    }
+  }
+  void store(uint8_t *p, double v) const {
+    switch (st) {
+    case 0: { const uint32_t u = ppc_single_bits_ftz(v); p[0] = u >> 24; p[1] = u >> 16; p[2] = u >> 8; p[3] = u; break; }
+    case 4: p[0] = (uint8_t)ppc_quantize(v, sscale, 0, 255); break;
+    case 5: { const uint16_t q = (uint16_t)ppc_quantize(v, sscale, 0, 65535); p[0] = q >> 8; p[1] = q & 0xFF; break; }
+    case 6: p[0] = (uint8_t)(int8_t)ppc_quantize(v, sscale, -128, 127); break;
+    case 7: { const uint16_t q = (uint16_t)(int16_t)ppc_quantize(v, sscale, -32768, 32767); p[0] = q >> 8; p[1] = q & 0xFF; break; }
+    }
+  }
+};
+NWII_FORCEINLINE float ldf(const uint8_t *p) { const uint32_t u = ld32(p); float f; std::memcpy(&f, &u, 4); return f; }
+NWII_FORCEINLINE bool is_single(double d) { return (double)(float)d == d; }
+// single-precision arithmetic with the "give up" flag (see above)
+struct X1F {
+  bool bad = false;
+  NWII_FORCEINLINE float chk(float r) {
+    const float a = std::fabs(r);
+    bad |= !(a < INFINITY) || (a < 0x1p-125f && a != 0.0f);
+    return r;
+  }
+  NWII_FORCEINLINE float sub(float a, float b) { return chk(a - b); }
+  NWII_FORCEINLINE float subd(double a, float b) { return chk((float)(a - (double)b)); }  // fsubs with a double
+  NWII_FORCEINLINE float add(float a, float b) { return chk(a + b); }
+  NWII_FORCEINLINE float mul(float a, float c) { return chk(a * c); }
+  NWII_FORCEINLINE float madd(float a, float c, float b) { return chk(std::fma(a, c, b)); }
+  NWII_FORCEINLINE float msub(float a, float c, float b) { return chk(std::fma(a, c, -b)); }
+  NWII_FORCEINLINE float nmsub(float a, float c, float b) { return -chk(std::fma(a, c, -b)); }
+  NWII_FORCEINLINE float res(float b) {
+    const double r = ppc_fres((double)b);
+    bad |= !is_single(r);
+    return chk((float)r);
+  }
+};
+// cr0 of an fcmpo / fcmpu (no NaN reaches here)
+struct X1Cr {
+  bool lt = false, gt = false, eq = false, so = false, nan = false;  // nan: a NaN was compared (give up)
+  void fcmp(float a, float b) { lt = a < b; gt = a > b; eq = a == b; so = false; nan |= std::isnan(a) || std::isnan(b); }
+  void fcmpd(double a, double b) { lt = a < b; gt = a > b; eq = a == b; so = false; nan |= std::isnan(a) || std::isnan(b); }
+};
+NWII_FORCEINLINE void fillf(CPUContext &c, int r, float v) { c.fpr[r] = v; c.ps1[r] = v; }
+NWII_FORCEINLINE bool x1_quiet_polls(const CPUContext &c, uint32_t n) {
+  if (n == 0) return true;
+  const int32_t left = c.poll_left.load(std::memory_order_relaxed);
+  return (int64_t)left > (int64_t)n && n1_no_flags(c);
+}
+NWII_FORCEINLINE void x1_take_polls(CPUContext &c, uint32_t n) {
+  if (n) c.poll_left.store(c.poll_left.load(std::memory_order_relaxed) - (int32_t)n, std::memory_order_relaxed);
+}
