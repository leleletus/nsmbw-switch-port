diff --color -ruN ../r22r7/nWiiRuntime/include/runtime/native_n1_fp.h nWiiRuntime/include/runtime/native_n1_fp.h
--- ../r22r7/nWiiRuntime/include/runtime/native_n1_fp.h	1969-12-31 19:00:00.000000000 -0500
+++ nWiiRuntime/include/runtime/native_n1_fp.h	2026-11-10 02:22:43.480398317 -0500
@@ -0,0 +1,142 @@
+// r19n (front N): the floating-point instruction helpers of CPUContext (cpu_context.h, "Gekko/Broadway
+// floating point" and "Paired singles"), as macros over named locals: register N is the pair (fN, pN)
+// = (ctx.fpr[N], ctx.ps1[N]). Each macro is the body of the CPUContext member of the same name, with
+// fpr[X] -> fX and ps1[X] -> pX and nothing else changed (same helper calls, same operand order, same
+// evaluation of all inputs before the destination is written). tools/apply_n1.py rewrites the body of a
+// generated leaf function onto them ("ctx.ps_madds0(12, 10, 1, 12);" -> "N1_ps_madds0(12, 10, 1, 12);"),
+// so the FPRs stay in host registers instead of ctx, and the paired-single helpers are inlined.
+// Keep in sync with cpu_context.h (a change there must be copied here; the comparators would see it).
+#pragma once
+#include "runtime/cpu_context.h"
+
+#define N1_SETPS(D, X0, X1) do { const double n1a_ = (X0), n1b_ = (X1); f##D = n1a_; p##D = n1b_; } while (0)
+#define N1_fill(D, V) do { const double n1v_ = (V); f##D = n1v_; p##D = n1v_; } while (0)
+#define N1_set_bits(D, V) do { const uint64_t n1u_ = (V); std::memcpy(&f##D, &n1u_, 8); } while (0)
+// scalar single: both halves
+#define N1_fadds(D, A, B) N1_fill(D, ppc_single(f##A + f##B))
+#define N1_fsubs(D, A, B) N1_fill(D, ppc_single(f##A - f##B))
+#define N1_fmuls(D, A, C) N1_fill(D, ppc_single(f##A * ppc_force25(f##C)))
+#define N1_fdivs(D, A, B) N1_fill(D, ppc_single(f##A / f##B))
+#define N1_fres(D, B) N1_fill(D, ppc_fres(f##B))
+#define N1_fmadds(D, A, C, B) N1_fill(D, ppc_single(ppc_madd_s(f##A, f##C, f##B)))
+#define N1_fmsubs(D, A, C, B) N1_fill(D, ppc_single(ppc_madd_s(f##A, f##C, -f##B)))
+#define N1_fnmadds(D, A, C, B) N1_fill(D, ppc_neg_keep_nan(ppc_single(ppc_madd_s(f##A, f##C, f##B))))
+#define N1_fnmsubs(D, A, C, B) N1_fill(D, ppc_neg_keep_nan(ppc_single(ppc_madd_s(f##A, f##C, -f##B))))
+#define N1_frsp(D, B) N1_fill(D, ppc_single(f##B))
+// double and moves: ps0 only
+#define N1_fmadd(D, A, C, B) (f##D = std::fma(f##A, f##C, f##B))
+#define N1_fmsub(D, A, C, B) (f##D = std::fma(f##A, f##C, -f##B))
+#define N1_fnmadd(D, A, C, B) (f##D = ppc_neg_keep_nan(std::fma(f##A, f##C, f##B)))
+#define N1_fnmsub(D, A, C, B) (f##D = ppc_neg_keep_nan(std::fma(f##A, f##C, -f##B)))
+#define N1_frsqrte(D, B) (f##D = ppc_frsqrte(f##B))
+#define N1_fctiw(D, B) N1_set_bits(D, ppc_fctiw_image(ppc_fctiw_rn(f##B, ctx.fpscr), f##B))
+#define N1_fctiwz(D, B) N1_set_bits(D, ppc_fctiw_image(ppc_fctiwz(f##B), f##B))
+// paired singles
+#define N1_ps_add(D, A, B) N1_SETPS(D, ppc_single(f##A + f##B), ppc_single(p##A + p##B))
+#define N1_ps_sub(D, A, B) N1_SETPS(D, ppc_single(f##A - f##B), ppc_single(p##A - p##B))
+#define N1_ps_mul(D, A, C) N1_SETPS(D, ppc_single(f##A * ppc_force25(f##C)), ppc_single(p##A * ppc_force25(p##C)))
+#define N1_ps_div(D, A, B) N1_SETPS(D, ppc_single(f##A / f##B), ppc_single(p##A / p##B))
+#define N1_ps_madd(D, A, C, B) \
+  N1_SETPS(D, ppc_single(ppc_madd_s(f##A, f##C, f##B)), ppc_single(ppc_madd_s(p##A, p##C, p##B)))
+#define N1_ps_msub(D, A, C, B) \
+  N1_SETPS(D, ppc_single(ppc_madd_s(f##A, f##C, -f##B)), ppc_single(ppc_madd_s(p##A, p##C, -p##B)))
+#define N1_ps_nmadd(D, A, C, B) \
+  N1_SETPS(D, ppc_neg_keep_nan(ppc_single(ppc_madd_s(f##A, f##C, f##B))), ppc_neg_keep_nan(ppc_single(ppc_madd_s(p##A, p##C, p##B))))
+#define N1_ps_nmsub(D, A, C, B) \
+  N1_SETPS(D, ppc_neg_keep_nan(ppc_single(ppc_madd_s(f##A, f##C, -f##B))), ppc_neg_keep_nan(ppc_single(ppc_madd_s(p##A, p##C, -p##B))))
+#define N1_ps_sum0(D, A, C, B) N1_SETPS(D, ppc_single(f##A + p##B), ppc_single(p##C))
+#define N1_ps_sum1(D, A, C, B) N1_SETPS(D, ppc_single(f##C), ppc_single(f##A + p##B))
+#define N1_ps_muls0(D, A, C) do { const double n1c_ = ppc_force25(f##C); N1_SETPS(D, ppc_single(f##A * n1c_), ppc_single(p##A * n1c_)); } while (0)
+#define N1_ps_muls1(D, A, C) do { const double n1c_ = ppc_force25(p##C); N1_SETPS(D, ppc_single(f##A * n1c_), ppc_single(p##A * n1c_)); } while (0)
+#define N1_ps_madds0(D, A, C, B) do { const double n1c_ = f##C; \
+  N1_SETPS(D, ppc_single(ppc_madd_s(f##A, n1c_, f##B)), ppc_single(ppc_madd_s(p##A, n1c_, p##B))); } while (0)
+#define N1_ps_madds1(D, A, C, B) do { const double n1c_ = p##C; \
+  N1_SETPS(D, ppc_single(ppc_madd_s(f##A, n1c_, f##B)), ppc_single(ppc_madd_s(p##A, n1c_, p##B))); } while (0)
+#define N1_ps_res(D, B) N1_SETPS(D, ppc_fres(f##B), ppc_fres(p##B))
+#define N1_ps_rsqrte(D, B) N1_SETPS(D, ppc_single(ppc_frsqrte(f##B)), ppc_single(ppc_frsqrte(p##B)))
+#define N1_ps_sel(D, A, C, B) N1_SETPS(D, (f##A >= -0.0) ? f##C : f##B, (p##A >= -0.0) ? p##C : p##B)
+#define N1_ps_mr(D, B) do { f##D = f##B; p##D = p##B; } while (0)
+#define N1_ps_neg(D, B) do { f##D = -f##B; p##D = -p##B; } while (0)
+#define N1_ps_abs(D, B) do { f##D = std::abs(f##B); p##D = std::abs(p##B); } while (0)
+#define N1_ps_nabs(D, B) do { f##D = -std::abs(f##B); p##D = -std::abs(p##B); } while (0)
+#define N1_ps_merge00(D, A, B) do { const double n1a_ = f##A, n1b_ = f##B; f##D = n1a_; p##D = n1b_; } while (0)
+#define N1_ps_merge01(D, A, B) do { const double n1a_ = f##A, n1b_ = p##B; f##D = n1a_; p##D = n1b_; } while (0)
+#define N1_ps_merge10(D, A, B) do { const double n1a_ = p##A, n1b_ = f##B; f##D = n1a_; p##D = n1b_; } while (0)
+#define N1_ps_merge11(D, A, B) do { const double n1a_ = p##A, n1b_ = p##B; f##D = n1a_; p##D = n1b_; } while (0)
+
+namespace nwii {
+namespace runtime {
+
+// psq_l / psq_st on a register pair held in locals: psq_l_fast / psq_st_fast (cpu_context.h, the float
+// GQR type through the same MemView accessors) and, for the other GQR types, the body of
+// CPUContext::psq_load / psq_store (same MMU accessors, same conversions) instead of the out-of-line call.
+template <uint32_t ID>
+NWII_FORCEINLINE void n1_psq_l(CPUContext &ctx, MemView &mv, double &fd, double &pd, uint32_t ea, uint32_t W, uint32_t I) {
+  const uint32_t gqr_val = ctx.gqr[I];
+  if (NWII_LIKELY((gqr_val & 0x70000u) == 0)) {
+    const double p0 = mv.read_f32<ID>(ea);
+    const double p1 = W == 0 ? (double)mv.read_f32<ID>(ea + 4) : 1.0;
+    fd = p0;
+    pd = p1;
+    return;
+  }
+  const uint32_t ld_type = (gqr_val >> 16) & 0x7;
+  const float scale = (float)gqr_pow2(-gqr_scale(gqr_val >> 24));
+  MMU &mmu = ctx.mmu;
+  auto load_element = [&](uint32_t a) -> double {
+    switch (ld_type) {
+    case 0: return mmu.read_f32(a);
+    case 4: return (float)mmu.read8(a) * scale;
+    case 5: return (float)mmu.read16(a) * scale;
+    case 6: return (float)(int8_t)mmu.read8(a) * scale;
+    case 7: return (float)(int16_t)mmu.read16(a) * scale;
+    default: return 0.0;
+    }
+  };
+  const uint32_t elem_size = (ld_type == 0) ? 4 : ((ld_type == 4 || ld_type == 6) ? 1 : 2);
+  const double p0 = load_element(ea);
+  const double p1 = (W == 0) ? load_element(ea + elem_size) : 1.0;
+  fd = p0;
+  pd = p1;
+}
+
+NWII_FORCEINLINE void n1_psq_store_q(CPUContext &ctx, double p0, double p1, uint32_t addr, uint32_t W, uint32_t I) {
+  const uint32_t gqr_val = ctx.gqr[I];
+  const uint32_t st_type = gqr_val & 0x7;
+  const double scale = gqr_pow2(gqr_scale(gqr_val >> 8));
+  MMU &mmu = ctx.mmu;
+  auto store_element = [&](uint32_t a, double val) {
+    switch (st_type) {
+    case 0: mmu.write_f32(a, f32_from(ppc_single_bits_ftz(val))); break;
+    case 4: mmu.write8(a, (uint8_t)ppc_quantize(val, scale, 0, 255)); break;
+    case 5: mmu.write16(a, (uint16_t)ppc_quantize(val, scale, 0, 65535)); break;
+    case 6: mmu.write8(a, (uint8_t)(int8_t)ppc_quantize(val, scale, -128, 127)); break;
+    case 7: mmu.write16(a, (uint16_t)(int16_t)ppc_quantize(val, scale, -32768, 32767)); break;
+    }
+  };
+  const uint32_t elem_size = (st_type == 0) ? 4 : ((st_type == 4 || st_type == 6) ? 1 : 2);
+  store_element(addr, p0);
+  if (W == 0) store_element(addr + elem_size, p1);
+}
+
+template <uint32_t ID>
+NWII_FORCEINLINE void n1_psq_st(CPUContext &ctx, MemView &mv, double p0, double p1, uint32_t ea, uint32_t W, uint32_t I) {
+  if (NWII_LIKELY((ctx.gqr[I] & 0x7u) == 0)) {
+    mv.write_f32<ID>(ea, f32_from(ppc_single_bits_ftz(p0)));
+    if (W == 0) mv.write_f32<ID>(ea + 4, f32_from(ppc_single_bits_ftz(p1)));
+    return;
+  }
+  n1_psq_store_q(ctx, p0, p1, ea, W, I);
+}
+
+// psq_st_io / psq_l_io (listed MMIO sites: the gather pipe): CPUContext::psq_store / psq_load
+NWII_FORCEINLINE void n1_psq_st_io(CPUContext &ctx, double p0, double p1, uint32_t ea, uint32_t W, uint32_t I) {
+  n1_psq_store_q(ctx, p0, p1, ea, W, I);
+}
+
+}  // namespace runtime
+}  // namespace nwii
+
+#define N1_PSQ_L(ID, D, EA, W, I) nwii::runtime::n1_psq_l<ID>(ctx, mv_, f##D, p##D, (EA), (W), (I))
+#define N1_PSQ_ST(ID, S, EA, W, I) nwii::runtime::n1_psq_st<ID>(ctx, mv_, f##S, p##S, (EA), (W), (I))
+#define N1_PSQ_ST_IO(S, EA, W, I) nwii::runtime::n1_psq_st_io(ctx, f##S, p##S, (EA), (W), (I))
diff --color -ruN ../r22r7/nWiiRuntime/include/runtime/native_n1.h nWiiRuntime/include/runtime/native_n1.h
--- ../r22r7/nWiiRuntime/include/runtime/native_n1.h	1969-12-31 19:00:00.000000000 -0500
+++ nWiiRuntime/include/runtime/native_n1.h	2026-11-10 02:22:43.480398317 -0500
@@ -0,0 +1,93 @@
+// r19n (front N): exact 1:1 native AArch64/x86 bodies for hot SDK leaf functions of the game thread.
+//
+// tools/apply_n1_hooks.py puts one line at the very top of each listed generated function:
+//     if (ctx.pc == 0xENTRY && nwii::runtime::n1_ENTRY(ctx, &<that function>)) return;  // [n1]
+// n1_ENTRY() returns true when the native body ran: ctx and guest memory are then exactly what the
+// generated code leaves at its blr (every GPR/FPR/PS1/CR/XER/CTR it writes, the volatile ones too,
+// inst_count with the same per-path sum, ctx.pc = ctx.lr, the same bytes stored in the same order, the
+// same interrupt polls). It returns false without touching anything when a precondition does not hold
+// (switch off, memory that is not plain MEM1/MEM2/locked-cache RAM, NWII_WATCH set, a GQR that is not
+// float, a poll that would have to take the slow path...): the generated code then runs as before.
+//
+// Switches (environment / debug.toml):
+//   NWII_NATIVE=0             all native bodies off
+//   NWII_NATIVE_<NAME>=0      one of them off (names: TABLE of tools/apply_n1.py, e.g. NWII_NATIVE_PSMTXCONCAT=0)
+//   NWII_NATIVE_VERIFY=n      the 1st, 2nd, 4th, 8th... and every n-th call of each function: snapshot of the
+//                             registers and of all guest RAM (MEM1/MEM2/LC), native body, its registers and the
+//                             32-byte RAM blocks it changed kept, those blocks put back, generated code, then
+//                             registers and changed blocks compared ("[N1] <name> verify MISMATCH ... first at
+//                             <addresses>"; the generated result is the one kept). Other threads (AX, render) keep
+//                             writing guest RAM meanwhile: a block only one side "changed" far from the function's
+//                             operands is such a writer. Functions that write MMIO / the GX pipe are not verified this
+//                             way (difftest only). PC only: ~88 MB copy + two scans per check.
+//   NWII_NATIVE_STATS=1       counters per function ("[N1] <name> stats" every 2^18 calls, "final" at exit)
+#pragma once
+#include "runtime/cpu_context.h"
+
+namespace nwii {
+namespace runtime {
+
+// One per replaced function (defined in the generated file next to the function, see apply_n1.py).
+struct N1Slot {
+  uint32_t entry;
+  const char *name;                 // NWII_NATIVE_<name>=0 turns it off
+  bool (*nat)(CPUContext &);        // native body: true = ran (ctx/memory = the generated result)
+  void (*gen)(CPUContext &);        // the generated function (for the verify mode)
+  uint32_t flags = 0;               // 1: writes MMIO / the GX gather pipe (cannot be undone: never verified)
+  int32_t mode = 0;                 // 0: not set up yet, 1: native, 2: off, 3: native + counters/verify,
+                                    // 4: off + call counter (NWII_NATIVE_STATS with the function off)
+  uint64_t calls = 0, native = 0, declined = 0, vok = 0, vbad = 0, vskip = 0;
+  N1Slot *next = nullptr;
+};
+bool n1_hook_slow(N1Slot &s, CPUContext &ctx);
+NWII_FORCEINLINE bool n1_hook(N1Slot &s, CPUContext &ctx) {
+  if (NWII_LIKELY(s.mode == 1)) return s.nat(ctx);
+  return n1_hook_slow(s, ctx);
+}
+// Slow interrupt polls taken inside native bodies (the verify mode compares only calls without one).
+extern uint64_t g_n1_slow;
+
+// An interrupt poll of the generated code (poll_due + slow path) whose outcome would only be "nothing":
+// MSR[EE] clear or none of the inline flags set (the slow path is due anyway when poll_left runs out).
+NWII_FORCEINLINE bool n1_no_flags(const CPUContext &c) {
+  return !(c.msr & 0x8000) ||
+         !(c.poll_dec_due | ((hw::pi_intsr.load(std::memory_order_relaxed) & hw::pi_intmr.load(std::memory_order_relaxed)) != 0) |
+           (c.pending_cb_count.load(std::memory_order_relaxed) != 0));
+}
+
+// Interrupt polls of a native loop, one at a time: a poll that the inline part of the generated poll
+// (poll_due) would find quiet (poll_left > 1 and MSR[EE] clear or no flag set) only decrements a local copy
+// of poll_left; the others are done for real (flush(), the state of that poll into ctx, poll_due + slow path).
+// The flags are read again after every real poll (as at most every 16 polls with the wall clock).
+struct N1Poll {
+  CPUContext &c;
+  int32_t start, left;
+  bool quiet;
+  explicit N1Poll(CPUContext &cc) : c(cc), start(cc.poll_left.load(std::memory_order_relaxed)), left(start), quiet(n1_no_flags(cc)) {}
+  NWII_FORCEINLINE bool fast() {
+    if (left > 1 && quiet) { --left; return true; }
+    return false;
+  }
+  // the local count back to ctx, unless another thread kicked poll_left meanwhile (the kick stays). Plain
+  // load + store, no CAS: the same window for a lost kick as the generated poll's load/decrement/store.
+  NWII_FORCEINLINE void flush() {
+    if (left != start) {
+      const int32_t now = c.poll_left.load(std::memory_order_relaxed);
+      if (now == start) c.poll_left.store(left, std::memory_order_relaxed);
+      start = left = (now == start) ? left : now;
+    }
+  }
+  NWII_FORCEINLINE void reload() {
+    start = left = c.poll_left.load(std::memory_order_relaxed);
+    quiet = n1_no_flags(c);
+  }
+};
+
+// Hand-written native bodies (native_n1.cpp).
+bool n1h_801AC440(CPUContext &ctx);  // DCInvalidateRange
+bool n1h_801AC470(CPUContext &ctx);  // DCFlushRange
+bool n1h_80162C30(CPUContext &ctx);  // fLiMgBa_c::searchNodeByID
+// Rounds N2+ (native_n2.cpp, n2h_<addr>): declared by apply_n1.py in the generated file of each function.
+
+}  // namespace runtime
+}  // namespace nwii
diff --color -ruN ../r22r7/nWiiRuntime/src/hle/native_n1.cpp nWiiRuntime/src/hle/native_n1.cpp
--- ../r22r7/nWiiRuntime/src/hle/native_n1.cpp	1969-12-31 19:00:00.000000000 -0500
+++ nWiiRuntime/src/hle/native_n1.cpp	2026-11-10 02:22:43.482398392 -0500
@@ -0,0 +1,487 @@
+// r19n (front N): runtime side of the native SDK leaf bodies (include/runtime/native_n1.h).
+//  - n1_hook_slow(): first call of each slot (reads the switches), the counters and the verify mode.
+//  - hand-written bodies: DCInvalidateRange / DCFlushRange (closed form + batched interrupt polls).
+#include "runtime/native_n1.h"
+
+#include <algorithm>
+#include <bit>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include <unordered_map>
+#include <chrono>
+#ifdef __SWITCH__
+#include <switch.h>
+#endif
+
+namespace nwii {
+namespace runtime {
+
+uint64_t g_n1_slow = 0;
+
+void n1_report_all();  // counters of every slot set up so far (also called by difftest)
+
+namespace {
+
+struct N1Cfg {
+  bool all_on = true;
+  unsigned long verify_every = 0;
+  bool stats = false;
+  bool timing = false;  // NWII_NATIVE_TIME=1: time every call (native, or the generated code when off)
+};
+const N1Cfg &n1_cfg() {
+  static const N1Cfg c = [] {
+    N1Cfg r;
+    const char *e = NWII_ENV("NWII_NATIVE");
+    r.all_on = !(e && e[0] == '0');
+    e = NWII_ENV("NWII_NATIVE_VERIFY");
+    r.verify_every = e ? std::strtoul(e, nullptr, 10) : 0;
+    e = NWII_ENV("NWII_NATIVE_STATS");
+    r.stats = (e && e[0] == '1') || r.verify_every != 0;
+    e = NWII_ENV("NWII_NATIVE_TIME");
+    r.timing = e && e[0] == '1';
+    if (r.timing) r.stats = true;
+    if (r.stats) std::atexit(n1_report_all);
+    std::printf("[N1] native SDK leaf bodies %s%s (r9/r19n)\n", r.all_on ? "on" : "OFF (NWII_NATIVE=0)",
+                r.verify_every ? ", verify mode" : "");
+    std::fflush(stdout);
+    return r;
+  }();
+  return c;
+}
+
+N1Slot *g_slots = nullptr;
+// verify / timing: the next hook of this slot (the generated function about to be called from here) must let
+// the generated code run. One-shot and per slot: the generated code may never come back here (an interrupt
+// delivered inside it can switch guest threads), and a sticky global flag would then disable every hook.
+const N1Slot *g_bypass_slot = nullptr;
+
+// NWII_NATIVE_TIME: time per slot (host ticks; Switch: the 19.2 MHz system counter, PC: steady_clock ns)
+struct N1Time { uint64_t ticks = 0, n = 0; };
+std::unordered_map<const N1Slot *, N1Time> g_ticks;
+NWII_FORCEINLINE uint64_t now_ticks() {
+#ifdef __SWITCH__
+  return armGetSystemTick();
+#else
+  return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+#endif
+}
+NWII_FORCEINLINE double ticks_to_ns(uint64_t t) {
+#ifdef __SWITCH__
+  return (double)t * 1e9 / 19200000.0;
+#else
+  return (double)t;
+#endif
+}
+
+void report(const N1Slot &s, const char *why) {
+  auto it = g_ticks.find(&s);
+  if (it != g_ticks.end()) {
+    const uint64_t n = it->second.n;
+    std::printf("[N1] %s time %s: %llu calls, %.1f ns/call (%s)\n", s.name, why, (unsigned long long)n,
+                n ? ticks_to_ns(it->second.ticks) / (double)n : 0.0, s.mode == 4 ? "generated code" : "native");
+  }
+  std::printf("[N1] %s %s: calls=%llu native=%llu declined=%llu verify ok=%llu bad=%llu skip=%llu\n", s.name, why,
+              (unsigned long long)s.calls, (unsigned long long)s.native, (unsigned long long)s.declined,
+              (unsigned long long)s.vok, (unsigned long long)s.vbad, (unsigned long long)s.vskip);
+  std::fflush(stdout);
+}
+
+// ---- verify mode ----------------------------------------------------------------------------------
+struct N1Regs {
+  uint32_t gpr[32];
+  uint64_t fpr[32], ps1[32];
+  uint8_t cr[8][4];
+  uint32_t pc, lr, ctr, xer, msr, fpscr, srr0, srr1, gqr[8], sprg[4], hid2, dma_u, dma_l, resv;
+  uint64_t inst_count;
+  int32_t poll_left;
+  uint8_t poll_dec_due;
+};
+N1Regs take_regs(const CPUContext &c) {
+  N1Regs r;
+  std::memset(&r, 0, sizeof r);
+  for (int i = 0; i < 32; ++i) {
+    r.gpr[i] = c.gpr[i];
+    std::memcpy(&r.fpr[i], &c.fpr[i], 8);
+    std::memcpy(&r.ps1[i], &c.ps1[i], 8);
+  }
+  for (int i = 0; i < 8; ++i) {
+    r.cr[i][0] = c.cr[i].lt; r.cr[i][1] = c.cr[i].gt; r.cr[i][2] = c.cr[i].eq; r.cr[i][3] = c.cr[i].so;
+    r.gqr[i] = c.gqr[i];
+  }
+  for (int i = 0; i < 4; ++i) r.sprg[i] = c.sprg[i];
+  r.pc = c.pc; r.lr = c.lr; r.ctr = c.ctr; r.xer = c.xer; r.msr = c.msr; r.fpscr = c.fpscr;
+  r.srr0 = c.srr0; r.srr1 = c.srr1; r.hid2 = c.hid2; r.dma_u = c.dma_u; r.dma_l = c.dma_l;
+  r.resv = c.reservation_addr;
+  r.inst_count = c.inst_count;
+  r.poll_left = c.poll_left.load(std::memory_order_relaxed);
+  r.poll_dec_due = c.poll_dec_due;
+  return r;
+}
+void put_regs(CPUContext &c, const N1Regs &r) {
+  for (int i = 0; i < 32; ++i) {
+    c.gpr[i] = r.gpr[i];
+    std::memcpy(&c.fpr[i], &r.fpr[i], 8);
+    std::memcpy(&c.ps1[i], &r.ps1[i], 8);
+  }
+  for (int i = 0; i < 8; ++i) {
+    c.cr[i].lt = r.cr[i][0]; c.cr[i].gt = r.cr[i][1]; c.cr[i].eq = r.cr[i][2]; c.cr[i].so = r.cr[i][3];
+    c.gqr[i] = r.gqr[i];
+  }
+  for (int i = 0; i < 4; ++i) c.sprg[i] = r.sprg[i];
+  c.pc = r.pc; c.lr = r.lr; c.ctr = r.ctr; c.xer = r.xer; c.msr = r.msr; c.fpscr = r.fpscr;
+  c.srr0 = r.srr0; c.srr1 = r.srr1; c.hid2 = r.hid2; c.dma_u = r.dma_u; c.dma_l = r.dma_l;
+  c.reservation_addr = r.resv;
+  c.inst_count = r.inst_count;
+  c.poll_left.store(r.poll_left, std::memory_order_relaxed);
+  c.poll_dec_due = r.poll_dec_due;
+}
+
+[[maybe_unused]] uint64_t hash_block(const MemBlock &m) {
+  const uint8_t *p = m.data();
+  const size_t n = m.size() & ~(size_t)15;
+  uint64_t h = 0xCBF29CE484222325ull, h2 = 0x84222325CBF29CE4ull;
+  for (size_t i = 0; i < n; i += 16) {
+    uint64_t a, b;
+    std::memcpy(&a, p + i, 8);
+    std::memcpy(&b, p + i + 8, 8);
+    h = (h ^ a) * 0x100000001B3ull;
+    h2 = (h2 ^ b) * 0xFF51AFD7ED558CCDull;
+  }
+  return h ^ (h2 * 31);
+}
+
+struct N1Snap {
+  std::vector<uint8_t> m1, m2, lc;
+  void save(MMU &m) {
+    m1.assign(m.mem1.data(), m.mem1.data() + m.mem1.size());
+    m2.assign(m.mem2.data(), m.mem2.data() + m.mem2.size());
+    lc.assign(m.lc.data(), m.lc.data() + m.lc.size());
+  }
+  void restore(MMU &m) const {
+    std::memcpy(m.mem1.data(), m1.data(), m1.size());
+    std::memcpy(m.mem2.data(), m2.data(), m2.size());
+    std::memcpy(m.lc.data(), lc.data(), lc.size());
+  }
+};
+
+void diff_regs(const N1Slot &s, const N1Regs &g, const N1Regs &n) {
+  for (int i = 0; i < 32; ++i)
+    if (g.gpr[i] != n.gpr[i]) std::printf("[N1] %s verify r%d gen=0x%08x native=0x%08x\n", s.name, i, g.gpr[i], n.gpr[i]);
+  for (int i = 0; i < 32; ++i) {
+    if (g.fpr[i] != n.fpr[i])
+      std::printf("[N1] %s verify f%d gen=0x%016llx native=0x%016llx\n", s.name, i, (unsigned long long)g.fpr[i], (unsigned long long)n.fpr[i]);
+    if (g.ps1[i] != n.ps1[i])
+      std::printf("[N1] %s verify ps1_%d gen=0x%016llx native=0x%016llx\n", s.name, i, (unsigned long long)g.ps1[i], (unsigned long long)n.ps1[i]);
+  }
+  if (std::memcmp(g.cr, n.cr, sizeof g.cr)) std::printf("[N1] %s verify CR differs\n", s.name);
+  if (g.pc != n.pc || g.lr != n.lr || g.ctr != n.ctr || g.xer != n.xer || g.inst_count != n.inst_count ||
+      g.poll_left != n.poll_left)
+    std::printf("[N1] %s verify pc/lr/ctr/xer/inst/poll_left gen=%x/%x/%x/%x/%llu/%d native=%x/%x/%x/%x/%llu/%d\n", s.name,
+                g.pc, g.lr, g.ctr, g.xer, (unsigned long long)g.inst_count, g.poll_left, n.pc, n.lr, n.ctr, n.xer,
+                (unsigned long long)n.inst_count, n.poll_left);
+}
+
+// 32-byte blocks of guest RAM that differ from the snapshot: (block index over MEM1|MEM2|LC, contents).
+struct N1Blk { uint32_t idx; uint8_t b[32]; };
+void changed_blocks(MMU &m, const N1Snap &sn, std::vector<N1Blk> &out) {
+  out.clear();
+  uint32_t base = 0;
+  auto scan = [&](const MemBlock &mb, const std::vector<uint8_t> &sv) {
+    const size_t n = mb.size() & ~(size_t)31;
+    for (size_t o = 0; o < n; o += 4096) {
+      const size_t len = std::min<size_t>(4096, n - o);
+      if (std::memcmp(mb.data() + o, sv.data() + o, len) == 0) continue;
+      for (size_t k = o; k < o + len; k += 32)
+        if (std::memcmp(mb.data() + k, sv.data() + k, 32) != 0) {
+          N1Blk x;
+          x.idx = base + (uint32_t)(k / 32);
+          std::memcpy(x.b, mb.data() + k, 32);
+          out.push_back(x);
+        }
+    }
+    base += (uint32_t)((mb.size() + 31) / 32);
+  };
+  scan(m.mem1, sn.m1);
+  scan(m.mem2, sn.m2);
+  scan(m.lc, sn.lc);
+}
+uint8_t *block_ptr(MMU &m, const N1Snap &sn, uint32_t idx, const uint8_t **snapp, uint32_t *ea) {
+  const uint32_t n1 = (uint32_t)((m.mem1.size() + 31) / 32), n2 = (uint32_t)((m.mem2.size() + 31) / 32);
+  if (idx < n1) { *snapp = sn.m1.data() + idx * 32; *ea = 0x80000000u + idx * 32; return m.mem1.data() + idx * 32; }
+  idx -= n1;
+  if (idx < n2) { *snapp = sn.m2.data() + idx * 32; *ea = 0x90000000u + idx * 32; return m.mem2.data() + idx * 32; }
+  idx -= n2;
+  *snapp = sn.lc.data() + idx * 32; *ea = MMU::kLCBase + idx * 32;
+  return m.lc.data() + idx * 32;
+}
+
+// Native body on the current state, then the same state again through the generated code; the
+// generated result is kept. Only calls whose native run took no slow interrupt poll are compared
+// (a slow poll may run scheduler events, which cannot be undone): the others keep the native result.
+// Memory: the 32-byte blocks the native run changed (against a snapshot taken just before) are put back
+// from the snapshot (only those: other threads -- AX, render -- keep writing guest RAM meanwhile), the
+// generated code runs, and then every block that differs from the snapshot is compared: a block written
+// by both must hold the same bytes; a block written by only one side is a mismatch unless it is outside
+// what the function could write (reported with its address, so concurrent writers are recognisable).
+bool verify(N1Slot &s, CPUContext &ctx) {
+  static N1Snap snap;
+  static std::vector<N1Blk> bn, bg;
+  MMU &m = ctx.mmu;
+  const N1Regs r0 = take_regs(ctx);
+  snap.save(m);
+  const uint64_t slow0 = g_n1_slow;
+  if (!s.nat(ctx)) {
+    ++s.declined;
+    return false;  // untouched: the generated code runs
+  }
+  if (g_n1_slow != slow0) {
+    ++s.vskip;
+    return true;
+  }
+  const N1Regs rn = take_regs(ctx);
+  changed_blocks(m, snap, bn);
+  for (const N1Blk &x : bn) {
+    const uint8_t *sp = nullptr;
+    uint32_t ea = 0;
+    uint8_t *dst = block_ptr(m, snap, x.idx, &sp, &ea);  // first: it sets sp
+    std::memcpy(dst, sp, 32);
+  }
+  put_regs(ctx, r0);
+  g_bypass_slot = &s;
+  ctx.pc = s.entry;
+  s.gen(ctx);
+  g_bypass_slot = nullptr;
+  const N1Regs rg = take_regs(ctx);
+  changed_blocks(m, snap, bg);
+  const bool regs_ok = std::memcmp(&rg, &rn, sizeof rg) == 0;
+  // merge the two sorted lists
+  uint32_t bad_blocks = 0, only_n = 0, only_g = 0;
+  uint32_t first_ea[4] = {0, 0, 0, 0};
+  int nfirst = 0;
+  size_t i = 0, j = 0;
+  while (i < bn.size() || j < bg.size()) {
+    uint32_t idx;
+    bool differ;
+    if (j >= bg.size() || (i < bn.size() && bn[i].idx < bg[j].idx)) { idx = bn[i].idx; differ = true; ++only_n; ++i; }
+    else if (i >= bn.size() || bg[j].idx < bn[i].idx) { idx = bg[j].idx; differ = true; ++only_g; ++j; }
+    else { idx = bn[i].idx; differ = std::memcmp(bn[i].b, bg[j].b, 32) != 0; ++i; ++j; }
+    if (differ) {
+      ++bad_blocks;
+      const uint8_t *sp; uint32_t ea;
+      block_ptr(m, snap, idx, &sp, &ea);
+      if (nfirst < 4) first_ea[nfirst++] = ea;
+    }
+  }
+  if (regs_ok && bad_blocks == 0) {
+    ++s.vok;
+  } else {
+    ++s.vbad;
+    if (s.vbad <= 20) {
+      std::printf("[N1] %s verify MISMATCH (call %llu, r1=%08x r3=%08x r4=%08x r5=%08x): regs %s, %u RAM blocks differ "
+                  "(native-only %u, generated-only %u; native wrote %zu, generated %zu) first at %08x %08x %08x %08x\n",
+                  s.name, (unsigned long long)s.calls, r0.gpr[1], r0.gpr[3], r0.gpr[4], r0.gpr[5], regs_ok ? "same" : "DIFFER",
+                  bad_blocks, only_n, only_g, bn.size(), bg.size(), first_ea[0], first_ea[1], first_ea[2], first_ea[3]);
+      diff_regs(s, rg, rn);
+    }
+  }
+  const uint64_t n = s.vok + s.vbad;
+  if (n == 1 || (n & (n - 1)) == 0 || !(regs_ok && bad_blocks == 0)) report(s, "verify");
+  return true;
+}
+
+}  // namespace
+
+void n1_report_all() {
+  uint64_t ok = 0, bad = 0;
+  for (N1Slot *s = g_slots; s; s = s->next) {
+    if (s->mode == 3 || s->mode == 4) report(*s, s->mode == 4 ? "final (off)" : "final");
+    ok += s->vok;
+    bad += s->vbad;
+  }
+  std::printf("[N1] verify total ok=%llu bad=%llu\n", (unsigned long long)ok, (unsigned long long)bad);
+  std::fflush(stdout);
+}
+
+NWII_NOINLINE bool n1_hook_slow(N1Slot &s, CPUContext &ctx) {
+  if (s.mode == 0) {
+    const N1Cfg &c = n1_cfg();
+    char key[96];
+    std::snprintf(key, sizeof key, "NWII_NATIVE_%s", s.name);
+    const char *e = std::getenv(key);
+    const bool on = c.all_on && !(e && e[0] == '0') && !g_trace_calls;
+    s.mode = !on ? (c.stats ? 4 : 2) : (c.stats || c.verify_every) ? 3 : 1;
+    s.next = g_slots;
+    g_slots = &s;
+    std::printf("[N1] %s (0x%08X): %s\n", s.name, s.entry,
+                s.mode == 2 ? "off (generated code)" : s.mode == 4 ? "off (generated code), counted" :
+                s.mode == 3 ? "native, counters/verify" : "native");
+    std::fflush(stdout);
+  }
+  if (s.mode == 1) return s.nat(ctx);
+  if (g_bypass_slot == &s) { g_bypass_slot = nullptr; return false; }
+  if (s.mode == 2) return false;
+  ++s.calls;
+  const N1Cfg &c = n1_cfg();
+  if (s.mode == 4) {
+    if ((s.calls & 0x3FFFF) == 0) report(s, "stats (off)");
+    if (!c.timing) return false;
+    // time the generated code: run it here (its own hook is bypassed) instead of in the caller; same code,
+    // same state, one call level deeper
+    const uint64_t t0 = now_ticks();
+    g_bypass_slot = &s;
+    s.gen(ctx);
+    g_bypass_slot = nullptr;
+    N1Time &t = g_ticks[&s];
+    t.ticks += now_ticks() - t0;
+    ++t.n;
+    return true;
+  }
+  // verify the 1st, 2nd, 4th, 8th... call of each function (rare ones too) and then every n-th
+  if (c.verify_every && !(s.flags & 1) && ((s.calls & (s.calls - 1)) == 0 || s.calls % c.verify_every == 0))
+    return verify(s, ctx);
+  bool r;
+  if (c.timing) {
+    const uint64_t t0 = now_ticks();
+    r = s.nat(ctx);
+    if (r) { N1Time &t = g_ticks[&s]; t.ticks += now_ticks() - t0; ++t.n; }
+  } else {
+    r = s.nat(ctx);
+  }
+  if (r) ++s.native; else ++s.declined;
+  if ((s.calls & 0x3FFFF) == 0) report(s, "stats");
+  return r;
+}
+
+// ---- hand-written bodies -------------------------------------------------------------------------
+namespace {
+// Runs the interrupt polls 1..total of a loop exactly as the generated code would: a poll whose inline
+// part (poll_due) says "nothing to do" only decrements poll_left, so runs of them are done at once; a poll
+// that would take the slow path is done for real, with ctx in the state of that poll (set(j)). Returns
+// true when a poll delivered an interrupt (ctx is then at that poll; the generated code resumes there).
+template <class Set>
+NWII_FORCEINLINE bool n1_polls(CPUContext &c, uint64_t total, Set &&set) {
+  uint64_t j = 0;
+  while (j < total) {
+    const int32_t left = c.poll_left.load(std::memory_order_relaxed);
+    if (left > 1 && n1_no_flags(c)) {
+      const uint64_t k = std::min<uint64_t>(total - j, (uint64_t)(left - 1));
+      c.poll_left.store(left - (int32_t)k, std::memory_order_relaxed);
+      j += k;
+      continue;
+    }
+    ++j;
+    set(j);
+    if (poll_due(c)) {
+      ++g_n1_slow;
+      if (process_pending_callbacks_slow(c)) return true;
+    }
+  }
+  return false;
+}
+
+// DCInvalidateRange / DCFlushRange / (the other DC* have the same shape): r3 = address, r4 = length.
+//   cmplwi r4,0 ; blelr ; rlwinm r5,r3,0,27,31 ; add r4,r4,r5 ; addi r4,r4,31 ; rlwinm r4,r4,27,5,31 ;
+//   mtctr r4 ; loop: dcbX 0,r3 ; addi r3,r3,32 ; bdnz loop (poll at POLL) ; [sc (poll)] ; blr
+// The cache operation is a no-op here (no data cache model), so the whole function is its registers.
+template <uint32_t POLL, uint32_t SC>
+NWII_FORCEINLINE bool n1_dc_range(CPUContext &c) {
+  const uint32_t len = c.gpr[4], r3 = c.gpr[3], r5 = r3 & 0x1F;
+  const uint32_t n = std::rotl(len + r5 + 31u, 27) & 0x7FFFFFFu;
+  // n == 0 with len != 0 would loop 2^32 times (ctr wraps): left to the generated code (nothing touched).
+  if (len != 0 && n == 0) return false;
+  c.inst_count += 2;
+  c.cr[0].lt = false;
+  c.cr[0].gt = len > 0;
+  c.cr[0].eq = len == 0;
+  c.cr[0].so = (c.xer >> 31) & 1;
+  if (len == 0) {
+    c.pc = c.lr;
+    return true;
+  }
+  c.inst_count += 5;
+  c.gpr[5] = r5;
+  c.gpr[4] = n;
+  const uint64_t ic0 = c.inst_count;
+  // poll j (1..n): r3 = r3 + 32 j, inst_count = ic0 + 3 j, ctr = n - j + 1 (decremented after the poll)
+  const bool irq = n1_polls(c, n, [&](uint64_t j) {
+    c.gpr[3] = r3 + 32u * (uint32_t)j;
+    c.inst_count = ic0 + 3 * j;
+    c.ctr = n - (uint32_t)j + 1;
+    c.pc = POLL;
+  });
+  if (irq) return true;
+  c.gpr[3] = r3 + 32u * n;
+  c.ctr = 0;
+  c.inst_count = ic0 + 3ull * n;
+  if (SC) {  // sc: one more poll at SC, then blr
+    c.inst_count += 1;
+    c.pc = SC;
+    if (poll_due(c)) {
+      ++g_n1_slow;
+      if (process_pending_callbacks_slow(c)) return true;
+    }
+  }
+  c.inst_count += 1;
+  c.pc = c.lr;
+  return true;
+}
+}  // namespace
+
+// fLiMgBa_c::searchNodeByID (f_line.cpp, 80162C30): r3 = list, r4 = id; walks node = list->first,
+// node = node->next until node->obj->id == id (returns node) or node == 0 (returns 0).
+//   lwz r3,0(r3) ; b test ; loop: lwz r5,8(r3) ; lwz r0,0(r5) ; cmpw r0,r4 ; beqlr ; lwz r3,4(r3) ;
+//   test: cmpwi r3,0 ; bne loop (poll 0x80162C50) ; li r3,0 ; blr
+// Guest memory through the same MemView accessors as the generated code.
+bool n1h_80162C30(CPUContext &c) {
+  MemView mv(c.mmu);
+  uint32_t r0 = c.gpr[0], r3 = c.gpr[3], r4 = c.gpr[4], r5 = c.gpr[5], xer = c.xer;
+  bool lt = c.cr[0].lt, gt = c.cr[0].gt, eq = c.cr[0].eq, so = c.cr[0].so;
+  uint64_t ic = c.inst_count;
+  N1Poll P(c);
+  ic += 2;
+  r3 = mv.read32<0>(r3 + 0);
+  for (;;) {
+    ic += 2;
+    lt = (int32_t)r3 < 0; gt = (int32_t)r3 > 0; eq = r3 == 0; so = (xer >> 31) & 1;
+    if (!P.fast()) {
+      P.flush();
+      c.pc = 0x80162C50u;
+      if (poll_due(c)) {
+        c.cr[0].eq = eq; c.cr[0].gt = gt; c.cr[0].lt = lt; c.cr[0].so = so;
+        c.gpr[0] = r0; c.gpr[3] = r3; c.gpr[5] = r5; c.inst_count = ic;
+        ++g_n1_slow;
+        if (process_pending_callbacks_slow(c)) return true;
+        eq = c.cr[0].eq; gt = c.cr[0].gt; lt = c.cr[0].lt; so = c.cr[0].so;
+        r0 = c.gpr[0]; r3 = c.gpr[3]; r4 = c.gpr[4]; r5 = c.gpr[5]; ic = c.inst_count; xer = c.xer;
+      }
+      P.reload();
+    }
+    if (eq) break;
+    ic += 4;
+    r5 = mv.read32<0>(r3 + 8);
+    r0 = mv.read32<0>(r5 + 0);
+    lt = (int32_t)r0 < (int32_t)r4; gt = (int32_t)r0 > (int32_t)r4; eq = r0 == r4; so = (xer >> 31) & 1;
+    if (eq) {
+      P.flush();
+      c.cr[0].eq = eq; c.cr[0].gt = gt; c.cr[0].lt = lt; c.cr[0].so = so;
+      c.gpr[0] = r0; c.gpr[3] = r3; c.gpr[5] = r5; c.inst_count = ic; c.pc = c.lr;
+      return true;
+    }
+    ic += 1;
+    r3 = mv.read32<0>(r3 + 4);
+  }
+  P.flush();
+  ic += 2;
+  r3 = 0;
+  c.cr[0].eq = eq; c.cr[0].gt = gt; c.cr[0].lt = lt; c.cr[0].so = so;
+  c.gpr[0] = r0; c.gpr[3] = r3; c.gpr[5] = r5; c.inst_count = ic; c.pc = c.lr;
