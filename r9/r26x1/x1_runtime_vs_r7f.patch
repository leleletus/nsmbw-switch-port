+  if (zero) {
+    // +0 / -0: 8620 (+13: exponent test not taken) ; 8654 (+6: cr1 = cmpwi r6,0 ; r3 = (r6 & 0x7fffffff) | r0 = 0 ;
+    // beq 8860) ; 8860 (+2): x itself, after the poll of the "b" at the entry
