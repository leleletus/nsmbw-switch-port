+  if (nan) return false;
+  X1F F;
+  // f8 = (M0*V0, M1*V1) ; f9 = (M2*V2 + f8.0, M3*1 + f8.1) ; f10 = (f9.0 + f9.1, single(p10))
+  float r8a = F.mul(M[0], V[0]), r8b = F.mul(M[1], V[1]);
+  float r9a = F.madd(M[2], V[2], r8a), r9b = F.madd(M[3], 1.0f, r8b);
+  const float t0 = F.add(r9a, r9b);
+  r8a = F.mul(M[4], V[0]); r8b = F.mul(M[5], V[1]);
+  r9a = F.madd(M[6], V[2], r8a); r9b = F.madd(M[7], 1.0f, r8b);
+  const float t1 = F.add(r9a, r9b);
+  r8a = F.mul(M[8], V[0]); r8b = F.mul(M[9], V[1]);
+  r9a = F.madd(M[10], V[2], r8a); r9b = F.madd(M[11], 1.0f, r8b);
+  const float t2 = F.add(r9a, r9b);
+  if (F.bad) return false;
+  const double p10 = ppc_single(c.ps1[10]);
+  // stores in program order: 8, 24, 12, 40, 28, 0, 16, 32, 44
+  stf(pd + 8, M[2]); stf(pd + 12, M[3]);
+  stf(pd + 24, M[6]); stf(pd + 28, M[7]);
+  stf(pd + 12, t0);
+  stf(pd + 40, M[10]); stf(pd + 44, M[11]);
+  stf(pd + 28, t1);
+  stf(pd + 0, M[0]); stf(pd + 4, M[1]);
+  stf(pd + 16, M[4]); stf(pd + 20, M[5]);
+  stf(pd + 32, M[8]); stf(pd + 36, M[9]);
+  stf(pd + 44, t2);
+  setps(c, 0, V[0], V[1]);
+  setps(c, 1, V[2], 1.0f);
+  setps(c, 2, M[0], M[1]);
+  setps(c, 3, M[2], M[3]);
+  setps(c, 4, M[4], M[5]);
+  setps(c, 5, M[6], M[7]);
+  setps(c, 6, M[8], M[9]);
+  setps(c, 7, M[10], M[11]);
+  setps(c, 8, r8a, r8b);
+  setps(c, 9, r9a, r9b);
+  c.fpr[10] = t2; c.ps1[10] = p10;
+  c.inst_count += 27;
+  c.pc = c.lr;
+  return true;
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// PSMTXConcatArray (801C0610): D[i] = A x B[i] for i < r6 (r3 = A, r4 = B, r5 = D), software-pipelined: the
+// prologue starts element 0, loop iteration k (ctr = r6 - 1 of them, poll 0x801C0744 at each bdnz) finishes element
+// k and starts k+1, the epilogue finishes the last one; f28-f31 saved with stfd + psq_st and restored with
+// psq_l + lfd (ps1 comes back as the single, FTZ, of what it was). Per element, the same chains of single FMAs
+// (ps_muls0 / ps_madds1 / ps_madds0 / ps_madd with K = {0, 1} at r13-24800) in host single precision (exact,
+// see the curve functions above). All values are computed and checked first; then the stores go in program
+// order between the polls, and a slow poll sees exactly the state the generated code has there.
+// inst_count: +42 (prologue), +36 per iteration, +20 (epilogue). r6 < 2 (ctr 0 would loop 2^32 times), NaN in A,
+// B or K, single subnormal results, D partly overlapping B, or the frame overlapping any operand: generated code.
+bool x1h_801C0610(CPUContext &c) {
+  MMU &m = c.mmu;
+  if (g_watch_addr || !x1_gqr0_float(c)) return false;
+  const uint32_t n = c.gpr[6];
+  if (n < 2 || n > 4096) return false;
+  const uint32_t r1 = c.gpr[1], ra = c.gpr[3], rb = c.gpr[4], rd = c.gpr[5], rk = c.gpr[13] - 24800;
+  uint8_t *stk = x1_ram(m, r1 - 80, 80), *pd = x1_ram(m, rd, 48 * n);
+  const uint8_t *pa = x1_ram(m, ra, 48), *pb = x1_ram(m, rb, 48 * n), *pk = x1_ram(m, rk, 8);
+  if (!stk || !pd || !pa || !pb || !pk) return false;
+  if (!x1_disjoint(stk, 80, pa, 48) || !x1_disjoint(stk, 80, pb, 48 * n) || !x1_disjoint(stk, 80, pd, 48 * n) ||
+      !x1_disjoint(stk, 80, pk, 8) || !x1_disjoint(pd, 48 * n, pk, 8))
+    return false;
+  if (pd != pb && !x1_disjoint(pd, 48 * n, pb, 48 * n)) return false;
+  float A[12];
+  for (int i = 0; i < 12; ++i) { A[i] = ldf(pa + 4 * i); if (std::isnan(A[i])) return false; }
+  const float K0 = ldf(pk), K1 = ldf(pk + 4);
+  if (std::isnan(K0) || std::isnan(K1)) return false;
+  // pass 1: every element (outputs in out[12 n]) and the checks; nothing written
+  static thread_local std::vector<float> out, bin;  // outputs; the B elements as loaded (D may be B)
+  out.resize(12 * (size_t)n);
+  bin.resize(12 * (size_t)n);
+  X1F F;
+  for (uint32_t e = 0; e < n; ++e) {
+    float B[12];
+    for (int i = 0; i < 12; ++i) { B[i] = bin[12 * (size_t)e + i] = ldf(pb + 48 * e + 4 * i); if (std::isnan(B[i])) return false; }
+    float *o = &out[12 * (size_t)e];
+    for (int r = 0; r < 3; ++r) {
+      const float a0 = A[4 * r], a1 = A[4 * r + 1], a2 = A[4 * r + 2], a3 = A[4 * r + 3];
+      float x0 = F.mul(B[0], a0), x1 = F.mul(B[1], a0);
+      x0 = F.madd(B[4], a1, x0); x1 = F.madd(B[5], a1, x1);
+      x0 = F.madd(B[8], a2, x0); x1 = F.madd(B[9], a2, x1);
+      float y0 = F.mul(B[2], a0), y1 = F.mul(B[3], a0);
+      y0 = F.madd(B[6], a1, y0); y1 = F.madd(B[7], a1, y1);
+      y0 = F.madd(B[10], a2, y0); y1 = F.madd(B[11], a2, y1);
+      y0 = F.madd(K0, a2, y0); y1 = F.madd(K1, a3, y1);
+      o[4 * r] = x0; o[4 * r + 1] = x1; o[4 * r + 2] = y0; o[4 * r + 3] = y1;
+    }
+  }
+  if (F.bad) return false;
+  // pass 2: prologue stack frame (stwu ; stfd/psq_st f31, f30, f29, f28)
+  const double s31 = c.fpr[31], s30 = c.fpr[30], s29 = c.fpr[29], s28 = c.fpr[28];
+  const double q31 = c.ps1[31], q30 = c.ps1[30], q29 = c.ps1[29], q28 = c.ps1[28];
+  st32(stk + 0, r1);
+  st64(stk + 64, b64d(s31)); st32(stk + 72, ppc_single_bits_ftz(s31)); st32(stk + 76, ppc_single_bits_ftz(q31));
+  st64(stk + 48, b64d(s30)); st32(stk + 56, ppc_single_bits_ftz(s30)); st32(stk + 60, ppc_single_bits_ftz(q30));
+  st64(stk + 32, b64d(s29)); st32(stk + 40, ppc_single_bits_ftz(s29)); st32(stk + 44, ppc_single_bits_ftz(q29));
+  st64(stk + 16, b64d(s28)); st32(stk + 24, ppc_single_bits_ftz(s28)); st32(stk + 28, ppc_single_bits_ftz(q28));
+  auto put = [&](uint32_t e, int off) {  // the pair of D[e] at byte offset off (0, 8, ... 40)
+    const float *o = &out[12 * (size_t)e];
+    stf(pd + 48 * e + off, o[off / 4]); stf(pd + 48 * e + off + 4, o[off / 4 + 1]);
+  };
+  put(0, 0); put(0, 16);
+  const uint64_t ic0 = c.inst_count;
+  X1Poll P(c);
+  for (int i = 0; i < 6; ++i) setps(c, i, A[2 * i], A[2 * i + 1]);
+  for (uint32_t k = 0; k + 1 < n; ++k) {
+    put(k, 32); put(k, 8); put(k, 24); put(k, 40); put(k + 1, 0); put(k + 1, 16);
+    if (P.fast()) continue;
+    // the state at the poll of iteration k: element k+1 started (B rows in f6-f10, row pairs 0/1 of columns 0-1
+    // done in f11/f13, row 2 of columns 0-1 in f30, columns 2-3 after ps_madds1 in f12/f31/f29), f28 = K
+    const float *B = &bin[12 * (size_t)(k + 1)];
+    const float *o = &out[12 * (size_t)(k + 1)];
+    auto part = [&](int r, float &y0, float &y1) {
+      y0 = std::fma(B[6], A[4 * r + 1], B[2] * A[4 * r]); y1 = std::fma(B[7], A[4 * r + 1], B[3] * A[4 * r]);
+    };
+    setps(c, 6, B[6], B[7]); setps(c, 7, B[2], B[3]); setps(c, 8, B[4], B[5]); setps(c, 9, B[8], B[9]);
+    setps(c, 10, B[10], B[11]);
+    setps(c, 11, o[0], o[1]); setps(c, 13, o[4], o[5]); setps(c, 30, o[8], o[9]);
+    float y0, y1;
+    part(0, y0, y1); setps(c, 12, y0, y1);
+    part(1, y0, y1); setps(c, 31, y0, y1);
+    part(2, y0, y1); setps(c, 29, y0, y1);
+    setps(c, 28, K0, K1);
+    c.gpr[0] = n - 1; c.gpr[1] = r1 - 80; c.gpr[4] = rb + 48 * (k + 1); c.gpr[5] = rd + 48 * (k + 1); c.gpr[6] = rk;
+    c.ctr = n - 1 - k;
+    c.inst_count = ic0 + 42 + 36ull * (k + 1);
+    if (P.slow(0x801C0744u)) return true;
+  }
+  P.flush();
+  put(n - 1, 32); put(n - 1, 8); put(n - 1, 24); put(n - 1, 40);
+  const uint32_t l = n - 1;
+  const float *B = &bin[12 * (size_t)l];
+  const float *o = &out[12 * (size_t)l];
+  setps(c, 6, B[6], B[7]); setps(c, 7, B[2], B[3]); setps(c, 8, B[4], B[5]); setps(c, 9, B[8], B[9]);
+  setps(c, 10, B[10], B[11]);
+  setps(c, 11, o[0], o[1]); setps(c, 12, o[2], o[3]); setps(c, 13, o[4], o[5]);
+  auto restored = [](double s, double q, double &f, double &p) { f = s; p = (double)f32_from(ppc_single_bits_ftz(q)); };
+  restored(s31, q31, c.fpr[31], c.ps1[31]);
+  restored(s30, q30, c.fpr[30], c.ps1[30]);
+  restored(s29, q29, c.fpr[29], c.ps1[29]);
+  restored(s28, q28, c.fpr[28], c.ps1[28]);
+  c.gpr[0] = n - 1; c.gpr[1] = r1; c.gpr[4] = rb + 48 * l; c.gpr[5] = rd + 48 * l; c.gpr[6] = rk;
+  c.ctr = 0;
+  c.inst_count = ic0 + 42 + 36ull * (n - 1) + 20;
+  c.pc = c.lr;
+  return true;
+}
