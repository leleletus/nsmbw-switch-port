+  const uint8_t *k = n2_ram(m, c.gpr[2] - 20304, 8);
+  uint8_t *d = n2_ram(m, c.gpr[3], 48);
+  if (!k || !d || !n2_disjoint(k, 8, d, 48)) return false;
+  const uint32_t u1 = ld32(k), u0 = ld32(k + 4);  // f1 = [r2-20304], f0 = [r2-20300]
+  if (odd_bits(u0) || odd_bits(u1)) return false;
+  st32(d + 8, u0); st32(d + 12, u0);
+  st32(d + 24, u0); st32(d + 28, u0);
+  st32(d + 32, u0); st32(d + 36, u0);
+  st32(d + 16, u0); st32(d + 20, u1);
+  st32(d + 0, u1); st32(d + 4, u0);
+  st32(d + 40, u1); st32(d + 44, u0);
+  const float c0 = f32b(u0), c1 = f32b(u1);
+  setps(c, 0, c0, c0);
+  setps(c, 1, c0, c1);
+  setps(c, 2, c1, c0);
+  c.inst_count += 11;
+  c.pc = c.lr;
+  return true;
+}
