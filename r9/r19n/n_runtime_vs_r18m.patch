+// r19n round N2: hand-written native bodies that do the work in single precision on host pointers
+// instead of emulating every paired-single instruction in double through ctx.
+//
+// Why it is exact (same bits as the generated code, cpu_context.h semantics):
+//  * every operand of these functions is a single: loaded by psq_l (float GQR type: float -> double is exact)
+//    or the result of a single-precision op (ppc_single). For singles, ppc_force25(c) == c (the low 29 mantissa
+//    bits are already 0), the product a*c is exact in double, so ppc_single(a * force25(c)) == a * c in float;
+//  * ppc_single(ppc_madd_s(a, c, b)) is Dolphin's "round once" fused multiply-add: the double FMA plus the
+//    exact-tie correction gives round-to-single of the exact a*c+b for every result in the normal single
+//    range; a single-precision std::fma (one rounding) gives the same. They can differ only when the result
+//    is a single subnormal (double rounding at the subnormal position), so every computed value with
+//    0 < |r| < 2^-125 makes the body give up before writing anything (the generated code runs);
+//  * psq_st of a float stores the single's bits (ConvertToSingleFTZ: only subnormals change, and those are
+//    excluded above); NaN inputs are left to the generated code wherever a value is stored or copied without
+//    arithmetic (the double path quiets signalling NaNs); results of arithmetic on NaNs are the same NaN in both
+//    (which operand's NaN when two are NaN depends on operand order, as everywhere: "NANSIGN", r9 convention);
+//  * memory: host pointers only when every range is plain RAM (MEM1 0x10..24 MiB, MEM2, locked cache), no
+//    NWII_WATCH, and the stack frame does not overlap the matrices (so the access order cannot matter).
+//  * registers: every FPR (ps0 and ps1), GPR, inst_count the generated code leaves, including the ps1 halves
+//    of the callee-saved FPRs it restores with lfd (lfd writes ps0 only), and the stack bytes it writes.
+#include "runtime/native_n1.h"
+#include "runtime/native_n1_fp.h"
