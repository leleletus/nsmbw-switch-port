+// PSMTXCopy (801C0500): six psq_l fN,8N(r3) / psq_st fN,8N(r4) pairs, f0-f5.
+bool n2h_801C0500(CPUContext &c) {
+  MMU &m = c.mmu;
+  if (g_watch_addr || !gqr0_float(c)) return false;
+  const uint8_t *s = n2_ram(m, c.gpr[3], 48);
+  uint8_t *d = n2_ram(m, c.gpr[4], 48);
+  if (!s || !d) return false;
