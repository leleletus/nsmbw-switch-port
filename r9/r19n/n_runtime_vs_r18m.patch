+// psq_st of a float pair to the gather pipe (CPUContext::psq_store, float type: MMU::write_f32 ->
+// write_f32_slow -> GX_WGPIPE_WriteF32 of the ConvertToSingleFTZ value): subnormals go as a signed zero.
+NWII_FORCEINLINE uint32_t ftz_bits(uint32_t u) { return (u & 0x7F800000u) ? u : (u & 0x80000000u); }
+NWII_FORCEINLINE void pipe_f32(uint32_t u) { GX_WGPIPE_WriteF32(f32b(ftz_bits(u))); }
+NWII_FORCEINLINE bool any_nan(const uint32_t *w, int n) {
+  for (int i = 0; i < n; ++i)
+    if ((w[i] & 0x7F800000u) == 0x7F800000u && (w[i] & 0x007FFFFFu)) return true;
+  return false;
+}
