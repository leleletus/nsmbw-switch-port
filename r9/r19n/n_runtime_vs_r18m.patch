+// ---- round N4 -------------------------------------------------------------------------------------------
+namespace {
+// psq_l / psq_st of ONE element (W=1) with a GQR, on a host pointer: the body of CPUContext::psq_load /
+// psq_store (cpu_context.h) for that element; the GQR is decoded once per call.
+struct N2Gq {
+  uint32_t lt, st;      // load / store type
+  float lscale;         // dequantize scale (float, as psq_load)
+  double sscale;        // quantize scale (double, as psq_store)
+  explicit N2Gq(uint32_t g)
+      : lt((g >> 16) & 7), st(g & 7), lscale((float)gqr_pow2(-gqr_scale(g >> 24))), sscale(gqr_pow2(gqr_scale(g >> 8))) {}
+  uint32_t lsize() const { return lt == 0 ? 4 : (lt == 4 || lt == 6) ? 1 : 2; }
+  double load(const uint8_t *p) const {
+    switch (lt) {
+    case 0: return (double)f32b(ld32(p));
+    case 4: return (float)p[0] * lscale;
+    case 5: return (float)(uint16_t)(p[0] << 8 | p[1]) * lscale;
+    case 6: return (float)(int8_t)p[0] * lscale;
+    case 7: return (float)(int16_t)(p[0] << 8 | p[1]) * lscale;
+    default: return 0.0;
+    }
+  }
+  void store(uint8_t *p, double v) const {
+    switch (st) {
+    case 0: st32(p, ppc_single_bits_ftz(v)); break;
+    case 4: p[0] = (uint8_t)ppc_quantize(v, sscale, 0, 255); break;
+    case 5: { const uint16_t q = (uint16_t)ppc_quantize(v, sscale, 0, 65535); p[0] = q >> 8; p[1] = q & 0xFF; break; }
+    case 6: p[0] = (uint8_t)(int8_t)ppc_quantize(v, sscale, -128, 127); break;
+    case 7: { const uint16_t q = (uint16_t)(int16_t)ppc_quantize(v, sscale, -32768, 32767); p[0] = q >> 8; p[1] = q & 0xFF; break; }
+    }
+  }
+};
+NWII_FORCEINLINE void w16(uint8_t *p, uint32_t v) { p[0] = (uint8_t)(v >> 8); p[1] = (uint8_t)v; }
+NWII_FORCEINLINE uint32_t r16(const uint8_t *p) { return (uint32_t)p[0] << 8 | p[1]; }
+}  // namespace
