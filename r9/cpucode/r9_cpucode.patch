-    return m.read64_slow(addr);
-  }
+#define NWII_MV_LOAD(T, N, SWAP, SLOW)                                               \
+  const uint32_t paddr = addr & 0x3FFFFFFF;                                          \
+  T v;                                                                               \
+  if (NWII_LIKELY(paddr - 0x10u < lim1)) {                                           \
+    std::memcpy(&v, b1 + paddr, N);                                                  \
+    return SWAP(v);                                                                  \
+  }                                                                                  \
+  if ((paddr >> 26) == 4) { /* paddr - 0x10000000 < kMem2Size */                    \
+    std::memcpy(&v, b2 + (paddr & (MMU::kMem2Size - 1)), N);                         \
+    return SWAP(v);                                                                  \
+  }                                                                                  \
+  return m.SLOW(addr);
+#define NWII_MV_STORE(T, N, SWAPPED, SLOW)                                           \
+  const uint32_t paddr = addr & 0x3FFFFFFF;                                          \
+  const T v = SWAPPED;                                                               \
+  if (NWII_LIKELY(paddr - 0x10u < wlim1)) {                                          \
+    std::memcpy(b1 + paddr, &v, N);                                                  \
+    return;                                                                          \
+  }                                                                                  \
+  if (!watch && (paddr >> 26) == 4) {                                               \
+    std::memcpy(b2 + (paddr & (MMU::kMem2Size - 1)), &v, N);                         \
+    return;                                                                          \
+  }                                                                                  \
+  m.SLOW(addr, value);
+#define NWII_MV_ID(x) (x)
+  NWII_FORCEINLINE uint8_t read8(uint32_t addr) { NWII_MV_LOAD(uint8_t, 1, NWII_MV_ID, read8_slow) }
+  NWII_FORCEINLINE uint16_t read16(uint32_t addr) { NWII_MV_LOAD(uint16_t, 2, __builtin_bswap16, read16_slow) }
+  NWII_FORCEINLINE uint32_t read32(uint32_t addr) { NWII_MV_LOAD(uint32_t, 4, __builtin_bswap32, read32_slow) }
+  NWII_FORCEINLINE uint64_t read64(uint32_t addr) { NWII_MV_LOAD(uint64_t, 8, __builtin_bswap64, read64_slow) }
   NWII_FORCEINLINE float read_f32(uint32_t addr) { uint32_t val = read32(addr); float f; std::memcpy(&f, &val, 4); return f; }
   NWII_FORCEINLINE double read_f64(uint32_t addr) {
-    if (uint8_t *p = fast_ptr(addr)) {
-      uint64_t v; std::memcpy(&v, p, 8); v = __builtin_bswap64(v);
-      double f; std::memcpy(&f, &v, 8); return f;
+    const uint32_t paddr = addr & 0x3FFFFFFF;
+    uint64_t v;
+    double f;
+    if (NWII_LIKELY(paddr - 0x10u < lim1)) {
+      std::memcpy(&v, b1 + paddr, 8);
+      v = __builtin_bswap64(v);
+      std::memcpy(&f, &v, 8);
+      return f;
+    }
+    if ((paddr >> 26) == 4) {
+      std::memcpy(&v, b2 + (paddr & (MMU::kMem2Size - 1)), 8);
+      v = __builtin_bswap64(v);
+      std::memcpy(&f, &v, 8);
+      return f;
     }
     return m.read_f64_slow(addr);
   }
-  NWII_FORCEINLINE void write8(uint32_t addr, uint8_t value) {
-    if (NWII_LIKELY(!watch)) if (uint8_t *p = fast_ptr(addr)) { *p = value; return; }
-    m.write8_slow(addr, value);
-  }
-  NWII_FORCEINLINE void write16(uint32_t addr, uint16_t value) {
-    if (NWII_LIKELY(!watch)) if (uint8_t *p = fast_ptr(addr)) {
-      const uint16_t v = __builtin_bswap16(value); std::memcpy(p, &v, 2); return;
-    }
-    m.write16_slow(addr, value);
-  }
-  NWII_FORCEINLINE void write32(uint32_t addr, uint32_t value) {
-    if (NWII_LIKELY(!watch)) if (uint8_t *p = fast_ptr(addr)) {
-      const uint32_t v = __builtin_bswap32(value); std::memcpy(p, &v, 4); return;
-    }
-    m.write32_slow(addr, value);
-  }
-  NWII_FORCEINLINE void write64(uint32_t addr, uint64_t value) {
-    if (NWII_LIKELY(!watch)) if (uint8_t *p = fast_ptr(addr)) {
-      const uint64_t v = __builtin_bswap64(value); std::memcpy(p, &v, 8); return;
-    }
-    m.write64_slow(addr, value);
-  }
+  NWII_FORCEINLINE void write8(uint32_t addr, uint8_t value) { NWII_MV_STORE(uint8_t, 1, value, write8_slow) }
+  NWII_FORCEINLINE void write16(uint32_t addr, uint16_t value) { NWII_MV_STORE(uint16_t, 2, __builtin_bswap16(value), write16_slow) }
+  NWII_FORCEINLINE void write32(uint32_t addr, uint32_t value) { NWII_MV_STORE(uint32_t, 4, __builtin_bswap32(value), write32_slow) }
+  NWII_FORCEINLINE void write64(uint32_t addr, uint64_t value) { NWII_MV_STORE(uint64_t, 8, __builtin_bswap64(value), write64_slow) }
   NWII_FORCEINLINE void write_f32(uint32_t addr, float value) {
-    if (NWII_LIKELY(!watch)) if (uint8_t *p = fast_ptr(addr)) {
-      uint32_t v; std::memcpy(&v, &value, 4); v = __builtin_bswap32(v); std::memcpy(p, &v, 4); return;
-    }
-    m.write_f32_slow(addr, value);
+    uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    NWII_MV_STORE(uint32_t, 4, __builtin_bswap32(bits), write_f32_slow)
   }
   NWII_FORCEINLINE void write_f64(uint32_t addr, double value) {
-    if (NWII_LIKELY(!watch)) if (uint8_t *p = fast_ptr(addr)) {
-      uint64_t v; std::memcpy(&v, &value, 8); v = __builtin_bswap64(v); std::memcpy(p, &v, 8); return;
-    }
-    m.write_f64_slow(addr, value);
+    uint64_t bits;
+    std::memcpy(&bits, &value, 8);
+    NWII_MV_STORE(uint64_t, 8, __builtin_bswap64(bits), write_f64_slow)
   }
+#undef NWII_MV_LOAD
+#undef NWII_MV_STORE
+#undef NWII_MV_ID
 };
 
+
 // Guest calls, including indirect calls and tail calls, run as native calls,
 // so the host stack grows with the guest's call chain. Generated code checks
 // this before a call that could recurse without bound and falls back to
 // returning to run_game (which unwinds the host stack) when it is low.
-extern thread_local uintptr_t g_native_stack_limit;
+// R9 cpucode: constinit (it has a constant initializer), so the generated code
+// reads it directly instead of first testing the weak TLS init hook through the GOT.
+extern constinit thread_local uintptr_t g_native_stack_limit;
 inline bool native_stack_ok() {
   char probe;
   return (uintptr_t)&probe > g_native_stack_limit;
@@ -1146,7 +1184,7 @@
