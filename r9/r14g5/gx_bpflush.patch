+// [r14g5] Which completed BP commands hand the buffer over. NSMBW writes ~190 k BP commands/s
+// (TEV/blend/scissor setup...), so handing over at every one cost a g_fifo_mutex round trip each
+// (wg_flush_now ~1.3 % and lock waits ~4 % of the game thread on the Switch). Only the BPs whose
+// effect the guest can wait for need to reach the host at once: PE draw done (0x45), draw-sync
+// tokens (0x47/0x48) and EFB/XFB copies (0x52, the frame end that FifoWaitForHost counts).
+// Every other BP waits in the 512-byte buffer for the next hand-over (buffer full, a sync BP, or
+// the guest idling: idle_wait), like any vertex data; order and content are unchanged.
+// Opt-in for now (A/B): NWII_WG_BPFLUSH=sync selects it; unset or "all" keeps the hand-over
+// after every BP. NWII_LATE_SYNC=1 (PE signalled by the host parser) always keeps "all".
+static bool wg_bp_all() {
+    static const bool all = [] {
+        const char *e = NWII_ENV("NWII_WG_BPFLUSH");
+        const bool sync = e && e[0] == 's' && NWII_ENV("NWII_LATE_SYNC") == nullptr;
+        if (sync) std::printf("[WGP] hand-over only at sync BPs (0x45/0x47/0x48/0x52), NWII_WG_BPFLUSH=sync\n");
+        return !sync;
+    }();
+    return all;
+}
+static inline bool wg_bp_sync(uint32_t n) {
+    if (n < 4) return true;  // the 0x61 went out in an earlier hand-over: keep the old rule
+    const uint8_t reg = s_wg[n - 4];
+    return reg == 0x45 || reg == 0x47 || reg == 0x48 || reg == 0x52 || wg_bp_all();
+}
+
 // Appends one byte (room for it must exist) and applies the BP rule.
 static inline void wg_byte(uint8_t b) {
     s_wg[s_wg_n++] = b;
