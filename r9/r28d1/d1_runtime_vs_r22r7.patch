+  s.cmpwi(r5);
+  s.mv.write32<0>(s.r1 + 20u, s.r0);  // stw r0,20(r1)
+  s.mv.write32<0>(s.r1 + 12u, s.r31); // stw r31,12(r1)
+  s.r31 = s.r4;
+  if (s.eq) {
+    s.ic += 2;
+    s.r3 = s.mv.read32<0>(s.r3 + 0);
+  } else {
+    s.r3 = r5;
+    if (s.gtn(0x801630B4u)) return true;
+    s.ic += 1;
+  }
+  bool found = false;
+  for (;;) {
+    s.ic += 2;
+    s.cmpwi(s.r3);
+    if (s.poll(0x801630DCu)) return true;
+    if (s.eq) break;
+    s.ic += 5;
+    s.r4 = s.mv.read32<0>(s.r3 + 16);
+    s.r0 = s.mv.read16<0>(s.r4 + 8);
+    s.lt = s.r0 < s.r31; s.gt = s.r0 > s.r31; s.eq = s.r0 == s.r31; s.so = (s.xer >> 31) & 1;  // cmplw r0,r31
+    if (s.eq) { found = true; break; }
+    s.ic += 1;
+    if (s.gtn(0x801630D8u)) return true;
+  }
+  if (!found) {
+    s.ic += 1;
+    s.r3 = 0;
+  }
+  s.P.flush();
+  s.ic += 5;
+  s.r0 = s.mv.read32<0>(s.r1 + 20u);
+  s.r31 = s.mv.read32<0>(s.r1 + 12u);
+  s.lr = s.r0;
+  s.r1 += 16u;
+  s.spill();
+  c.pc = s.lr;
+  return true;
+}
+
+}  // namespace runtime
+}  // namespace nwii
