diff --color -ruN r22r7/nWiiRuntime/include/runtime/native_d1.h r28d1/nWiiRuntime/include/runtime/native_d1.h
--- r22r7/nWiiRuntime/include/runtime/native_d1.h	1969-12-31 19:00:00.000000000 -0500
+++ r28d1/nWiiRuntime/include/runtime/native_d1.h	2026-11-10 02:25:15.424928913 -0500
@@ -0,0 +1,53 @@
+// r28d1 (front D, pilot D1): native fManager_c / fLiMgBa_c search functions with an exact ID -> node index.
+//
+// fManager_c::m_searchManage[8] (USA 0x80377A70, 8 cLineMg_c {first, last}) holds every fBase_c's mSearchNode,
+// in list (id & 7). fLiMgBa_c::searchNodeByID (0x80162C30) walks one list from first to the first node whose
+// owner's mUniqueID equals the id. The index keeps, per list, the list as it is in guest memory (node, owner,
+// id from top to bottom) and a hash id -> position of the first node with that id, so a lookup returns the
+// same node, at the same position k, without walking. Everything the generated walk leaves (r0, r3, r5, CR0,
+// inst_count = +8+7k / +6+7n, k+1 / n+1 interrupt polls) is computed from (k, n, last node).
+//
+// Coherence: the generated code of cLineMg_c::addTopLineNode / addLastLineNode / insertLineNode /
+// removeLineNode (labels loc_80161020 / 80160FE0 / 80160F10 / 80160F60 in output_21.cpp: the functions and
+// their merged copies) calls d1_touch(this, node) first. A touched search list is rebuilt from guest memory at
+// its next lookup (lazy; those bodies have no interrupt poll, so no lookup can run in the middle of one).
+// A node of a search list used with another list also marks its list. Guards on every lookup: list->first
+// must be the indexed first node, and on a hit node->owner / owner->id must still be the indexed ones;
+// otherwise the list is rebuilt (counted as "guard").
+//
+// Switches: NWII_NATIVE_SEARCHNODEBYID=0 / NWII_NATIVE_SEARCHBASEBYID=0 (generated code), NWII_D1_INDEX=0
+// (native linear walk, no index), NWII_D1_CHECK=1 (every indexed lookup also walks the list and compares
+// node, k, n, last node; "[D1] CHECK MISMATCH"), NWII_D1_STATS=1 (counters every 2^20 lookups and at exit).
+#pragma once
+#include <cstdint>
+
+namespace nwii {
+namespace runtime {
+
+extern uint32_t g_d1_dirty;      // bit i: search list i touched since its index was built
+extern uint32_t g_d1_nodes_live; // != 0 once any list was indexed (node check of other lists' operations)
+void d1_touch_other(uint32_t node);
+
+static constexpr uint32_t kD1SearchManage = 0x80377A70u;
+
+// list operation on cLineMg_c `list` with `node` (generated code, see above)
+inline __attribute__((always_inline)) void d1_touch(uint32_t list, uint32_t node) {
+  const uint32_t o = list - kD1SearchManage;
+  if (o < 64u) {
+    g_d1_dirty |= 1u << (o >> 3);
+    return;
+  }
+  if (g_d1_nodes_live) d1_touch_other(node);
+}
+// insertLineNode(node, prev): prev's links change too
+inline __attribute__((always_inline)) void d1_touch(uint32_t list, uint32_t node, uint32_t prev) {
+  const uint32_t o = list - kD1SearchManage;
+  if (o < 64u) {
+    g_d1_dirty |= 1u << (o >> 3);
+    return;
+  }
+  if (g_d1_nodes_live) { d1_touch_other(node); d1_touch_other(prev); }
+}
+
+}  // namespace runtime
+}  // namespace nwii
diff --color -ruN r22r7/nWiiRuntime/include/runtime/native_n1.h r28d1/nWiiRuntime/include/runtime/native_n1.h
--- r22r7/nWiiRuntime/include/runtime/native_n1.h	1969-12-31 19:00:00.000000000 -0500
+++ r28d1/nWiiRuntime/include/runtime/native_n1.h	2026-11-10 02:23:52.669943140 -0500
@@ -0,0 +1,93 @@
+// r19n (front N): exact 1:1 native AArch64/x86 bodies for hot SDK leaf functions of the game thread.
+//
+// tools/apply_n1_hooks.py puts one line at the very top of each listed generated function:
+//     if (ctx.pc == 0xENTRY && nwii::runtime::n1_ENTRY(ctx, &<that function>)) return;  // [n1]
+// n1_ENTRY() returns true when the native body ran: ctx and guest memory are then exactly what the
+// generated code leaves at its blr (every GPR/FPR/PS1/CR/XER/CTR it writes, the volatile ones too,
+// inst_count with the same per-path sum, ctx.pc = ctx.lr, the same bytes stored in the same order, the
+// same interrupt polls). It returns false without touching anything when a precondition does not hold
+// (switch off, memory that is not plain MEM1/MEM2/locked-cache RAM, NWII_WATCH set, a GQR that is not
+// float, a poll that would have to take the slow path...): the generated code then runs as before.
+//
+// Switches (environment / debug.toml):
+//   NWII_NATIVE=0             all native bodies off
+//   NWII_NATIVE_<NAME>=0      one of them off (names: TABLE of tools/apply_n1.py, e.g. NWII_NATIVE_PSMTXCONCAT=0)
+//   NWII_NATIVE_VERIFY=n      the 1st, 2nd, 4th, 8th... and every n-th call of each function: snapshot of the
+//                             registers and of all guest RAM (MEM1/MEM2/LC), native body, its registers and the
+//                             32-byte RAM blocks it changed kept, those blocks put back, generated code, then
+//                             registers and changed blocks compared ("[N1] <name> verify MISMATCH ... first at
+//                             <addresses>"; the generated result is the one kept). Other threads (AX, render) keep
+//                             writing guest RAM meanwhile: a block only one side "changed" far from the function's
+//                             operands is such a writer. Functions that write MMIO / the GX pipe are not verified this
+//                             way (difftest only). PC only: ~88 MB copy + two scans per check.
+//   NWII_NATIVE_STATS=1       counters per function ("[N1] <name> stats" every 2^18 calls, "final" at exit)
+#pragma once
+#include "runtime/cpu_context.h"
+
+namespace nwii {
+namespace runtime {
+
+// One per replaced function (defined in the generated file next to the function, see apply_n1.py).
+struct N1Slot {
+  uint32_t entry;
+  const char *name;                 // NWII_NATIVE_<name>=0 turns it off
+  bool (*nat)(CPUContext &);        // native body: true = ran (ctx/memory = the generated result)
+  void (*gen)(CPUContext &);        // the generated function (for the verify mode)
+  uint32_t flags = 0;               // 1: writes MMIO / the GX gather pipe (cannot be undone: never verified)
+  int32_t mode = 0;                 // 0: not set up yet, 1: native, 2: off, 3: native + counters/verify,
+                                    // 4: off + call counter (NWII_NATIVE_STATS with the function off)
+  uint64_t calls = 0, native = 0, declined = 0, vok = 0, vbad = 0, vskip = 0;
+  N1Slot *next = nullptr;
+};
+bool n1_hook_slow(N1Slot &s, CPUContext &ctx);
+NWII_FORCEINLINE bool n1_hook(N1Slot &s, CPUContext &ctx) {
+  if (NWII_LIKELY(s.mode == 1)) return s.nat(ctx);
+  return n1_hook_slow(s, ctx);
+}
+// Slow interrupt polls taken inside native bodies (the verify mode compares only calls without one).
+extern uint64_t g_n1_slow;
+
+// An interrupt poll of the generated code (poll_due + slow path) whose outcome would only be "nothing":
+// MSR[EE] clear or none of the inline flags set (the slow path is due anyway when poll_left runs out).
+NWII_FORCEINLINE bool n1_no_flags(const CPUContext &c) {
+  return !(c.msr & 0x8000) ||
+         !(c.poll_dec_due | ((hw::pi_intsr.load(std::memory_order_relaxed) & hw::pi_intmr.load(std::memory_order_relaxed)) != 0) |
+           (c.pending_cb_count.load(std::memory_order_relaxed) != 0));
+}
+
+// Interrupt polls of a native loop, one at a time: a poll that the inline part of the generated poll
+// (poll_due) would find quiet (poll_left > 1 and MSR[EE] clear or no flag set) only decrements a local copy
+// of poll_left; the others are done for real (flush(), the state of that poll into ctx, poll_due + slow path).
+// The flags are read again after every real poll (as at most every 16 polls with the wall clock).
+struct N1Poll {
+  CPUContext &c;
+  int32_t start, left;
+  bool quiet;
+  explicit N1Poll(CPUContext &cc) : c(cc), start(cc.poll_left.load(std::memory_order_relaxed)), left(start), quiet(n1_no_flags(cc)) {}
+  NWII_FORCEINLINE bool fast() {
+    if (left > 1 && quiet) { --left; return true; }
+    return false;
+  }
+  // the local count back to ctx, unless another thread kicked poll_left meanwhile (the kick stays). Plain
+  // load + store, no CAS: the same window for a lost kick as the generated poll's load/decrement/store.
+  NWII_FORCEINLINE void flush() {
+    if (left != start) {
+      const int32_t now = c.poll_left.load(std::memory_order_relaxed);
+      if (now == start) c.poll_left.store(left, std::memory_order_relaxed);
+      start = left = (now == start) ? left : now;
+    }
+  }
+  NWII_FORCEINLINE void reload() {
+    start = left = c.poll_left.load(std::memory_order_relaxed);
+    quiet = n1_no_flags(c);
+  }
+};
+
+// Hand-written native bodies (native_n1.cpp).
+bool n1h_801AC440(CPUContext &ctx);  // DCInvalidateRange
+bool n1h_801AC470(CPUContext &ctx);  // DCFlushRange
+bool n1h_80162C30(CPUContext &ctx);  // fLiMgBa_c::searchNodeByID
+// Rounds N2+ (native_n2.cpp, n2h_<addr>): declared by apply_n1.py in the generated file of each function.
+
+}  // namespace runtime
+}  // namespace nwii
diff --color -ruN r22r7/nWiiRuntime/src/hle/native_d1.cpp r28d1/nWiiRuntime/src/hle/native_d1.cpp
--- r22r7/nWiiRuntime/src/hle/native_d1.cpp	1969-12-31 19:00:00.000000000 -0500
+++ r28d1/nWiiRuntime/src/hle/native_d1.cpp	2026-11-10 03:38:09.221280923 -0500
@@ -0,0 +1,706 @@
+// r28d1 (front D, pilot D1): native fLiMgBa_c::searchNodeByID (0x80162C30) with an exact ID -> node index, and
+// native fManager_c::searchBaseByID (0x80162D00). See include/runtime/native_d1.h.
+#include "runtime/native_d1.h"
+#include "runtime/native_n1.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace nwii {
+namespace runtime {
+
+uint32_t g_d1_dirty = 0xFFu;
+uint32_t g_d1_nodes_live = 0;
+
+namespace {
+
+struct D1Cfg {
+  bool index = true;  // NWII_D1_INDEX=0: native linear walk
+  bool check = false; // NWII_D1_CHECK=1
+  bool stats = false; // NWII_D1_STATS=1
+};
+struct D1Stats {
+  uint64_t look = 0, hit = 0, miss = 0, ksum = 0, nsum = 0, rebuild = 0, guard = 0, bad_list = 0, linear = 0,
+           poll_fallback = 0, other_list = 0, check_ok = 0, check_bad = 0, touch_other = 0, base_calls = 0,
+           base_declined = 0;
+  uint64_t per_list[8] = {};
+};
+D1Stats g_st;
+uint64_t g_slow_polls = 0, g_slow_diverged = 0;
+void d1_report(const char *why) {
+  const D1Stats &s = g_st;
+  std::printf("[D1] %s: lookups=%llu hit=%llu miss=%llu avg_k=%.2f avg_n(miss)=%.2f rebuild=%llu guard=%llu "
+              "unindexable=%llu linear=%llu poll_fallback=%llu other_list=%llu touch_other=%llu check ok=%llu bad=%llu "
+              "| searchBaseByID native=%llu declined=%llu | per list:",
+              why, (unsigned long long)s.look, (unsigned long long)s.hit, (unsigned long long)s.miss,
+              s.hit ? (double)s.ksum / (double)s.hit : 0.0, s.miss ? (double)s.nsum / (double)s.miss : 0.0,
+              (unsigned long long)s.rebuild, (unsigned long long)s.guard, (unsigned long long)s.bad_list,
+              (unsigned long long)s.linear, (unsigned long long)s.poll_fallback, (unsigned long long)s.other_list,
+              (unsigned long long)s.touch_other, (unsigned long long)s.check_ok, (unsigned long long)s.check_bad,
+              (unsigned long long)s.base_calls, (unsigned long long)s.base_declined);
+  for (int i = 0; i < 8; ++i) std::printf(" %llu", (unsigned long long)s.per_list[i]);
+  std::printf(" | slow polls in indexed walks=%llu diverged=%llu", (unsigned long long)g_slow_polls, (unsigned long long)g_slow_diverged);
+  std::printf("\n");
+  std::fflush(stdout);
+}
+void d1_report_exit() { d1_report("final"); }
+
+const D1Cfg &d1_cfg() {
+  static const D1Cfg c = [] {
+    D1Cfg r;
+    const char *e = std::getenv("NWII_D1_INDEX");
+    r.index = !(e && e[0] == '0');
+    e = std::getenv("NWII_D1_CHECK");
+    r.check = e && e[0] == '1';
+    e = std::getenv("NWII_D1_STATS");
+    r.stats = (e && e[0] == '1') || r.check;
+    if (r.stats) std::atexit(d1_report_exit);
+    std::printf("[D1] searchNodeByID: %s%s%s (r9/r28d1)\n", r.index ? "ID index" : "native linear walk (NWII_D1_INDEX=0)",
+                r.check ? ", cross-check every lookup" : "", r.stats ? ", stats" : "");
+    std::fflush(stdout);
+    return r;
+  }();
+  return c;
+}
+
+// ---- the index -------------------------------------------------------------------------------------
+struct D1Ent { uint32_t node, owner, id; };
+struct D1List {
+  std::vector<D1Ent> e;      // the list from first to last, as in guest memory at the last rebuild
+  std::vector<int32_t> h;    // id -> position of the first node with that id (-1: empty)
+  uint32_t mask = 0;
+  uint32_t first = 0;        // list->first at the last rebuild
+  bool ok = false;           // false: not indexable (pointer outside plain RAM, cycle): native linear walk
+};
+D1List g_l[8];
+// every indexed node -> its list (+1), for operations of other lists that use a search node
+std::vector<uint64_t> g_ns;  // (node << 8) | (list + 1), 0 = empty
+uint32_t g_ns_mask = 0;
+bool g_ns_dirty = true;
+
+NWII_FORCEINLINE uint32_t d1_hash(uint32_t x) {
+  x *= 0x9E3779B1u;
+  return x ^ (x >> 15);
+}
+// host pointer of a 4-byte aligned plain RAM word, or nullptr
+NWII_FORCEINLINE const uint8_t *d1_ptr(MMU &m, uint32_t a) {
+  if (a & 3u) return nullptr;
+  return m.fast_ptr(a);
+}
+NWII_FORCEINLINE uint32_t d1_rd(const uint8_t *p) {
+  uint32_t v;
+  std::memcpy(&v, p, 4);
+  return __builtin_bswap32(v);
+}
+
+void d1_rebuild_nodeset() {
+  size_t n = 0;
+  for (const D1List &L : g_l) n += L.e.size();
+  uint32_t cap = 64;
+  while (cap < 2 * n + 16) cap <<= 1;
+  g_ns.assign(cap, 0);
+  g_ns_mask = cap - 1;
+  for (int li = 0; li < 8; ++li)
+    for (const D1Ent &x : g_l[li].e) {
+      uint32_t i = d1_hash(x.node) & g_ns_mask;
+      while (g_ns[i] != 0 && (uint32_t)(g_ns[i] >> 8) != x.node) i = (i + 1) & g_ns_mask;
+      g_ns[i] = ((uint64_t)x.node << 8) | (uint64_t)(li + 1);
+    }
+  g_ns_dirty = false;
+}
+
+NWII_NOINLINE void d1_rebuild(MMU &m, int li) {
+  D1List &L = g_l[li];
+  ++g_st.rebuild;
+  L.e.clear();
+  L.ok = false;
+  g_d1_dirty &= ~(1u << li);
+  g_ns_dirty = true;
+  g_d1_nodes_live = 1;
+  const uint8_t *lp = d1_ptr(m, kD1SearchManage + 8u * (uint32_t)li);
+  if (!lp) { ++g_st.bad_list; return; }
+  uint32_t node = d1_rd(lp);
+  L.first = node;
+  while (node != 0) {
+    const uint8_t *np = d1_ptr(m, node);
+    if (!np || L.e.size() >= (1u << 16)) { L.e.clear(); ++g_st.bad_list; return; }
+    const uint32_t owner = d1_rd(np + 8);
+    const uint8_t *op = d1_ptr(m, owner);
+    if (!op) { L.e.clear(); ++g_st.bad_list; return; }
+    L.e.push_back({node, owner, d1_rd(op)});
+    node = d1_rd(np + 4);
+  }
+  uint32_t cap = 16;
+  while (cap < 2 * L.e.size()) cap <<= 1;
+  L.h.assign(cap, -1);
+  L.mask = cap - 1;
+  for (int32_t k = 0; k < (int32_t)L.e.size(); ++k) {
+    const uint32_t id = L.e[k].id;
+    uint32_t i = d1_hash(id) & L.mask;
+    for (;;) {
+      const int32_t s = L.h[i];
+      if (s < 0) { L.h[i] = k; break; }
+      if (L.e[s].id == id) break;  // an earlier (closer to first) node has this id: the walk stops there
+      i = (i + 1) & L.mask;
+    }
+  }
+  L.ok = true;
+}
+
+// What the generated walk would find: found at position k (node, owner), or not found after n nodes (the
+// last one's owner/id are what r5/r0 keep).
+struct D1Res {
+  bool found;
+  uint32_t k, n, node, owner, last_owner, last_id;
+};
+
+// The plain walk (cross-check mode and searchBaseByID without the index). false: a pointer outside plain RAM
+// or more than 2^20 nodes (the generated code then runs).
+bool d1_walk(MMU &m, uint32_t list, uint32_t id, D1Res &r) {
+  r = {};
+  const uint8_t *lp = d1_ptr(m, list);
+  if (!lp) return false;
+  uint32_t node = d1_rd(lp);
+  uint32_t k = 0;
+  while (node != 0) {
+    const uint8_t *np = d1_ptr(m, node);
+    if (!np || k >= (1u << 20)) return false;
+    const uint32_t owner = d1_rd(np + 8);
+    const uint8_t *op = d1_ptr(m, owner);
+    if (!op) return false;
+    const uint32_t oid = d1_rd(op);
+    r.last_owner = owner;
+    r.last_id = oid;
+    if (oid == id) {
+      r.found = true;
+      r.k = k;
+      r.node = node;
+      r.owner = owner;
+      return true;
+    }
+    node = d1_rd(np + 4);
+    ++k;
+  }
+  r.found = false;
+  r.n = k;
+  return true;
+}
+
+// Index lookup. false: list not indexable.
+NWII_FORCEINLINE bool d1_find(MMU &m, int li, uint32_t id, D1Res &r) {
+  D1List &L = g_l[li];
+  const uint8_t *lp = m.mem1.data() + ((kD1SearchManage & 0x3FFFFFFFu) + 8u * (uint32_t)li);
+  for (int attempt = 0;; ++attempt) {
+    if (NWII_UNLIKELY((g_d1_dirty >> li) & 1u)) d1_rebuild(m, li);
+    if (NWII_UNLIKELY(!L.ok)) return false;
+    if (NWII_UNLIKELY(d1_rd(lp) != L.first)) {  // the list changed without a hooked operation
+      ++g_st.guard;
+      g_d1_dirty |= 1u << li;
+      if (attempt) return false;
+      continue;
+    }
+    const uint32_t n = (uint32_t)L.e.size();
+    uint32_t i = d1_hash(id) & L.mask;
+    int32_t s;
+    while ((s = L.h[i]) >= 0 && L.e[s].id != id) i = (i + 1) & L.mask;
+    if (s >= 0) {
+      const D1Ent &x = L.e[s];
+      const uint8_t *np = d1_ptr(m, x.node);
+      const uint8_t *op = np ? d1_ptr(m, d1_rd(np + 8)) : nullptr;
+      if (NWII_UNLIKELY(!op || d1_rd(np + 8) != x.owner || d1_rd(op) != id)) {
+        ++g_st.guard;
+        g_d1_dirty |= 1u << li;
+        if (attempt) return false;
+        continue;
+      }
+      r.found = true;
+      r.k = (uint32_t)s;
+      r.node = x.node;
+      r.owner = x.owner;
+      r.last_owner = x.owner;
+      r.last_id = id;
+      r.n = 0;
+    } else {
+      r.found = false;
+      r.k = 0;
+      r.n = n;
+      r.node = r.owner = 0;
+      r.last_owner = n ? L.e[n - 1].owner : 0;
+      r.last_id = n ? L.e[n - 1].id : 0;
+    }
+    return true;
+  }
+}
+
+NWII_NOINLINE void d1_check(MMU &m, uint32_t list, uint32_t id, const D1Res &x) {
+  D1Res w;
+  if (!d1_walk(m, list, id, w)) { ++g_st.check_bad; return; }
+  bool same = w.found == x.found;
+  if (same && w.found) same = w.k == x.k && w.node == x.node && w.owner == x.owner;
+  if (same && !w.found) same = w.n == x.n && (w.n == 0 || (w.last_owner == x.last_owner && w.last_id == x.last_id));
+  if (same) { ++g_st.check_ok; return; }
+  ++g_st.check_bad;
+  if (g_st.check_bad <= 30)
+    std::printf("[D1] CHECK MISMATCH list %08x id %08x: walk found=%d k=%u n=%u node=%08x owner=%08x last=%08x/%08x | "
+                "index found=%d k=%u n=%u node=%08x owner=%08x last=%08x/%08x\n", list, id, w.found, w.k, w.n, w.node,
+                w.owner, w.last_owner, w.last_id, x.found, x.k, x.n, x.node, x.owner, x.last_owner, x.last_id);
+}
+
+}  // namespace
+
+void d1_touch_other(uint32_t node) {
+  if (g_ns_dirty) d1_rebuild_nodeset();
+  uint32_t i = d1_hash(node) & g_ns_mask;
+  for (;;) {
+    const uint64_t v = g_ns[i];
+    if (v == 0) return;
+    if ((uint32_t)(v >> 8) == node) {
+      ++g_st.touch_other;
+      g_d1_dirty |= 1u << ((uint32_t)(v & 0xFF) - 1);
+      return;
+    }
+    i = (i + 1) & g_ns_mask;
+  }
+}
+
