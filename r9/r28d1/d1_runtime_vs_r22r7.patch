+// r19n (front N): runtime side of the native SDK leaf bodies (include/runtime/native_n1.h).
+//  - n1_hook_slow(): first call of each slot (reads the switches), the counters and the verify mode.
+//  - hand-written bodies: DCInvalidateRange / DCFlushRange (closed form + batched interrupt polls).
+#include "runtime/native_n1.h"
+
+#include <algorithm>
+#include <bit>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
