+namespace {
+
+struct N1Cfg {
+  bool all_on = true;
+  unsigned long verify_every = 0;
+  bool stats = false;
+  bool timing = false;  // NWII_NATIVE_TIME=1: time every call (native, or the generated code when off)
+};
+const N1Cfg &n1_cfg() {
+  static const N1Cfg c = [] {
+    N1Cfg r;
+    const char *e = NWII_ENV("NWII_NATIVE");
+    r.all_on = !(e && e[0] == '0');
+    e = NWII_ENV("NWII_NATIVE_VERIFY");
+    r.verify_every = e ? std::strtoul(e, nullptr, 10) : 0;
+    e = NWII_ENV("NWII_NATIVE_STATS");
+    r.stats = (e && e[0] == '1') || r.verify_every != 0;
+    e = NWII_ENV("NWII_NATIVE_TIME");
+    r.timing = e && e[0] == '1';
+    if (r.timing) r.stats = true;
+    if (r.stats) std::atexit(n1_report_all);
+    std::printf("[N1] native SDK leaf bodies %s%s (r9/r19n)\n", r.all_on ? "on" : "OFF (NWII_NATIVE=0)",
+                r.verify_every ? ", verify mode" : "");
+    std::fflush(stdout);
+    return r;
+  }();
+  return c;
+}
+
+N1Slot *g_slots = nullptr;
+// verify / timing: the next hook of this slot (the generated function about to be called from here) must let
+// the generated code run. One-shot and per slot: the generated code may never come back here (an interrupt
+// delivered inside it can switch guest threads), and a sticky global flag would then disable every hook.
+const N1Slot *g_bypass_slot = nullptr;
+
+// NWII_NATIVE_TIME: time per slot (host ticks; Switch: the 19.2 MHz system counter, PC: steady_clock ns)
+struct N1Time { uint64_t ticks = 0, n = 0; };
+std::unordered_map<const N1Slot *, N1Time> g_ticks;
+NWII_FORCEINLINE uint64_t now_ticks() {
+#ifdef __SWITCH__
+  return armGetSystemTick();
+#else
+  return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+#endif
+}
+NWII_FORCEINLINE double ticks_to_ns(uint64_t t) {
+#ifdef __SWITCH__
+  return (double)t * 1e9 / 19200000.0;
+#else
+  return (double)t;
+#endif
+}
+
+void report(const N1Slot &s, const char *why) {
+  auto it = g_ticks.find(&s);
+  if (it != g_ticks.end()) {
+    const uint64_t n = it->second.n;
+    std::printf("[N1] %s time %s: %llu calls, %.1f ns/call (%s)\n", s.name, why, (unsigned long long)n,
+                n ? ticks_to_ns(it->second.ticks) / (double)n : 0.0, s.mode == 4 ? "generated code" : "native");
+  }
+  std::printf("[N1] %s %s: calls=%llu native=%llu declined=%llu verify ok=%llu bad=%llu skip=%llu\n", s.name, why,
+              (unsigned long long)s.calls, (unsigned long long)s.native, (unsigned long long)s.declined,
+              (unsigned long long)s.vok, (unsigned long long)s.vbad, (unsigned long long)s.vskip);
+  std::fflush(stdout);
+}
+
+// ---- verify mode ----------------------------------------------------------------------------------
+struct N1Regs {
+  uint32_t gpr[32];
+  uint64_t fpr[32], ps1[32];
+  uint8_t cr[8][4];
+  uint32_t pc, lr, ctr, xer, msr, fpscr, srr0, srr1, gqr[8], sprg[4], hid2, dma_u, dma_l, resv;
+  uint64_t inst_count;
+  int32_t poll_left;
+  uint8_t poll_dec_due;
+};
+N1Regs take_regs(const CPUContext &c) {
+  N1Regs r;
+  std::memset(&r, 0, sizeof r);
+  for (int i = 0; i < 32; ++i) {
+    r.gpr[i] = c.gpr[i];
+    std::memcpy(&r.fpr[i], &c.fpr[i], 8);
+    std::memcpy(&r.ps1[i], &c.ps1[i], 8);
+  }
+  for (int i = 0; i < 8; ++i) {
+    r.cr[i][0] = c.cr[i].lt; r.cr[i][1] = c.cr[i].gt; r.cr[i][2] = c.cr[i].eq; r.cr[i][3] = c.cr[i].so;
+    r.gqr[i] = c.gqr[i];
+  }
+  for (int i = 0; i < 4; ++i) r.sprg[i] = c.sprg[i];
+  r.pc = c.pc; r.lr = c.lr; r.ctr = c.ctr; r.xer = c.xer; r.msr = c.msr; r.fpscr = c.fpscr;
+  r.srr0 = c.srr0; r.srr1 = c.srr1; r.hid2 = c.hid2; r.dma_u = c.dma_u; r.dma_l = c.dma_l;
+  r.resv = c.reservation_addr;
+  r.inst_count = c.inst_count;
+  r.poll_left = c.poll_left.load(std::memory_order_relaxed);
+  r.poll_dec_due = c.poll_dec_due;
+  return r;
+}
+void put_regs(CPUContext &c, const N1Regs &r) {
+  for (int i = 0; i < 32; ++i) {
+    c.gpr[i] = r.gpr[i];
+    std::memcpy(&c.fpr[i], &r.fpr[i], 8);
+    std::memcpy(&c.ps1[i], &r.ps1[i], 8);
+  }
+  for (int i = 0; i < 8; ++i) {
+    c.cr[i].lt = r.cr[i][0]; c.cr[i].gt = r.cr[i][1]; c.cr[i].eq = r.cr[i][2]; c.cr[i].so = r.cr[i][3];
+    c.gqr[i] = r.gqr[i];
+  }
+  for (int i = 0; i < 4; ++i) c.sprg[i] = r.sprg[i];
+  c.pc = r.pc; c.lr = r.lr; c.ctr = r.ctr; c.xer = r.xer; c.msr = r.msr; c.fpscr = r.fpscr;
+  c.srr0 = r.srr0; c.srr1 = r.srr1; c.hid2 = r.hid2; c.dma_u = r.dma_u; c.dma_l = r.dma_l;
+  c.reservation_addr = r.resv;
+  c.inst_count = r.inst_count;
+  c.poll_left.store(r.poll_left, std::memory_order_relaxed);
+  c.poll_dec_due = r.poll_dec_due;
+}
+
+[[maybe_unused]] uint64_t hash_block(const MemBlock &m) {
+  const uint8_t *p = m.data();
+  const size_t n = m.size() & ~(size_t)15;
+  uint64_t h = 0xCBF29CE484222325ull, h2 = 0x84222325CBF29CE4ull;
+  for (size_t i = 0; i < n; i += 16) {
+    uint64_t a, b;
+    std::memcpy(&a, p + i, 8);
+    std::memcpy(&b, p + i + 8, 8);
+    h = (h ^ a) * 0x100000001B3ull;
+    h2 = (h2 ^ b) * 0xFF51AFD7ED558CCDull;
+  }
+  return h ^ (h2 * 31);
+}
+
+struct N1Snap {
+  std::vector<uint8_t> m1, m2, lc;
+  void save(MMU &m) {
+    m1.assign(m.mem1.data(), m.mem1.data() + m.mem1.size());
+    m2.assign(m.mem2.data(), m.mem2.data() + m.mem2.size());
+    lc.assign(m.lc.data(), m.lc.data() + m.lc.size());
+  }
+  void restore(MMU &m) const {
+    std::memcpy(m.mem1.data(), m1.data(), m1.size());
+    std::memcpy(m.mem2.data(), m2.data(), m2.size());
+    std::memcpy(m.lc.data(), lc.data(), lc.size());
+  }
+};
+
+void diff_regs(const N1Slot &s, const N1Regs &g, const N1Regs &n) {
+  for (int i = 0; i < 32; ++i)
+    if (g.gpr[i] != n.gpr[i]) std::printf("[N1] %s verify r%d gen=0x%08x native=0x%08x\n", s.name, i, g.gpr[i], n.gpr[i]);
+  for (int i = 0; i < 32; ++i) {
+    if (g.fpr[i] != n.fpr[i])
+      std::printf("[N1] %s verify f%d gen=0x%016llx native=0x%016llx\n", s.name, i, (unsigned long long)g.fpr[i], (unsigned long long)n.fpr[i]);
+    if (g.ps1[i] != n.ps1[i])
+      std::printf("[N1] %s verify ps1_%d gen=0x%016llx native=0x%016llx\n", s.name, i, (unsigned long long)g.ps1[i], (unsigned long long)n.ps1[i]);
+  }
+  if (std::memcmp(g.cr, n.cr, sizeof g.cr)) std::printf("[N1] %s verify CR differs\n", s.name);
+  if (g.pc != n.pc || g.lr != n.lr || g.ctr != n.ctr || g.xer != n.xer || g.inst_count != n.inst_count ||
+      g.poll_left != n.poll_left)
+    std::printf("[N1] %s verify pc/lr/ctr/xer/inst/poll_left gen=%x/%x/%x/%x/%llu/%d native=%x/%x/%x/%x/%llu/%d\n", s.name,
+                g.pc, g.lr, g.ctr, g.xer, (unsigned long long)g.inst_count, g.poll_left, n.pc, n.lr, n.ctr, n.xer,
+                (unsigned long long)n.inst_count, n.poll_left);
+}
+
+// 32-byte blocks of guest RAM that differ from the snapshot: (block index over MEM1|MEM2|LC, contents).
+struct N1Blk { uint32_t idx; uint8_t b[32]; };
+void changed_blocks(MMU &m, const N1Snap &sn, std::vector<N1Blk> &out) {
+  out.clear();
+  uint32_t base = 0;
+  auto scan = [&](const MemBlock &mb, const std::vector<uint8_t> &sv) {
+    const size_t n = mb.size() & ~(size_t)31;
+    for (size_t o = 0; o < n; o += 4096) {
+      const size_t len = std::min<size_t>(4096, n - o);
+      if (std::memcmp(mb.data() + o, sv.data() + o, len) == 0) continue;
+      for (size_t k = o; k < o + len; k += 32)
+        if (std::memcmp(mb.data() + k, sv.data() + k, 32) != 0) {
+          N1Blk x;
+          x.idx = base + (uint32_t)(k / 32);
+          std::memcpy(x.b, mb.data() + k, 32);
+          out.push_back(x);
+        }
+    }
+    base += (uint32_t)((mb.size() + 31) / 32);
+  };
+  scan(m.mem1, sn.m1);
+  scan(m.mem2, sn.m2);
+  scan(m.lc, sn.lc);
+}
+uint8_t *block_ptr(MMU &m, const N1Snap &sn, uint32_t idx, const uint8_t **snapp, uint32_t *ea) {
+  const uint32_t n1 = (uint32_t)((m.mem1.size() + 31) / 32), n2 = (uint32_t)((m.mem2.size() + 31) / 32);
+  if (idx < n1) { *snapp = sn.m1.data() + idx * 32; *ea = 0x80000000u + idx * 32; return m.mem1.data() + idx * 32; }
+  idx -= n1;
+  if (idx < n2) { *snapp = sn.m2.data() + idx * 32; *ea = 0x90000000u + idx * 32; return m.mem2.data() + idx * 32; }
+  idx -= n2;
+  *snapp = sn.lc.data() + idx * 32; *ea = MMU::kLCBase + idx * 32;
+  return m.lc.data() + idx * 32;
+}
+
+// Native body on the current state, then the same state again through the generated code; the
+// generated result is kept. Only calls whose native run took no slow interrupt poll are compared
+// (a slow poll may run scheduler events, which cannot be undone): the others keep the native result.
+// Memory: the 32-byte blocks the native run changed (against a snapshot taken just before) are put back
+// from the snapshot (only those: other threads -- AX, render -- keep writing guest RAM meanwhile), the
+// generated code runs, and then every block that differs from the snapshot is compared: a block written
+// by both must hold the same bytes; a block written by only one side is a mismatch unless it is outside
+// what the function could write (reported with its address, so concurrent writers are recognisable).
+bool verify(N1Slot &s, CPUContext &ctx) {
+  static N1Snap snap;
+  static std::vector<N1Blk> bn, bg;
+  MMU &m = ctx.mmu;
+  const N1Regs r0 = take_regs(ctx);
+  snap.save(m);
+  const uint64_t slow0 = g_n1_slow;
+  if (!s.nat(ctx)) {
+    ++s.declined;
+    return false;  // untouched: the generated code runs
+  }
+  if (g_n1_slow != slow0) {
+    ++s.vskip;
+    return true;
+  }
+  const N1Regs rn = take_regs(ctx);
+  changed_blocks(m, snap, bn);
+  for (const N1Blk &x : bn) {
+    const uint8_t *sp = nullptr;
+    uint32_t ea = 0;
+    uint8_t *dst = block_ptr(m, snap, x.idx, &sp, &ea);  // first: it sets sp
+    std::memcpy(dst, sp, 32);
+  }
+  put_regs(ctx, r0);
+  g_bypass_slot = &s;
+  ctx.pc = s.entry;
+  s.gen(ctx);
+  g_bypass_slot = nullptr;
+  const N1Regs rg = take_regs(ctx);
+  changed_blocks(m, snap, bg);
+  const bool regs_ok = std::memcmp(&rg, &rn, sizeof rg) == 0;
+  // merge the two sorted lists
+  uint32_t bad_blocks = 0, only_n = 0, only_g = 0;
+  uint32_t first_ea[4] = {0, 0, 0, 0};
+  int nfirst = 0;
+  size_t i = 0, j = 0;
+  while (i < bn.size() || j < bg.size()) {
+    uint32_t idx;
+    bool differ;
+    if (j >= bg.size() || (i < bn.size() && bn[i].idx < bg[j].idx)) { idx = bn[i].idx; differ = true; ++only_n; ++i; }
+    else if (i >= bn.size() || bg[j].idx < bn[i].idx) { idx = bg[j].idx; differ = true; ++only_g; ++j; }
+    else { idx = bn[i].idx; differ = std::memcmp(bn[i].b, bg[j].b, 32) != 0; ++i; ++j; }
+    if (differ) {
+      ++bad_blocks;
+      const uint8_t *sp; uint32_t ea;
+      block_ptr(m, snap, idx, &sp, &ea);
+      if (nfirst < 4) first_ea[nfirst++] = ea;
+    }
+  }
+  if (regs_ok && bad_blocks == 0) {
+    ++s.vok;
+  } else {
+    ++s.vbad;
+    if (s.vbad <= 20) {
+      std::printf("[N1] %s verify MISMATCH (call %llu, r1=%08x r3=%08x r4=%08x r5=%08x): regs %s, %u RAM blocks differ "
+                  "(native-only %u, generated-only %u; native wrote %zu, generated %zu) first at %08x %08x %08x %08x\n",
+                  s.name, (unsigned long long)s.calls, r0.gpr[1], r0.gpr[3], r0.gpr[4], r0.gpr[5], regs_ok ? "same" : "DIFFER",
+                  bad_blocks, only_n, only_g, bn.size(), bg.size(), first_ea[0], first_ea[1], first_ea[2], first_ea[3]);
+      diff_regs(s, rg, rn);
+    }
+  }
+  const uint64_t n = s.vok + s.vbad;
+  if (n == 1 || (n & (n - 1)) == 0 || !(regs_ok && bad_blocks == 0)) report(s, "verify");
+  return true;
+}
+
+}  // namespace
+
+void n1_report_all() {
+  uint64_t ok = 0, bad = 0;
+  for (N1Slot *s = g_slots; s; s = s->next) {
+    if (s->mode == 3 || s->mode == 4) report(*s, s->mode == 4 ? "final (off)" : "final");
+    ok += s->vok;
+    bad += s->vbad;
+  }
+  std::printf("[N1] verify total ok=%llu bad=%llu\n", (unsigned long long)ok, (unsigned long long)bad);
+  std::fflush(stdout);
+}
+
+NWII_NOINLINE bool n1_hook_slow(N1Slot &s, CPUContext &ctx) {
+  if (s.mode == 0) {
+    const N1Cfg &c = n1_cfg();
+    char key[96];
+    std::snprintf(key, sizeof key, "NWII_NATIVE_%s", s.name);
+    const char *e = std::getenv(key);
+    const bool on = c.all_on && !(e && e[0] == '0') && !g_trace_calls;
+    s.mode = !on ? (c.stats ? 4 : 2) : (c.stats || c.verify_every) ? 3 : 1;
+    s.next = g_slots;
+    g_slots = &s;
+    std::printf("[N1] %s (0x%08X): %s\n", s.name, s.entry,
+                s.mode == 2 ? "off (generated code)" : s.mode == 4 ? "off (generated code), counted" :
+                s.mode == 3 ? "native, counters/verify" : "native");
+    std::fflush(stdout);
+  }
+  if (s.mode == 1) return s.nat(ctx);
+  if (g_bypass_slot == &s) { g_bypass_slot = nullptr; return false; }
+  if (s.mode == 2) return false;
+  ++s.calls;
+  const N1Cfg &c = n1_cfg();
+  if (s.mode == 4) {
+    if ((s.calls & 0x3FFFF) == 0) report(s, "stats (off)");
+    if (!c.timing) return false;
+    // time the generated code: run it here (its own hook is bypassed) instead of in the caller; same code,
+    // same state, one call level deeper
+    const uint64_t t0 = now_ticks();
+    g_bypass_slot = &s;
+    s.gen(ctx);
+    g_bypass_slot = nullptr;
+    N1Time &t = g_ticks[&s];
+    t.ticks += now_ticks() - t0;
+    ++t.n;
+    return true;
+  }
+  // verify the 1st, 2nd, 4th, 8th... call of each function (rare ones too) and then every n-th
+  if (c.verify_every && !(s.flags & 1) && ((s.calls & (s.calls - 1)) == 0 || s.calls % c.verify_every == 0))
+    return verify(s, ctx);
+  bool r;
+  if (c.timing) {
+    const uint64_t t0 = now_ticks();
+    r = s.nat(ctx);
+    if (r) { N1Time &t = g_ticks[&s]; t.ticks += now_ticks() - t0; ++t.n; }
+  } else {
+    r = s.nat(ctx);
+  }
+  if (r) ++s.native; else ++s.declined;
+  if ((s.calls & 0x3FFFF) == 0) report(s, "stats");
+  return r;
+}
+
+// ---- hand-written bodies -------------------------------------------------------------------------
+namespace {
+// Runs the interrupt polls 1..total of a loop exactly as the generated code would: a poll whose inline
+// part (poll_due) says "nothing to do" only decrements poll_left, so runs of them are done at once; a poll
+// that would take the slow path is done for real, with ctx in the state of that poll (set(j)). Returns
+// true when a poll delivered an interrupt (ctx is then at that poll; the generated code resumes there).
+template <class Set>
+NWII_FORCEINLINE bool n1_polls(CPUContext &c, uint64_t total, Set &&set) {
+  uint64_t j = 0;
+  while (j < total) {
+    const int32_t left = c.poll_left.load(std::memory_order_relaxed);
+    if (left > 1 && n1_no_flags(c)) {
+      const uint64_t k = std::min<uint64_t>(total - j, (uint64_t)(left - 1));
+      c.poll_left.store(left - (int32_t)k, std::memory_order_relaxed);
+      j += k;
+      continue;
+    }
+    ++j;
+    set(j);
+    if (poll_due(c)) {
+      ++g_n1_slow;
+      if (process_pending_callbacks_slow(c)) return true;
+    }
+  }
+  return false;
+}
+
+// DCInvalidateRange / DCFlushRange / (the other DC* have the same shape): r3 = address, r4 = length.
+//   cmplwi r4,0 ; blelr ; rlwinm r5,r3,0,27,31 ; add r4,r4,r5 ; addi r4,r4,31 ; rlwinm r4,r4,27,5,31 ;
+//   mtctr r4 ; loop: dcbX 0,r3 ; addi r3,r3,32 ; bdnz loop (poll at POLL) ; [sc (poll)] ; blr
+// The cache operation is a no-op here (no data cache model), so the whole function is its registers.
+template <uint32_t POLL, uint32_t SC>
+NWII_FORCEINLINE bool n1_dc_range(CPUContext &c) {
