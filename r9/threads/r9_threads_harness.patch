diff --color -ruN base/tools/game_thread_cats.sh threads/tools/game_thread_cats.sh
--- base/tools/game_thread_cats.sh	1969-12-31 19:00:00.000000000 -0500
+++ threads/tools/game_thread_cats.sh	2026-10-31 07:32:53.294158403 -0500
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+# Reparto del hilo del juego en un perfil perf de pc/prof.sh: % del hilo en escritura al FIFO de GX,
+# AX/DSP HLE, sondeo de interrupciones/reloj, código del juego. Uso: game_thread_cats.sh <x.data> <x.txt>
+d=$1; t=$2
+tid=$(grep -m1 'game CPU thread' "$t" | sed -E 's/^== ([0-9]+):.*/\1/')
+perf report -i "$d" --no-children --tid "$tid" --sort sym --stdio -q 2>/dev/null | python3 -I -c '
+import re,sys
+c={"wgp":0,"ax":0,"poll":0,"guest":0,"other":0}; tot=0
+for l in sys.stdin:
+    m=re.match(r"\s*([\d.]+)%\s+\[.\]\s+(.*)",l)
+    if not m: continue
+    p=float(m.group(1)); s=m.group(2); tot+=p
+    if re.search(r"wgp_|GX_WGPIPE|wg_flush|wg_",s): c["wgp"]+=p
+    elif re.search(r"runtime::ax::|ax_hle|dsp_|hw::dsp|ax_submit|ax_sync|ax_deliver",s): c["ax"]+=p
+    elif re.search(r"process_pending_callbacks|clock_gettime|EventScheduler|ppc_tail|ppc_full|read_timebase",s): c["poll"]+=p
+    elif re.search(r"(func_|_)8[0-9A-F]{7}\b",s) or s.startswith("func_"): c["guest"]+=p
+    else: c["other"]+=p
+print("game thread %.1f%% of samples: "%tot + "  ".join("%s %.1f%%"%(k,100*v/tot) for k,v in c.items()))
+'
diff --color -ruN base/tools/nx_thread_diag.cpp threads/tools/nx_thread_diag.cpp
--- base/tools/nx_thread_diag.cpp	1969-12-31 19:00:00.000000000 -0500
+++ threads/tools/nx_thread_diag.cpp	2026-10-31 07:05:11.273121690 -0500
@@ -0,0 +1,121 @@
+// R9 threads (test-only, linked into the Switch *_input_test.nro with
+// -Wl,--wrap=pthread_create): which threads the NRO has and on which cores.
+//
+// Every pthread_create (SDL audio, Mesa util_queue, our CPU and AX threads...)
+// goes through __wrap_pthread_create: the new thread logs
+//   [THR] #k start=<offset in the NRO> core=<current core> pref=<preferred> mask=<affinity> prio=<p>
+// when it starts, and a sampler thread (low priority, wakes every 10 s) logs the
+// same for every known thread, plus the main thread:
+//   [THR] t=<s> main pref=.. mask=.. | #1 pref=.. mask=.. | ...
+// so a thread that changes its own mask later (the CPU and AX threads do) shows
+// its final placement. Offsets map to symbols with
+//   aarch64-none-elf-nm -C nx/build/fast_input/nsmbw.elf  (start = offset + 0, the
+//   NRO is loaded at its link address 0 + base; we print start - &__start__).
+// On by default in the test NRO; debug.toml NWII_NX_THREADDIAG = "0" turns the
+// sampler off (the start lines are always written, once per thread).
+#include <switch.h>
+
+#include <pthread.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" {
+int __real_pthread_create(pthread_t *, const pthread_attr_t *, void *(*)(void *), void *);
+extern char __start__;  // libnx crt0: start of the loaded NRO image
+}
+
+namespace {
+
+constexpr int kMax = 32;
+struct Rec {
+  std::atomic<Handle> h{0};
+  uintptr_t start = 0;
+};
+Rec g_recs[kMax];
+std::atomic<int> g_n{0};
+Handle g_main = 0;
+
+struct Tramp {
+  void *(*fn)(void *);
+  void *arg;
+  int idx;
+};
+
+void describe(Handle h, char *buf, size_t n) {
+  s32 pref = -9;
+  u64 mask = 0;
+  s32 prio = -1;
+  if (R_FAILED(svcGetThreadCoreMask(&pref, &mask, h))) pref = -9;
+  if (R_FAILED(svcGetThreadPriority(&prio, h))) prio = -1;
+  std::snprintf(buf, n, "pref=%d mask=0x%llx prio=0x%x", (int)pref, (unsigned long long)mask,
+                (unsigned)prio);
+}
+
+void *tramp_entry(void *p) {
+  Tramp t = *(Tramp *)p;
+  std::free(p);
+  if (t.idx >= 0) g_recs[t.idx].h.store(threadGetCurHandle());
+  char d[96];
+  describe(threadGetCurHandle(), d, sizeof d);
+  std::printf("[THR] #%d start=+0x%lx core=%d %s\n", t.idx,
+              (unsigned long)(t.idx >= 0 ? g_recs[t.idx].start : 0),
+              (int)svcGetCurrentProcessorNumber(), d);
+  return t.fn(t.arg);
+}
+
+void *sampler(void *) {
+  svcSetThreadCoreMask(CUR_THREAD_HANDLE, 0, 1);  // core 0, lowest priority
+  svcSetThreadPriority(CUR_THREAD_HANDLE, 0x3F);
+  for (int s = 10;; s += 10) {
+    svcSleepThread(10'000'000'000ll);
+    char line[1024];
+    size_t u = 0;
+    char d[96];
+    describe(g_main, d, sizeof d);
+    u += std::snprintf(line + u, sizeof line - u, "[THR] t=%d main %s", s, d);
+    const int n = g_n.load();
+    for (int i = 0; i < n && u < sizeof line; ++i) {
+      const Handle h = g_recs[i].h.load();
+      if (!h) continue;
+      describe(h, d, sizeof d);
+      u += std::snprintf(line + u, sizeof line - u, " | #%d %s", i, d);
+    }
+    std::printf("%s\n", line);
+  }
+  return nullptr;
+}
+
+void start_sampler() {
+  static bool started = false;
+  if (started) return;
+  started = true;
+  g_main = threadGetCurHandle();
+  const char *e = std::getenv("NWII_NX_THREADDIAG");
+  if (e && e[0] == '0') return;
+  pthread_attr_t a;
+  pthread_attr_init(&a);
+  pthread_attr_setstacksize(&a, 64 * 1024);
+  pthread_t th;
+  if (__real_pthread_create(&th, &a, sampler, nullptr) == 0) pthread_detach(th);
+  std::printf("[THR] main thread core=%d (thread diag on, NWII_NX_THREADDIAG)\n",
+              (int)svcGetCurrentProcessorNumber());
+}
+
+}  // namespace
+
+extern "C" int __wrap_pthread_create(pthread_t *th, const pthread_attr_t *attr,
+                                     void *(*fn)(void *), void *arg) {
+  // The first pthread_create comes from the main thread (SDL init / CPU thread).
+  start_sampler();
+  const int idx = g_n.fetch_add(1);
+  Tramp *t = (Tramp *)std::malloc(sizeof(Tramp));
+  if (!t) return __real_pthread_create(th, attr, fn, arg);
+  t->fn = fn;
+  t->arg = arg;
+  t->idx = idx < kMax ? idx : -1;
+  if (t->idx >= 0) g_recs[t->idx].start = (uintptr_t)fn - (uintptr_t)&__start__;
+  return __real_pthread_create(th, attr, tramp_entry, t);
+}
diff --color -ruN base/tools/pc_cpu_per_inst.py threads/tools/pc_cpu_per_inst.py
--- base/tools/pc_cpu_per_inst.py	1969-12-31 19:00:00.000000000 -0500
+++ threads/tools/pc_cpu_per_inst.py	2026-10-31 07:32:02.250964324 -0500
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""PC: CPU del hilo del juego por instrucción del juego, de las líneas [FPS] de un run.log.
+Uso: pc_cpu_per_inst.py <run.log> [map|lvl11|N]  (cuenta las líneas [FPS] desde 2 después de llegar a la
+escena: "phase 1 starts" = mapa, "phase 2 starts" = 1-1; o desde la línea [FPS] número N)
+Saca: fps media, cpu thread %, host thread %, M instr./s, ns de CPU del hilo del juego por instrucción
+(cpu% * 1e7 / (Minst * 1e6)), y el reparto de wgp/ax si está en la línea."""
+import re, sys
+rows = []
+arg = sys.argv[2] if len(sys.argv) > 2 else 'map'
+want = {'map': 'phase 1 starts', 'lvl11': 'phase 2 starts'}.get(arg)
+seen = want is None
+for l in open(sys.argv[1], errors='replace'):
+    if not seen and want in l:
+        seen = True
+    if not l.startswith('[FPS]') or not seen:
+        continue
+    m = re.search(r'\[FPS\] ([\d.]+) presented.*guest ([\d.]+) Minst/s, host thread (\d+)%, cpu thread (\d+)%', l)
+    if not m:
+        continue
+    w = re.search(r'wgp (\d+)k writes/s (\d+)k flushes/s', l)
+    a = re.search(r'ax (\w+) (\d+) lists/s mix ([\d.]+) us', l)
+    rows.append((float(m.group(1)), float(m.group(2)), int(m.group(3)), int(m.group(4)),
+                 (int(w.group(1)), int(w.group(2))) if w else None, (a.group(1), float(a.group(3))) if a else None))
+skip = 2 if want else int(arg)
+r = rows[skip:]
+if not r:
+    print('no [FPS] rows'); sys.exit(1)
+n = len(r)
+fps = sum(x[0] for x in r) / n
+mi = sum(x[1] for x in r) / n
+ht = sum(x[2] for x in r) / n
+ct = sum(x[3] for x in r) / n
+ns = ct * 1e7 / (mi * 1e6)
+extra = ''
+ws = [x[4] for x in r if x[4]]
+if ws:
+    extra += ' wgp %.0fk writes/s %.0fk flushes/s' % (sum(a for a, _ in ws) / len(ws), sum(b for _, b in ws) / len(ws))
+ax = [x[5] for x in r if x[5]]
+if ax:
+    extra += ' ax %s mix %.1f us' % (ax[-1][0], sum(b for _, b in ax) / len(ax))
+print('n=%d fps %.1f  cpu thread %.1f%%  host thread %.1f%%  guest %.1f Minst/s  -> %.2f ns cpu/inst%s' % (n, fps, ct, ht, mi, ns, extra))
