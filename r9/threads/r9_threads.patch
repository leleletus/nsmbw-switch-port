+static void ax_submit_list(uint32_t addr, uint16_t size) {
+    const uint64_t ms = g_ctx_ptr->tb_freq / 1000;
+    if (!ax::async_enabled()) {  // inline: exactly the r7b sequence
+        ax::submit(addr, size);
+        if (ax::finish())
