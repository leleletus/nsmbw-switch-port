 bool g_early_gx_sync = NWII_ENV("NWII_LATE_SYNC") == nullptr;
 static bool s_bp_armed = false;
 
+namespace hw { extern bool g_wgp_redirect_on; }  // hw_pi.cpp
+
+// ---- R8 threads: write-gather buffer on the guest thread ---------------------
+// Every GXPosition/GXColor/... call wrote its 1-8 bytes straight into
+// g_hw_fifo under g_fifo_mutex (an atomic exchange + vector growth per call,
+// ~6% of the CPU thread). Like the real write-gather pipe, the bytes now
+// collect in a small buffer of the guest thread and go into g_hw_fifo in one
+// piece. Order and content of the stream are unchanged; only the moment the
+// host can see the bytes moves, and the host takes the FIFO at arbitrary
+// moments anyway (1 ms polls), so every stream the host can observe now is
+// one it could already observe before. The buffer is handed over:
+//   - when it is full;
+//   - after every possible BP command, i.e. 4 bytes after any 0x61 byte, so a
+//     BP (frame end = XFB copy, EFB copy, draw done, tokens) is visible to
+//     the host at the same moment as before;
+//   - when the guest idles (idle_wait).
+// The redirect test (FIFO pointed at a display list buffer in RAM) is a flag
+// kept by the PI/CP register writes instead of two calls per write.
+// NWII_WGP_DIRECT=1 restores the direct per-write path. The debug captures
+// (NWII_GXDUMP/NWII_WGSEG/NWII_WGTRACE) always use the direct path.
+// Guest thread only (all GX_WGPIPE_* callers are: MMIO writes, GX seams, the
+// CP FIFO drain of an MMIO write).
+//
+// R9 threads: which BPs force a hand-over. r8 threads handed the buffer over
+// after every possible BP (any 0x61 byte + 4), which in practice meant every
+// ~13 bytes (vertex data is full of 0x61 bytes and every draw sets BP
+// registers): ~290 000 locks of g_fifo_mutex per second, contended by the host
+// thread that takes the FIFO. Now (default) only the BPs whose host processing
+// can feed back into the guest are handed over at once:
+//   0x45 (draw done) 0x47/0x48 (tokens): the PE is signalled early, on this
+//        thread, right after the write; the host must own everything before
+//        it, as before;
+//   0x52 (EFB/XFB copy): the copy into guest RAM / the frame end (and the
+//        r8:memory frame count, which counts at that hand-over).
+// Every other byte (vertices, CP/XF loads, other BPs) waits until the buffer
+// is full (2 KB), the next such BP, or the guest idles. That is 1:1 for the
+// same reason the buffer is: the stream is the same, only the moment the host
+// can see a byte moves, and the host takes the FIFO at arbitrary moments
+// anyway. No other BP makes the host do anything the guest can observe (CP
+// status registers are not driven by the host). NWII_WGP_FLUSH=bp restores
+// the r8 rule (hand over after every possible BP).
+static constexpr uint32_t kWgCap = 2048;
+alignas(64) static uint8_t s_wg[kWgCap];
+static uint32_t s_wg_n = 0;
+// Bit k set: a possible BP command completes when k more bytes are appended.
+static uint32_t s_wg_bp = 0;
+// Same, for possible BPs whose register byte (the one after 0x61) is one that
+// must be handed over at once (see above).
+static uint32_t s_wg_crit = 0;
+static std::atomic<uint64_t> s_wg_writes{0}, s_wg_flushes{0}, s_wg_bytes{0};
+
+static inline bool wgp_gather() {
+    static const bool g = !wgp_debug() && NWII_ENV("NWII_WGP_DIRECT") == nullptr;
+    return g;
+}
+static inline bool wgp_flush_every_bp() {
