+        if (c.type == GXCommandType::BPRegister && c.reg == 0x52) {
+            if ((c.val & 0x4000) && !c.stale_copy) ++s_p_kept_dropped;
+            s_p_kept.back().stale_copy = true;
+        }
+    }
