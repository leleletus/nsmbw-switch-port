diff --color -ruN r22r7/nWiiRuntime/include/runtime/x2_wgpipe.h r27x2/nWiiRuntime/include/runtime/x2_wgpipe.h
--- r22r7/nWiiRuntime/include/runtime/x2_wgpipe.h	1969-12-31 19:00:00.000000000 -0500
+++ r27x2/nWiiRuntime/include/runtime/x2_wgpipe.h	2026-11-10 05:15:27.873845054 -0500
@@ -0,0 +1,152 @@
+// X2 (r9/r27x2): stores to the GX write-gather pipe (0xCC008000) appended in
+// line, at the generated call sites the recompiler already proved to be MMIO
+// (`mv_.writeN_io`, the "listed MMIO sites" of R12 fastmem).
+//
+// Before: mv_.write8_io -> MMU::write8_slow (out of line: watch test, page
+// test) -> GX_WGPIPE_Write8 (out of line, another TU: mode/redirect tests,
+// BP/LOAD_INDX state machine, room test, store). Now the site itself tests
+// "pipe page and room in the buffer while the inline paths are allowed" with
+// one compare (g_wgi.lim is the buffer cap only while the R16w inline paths
+// may be used: write-gather on, no debug check, no display list being built
+// into RAM, NWII_X2_INLINE not 0; 0 otherwise) and does exactly what the
+// inline paths of GX_WGPIPE_Write8/16/32/F32 (hle/gx.cpp) do: same bytes into
+// the same buffer, same state machine (shared code: x2_sniff8), same write
+// counter. Everything else (no room -> flush, BP that hands the buffer over,
+// CP/LOAD_INDX/CALL_DL values, redirect, debug modes, other MMIO pages) falls
+// back to the old call, which handles it as before.
+//
+// Only the generated files rewritten by r27x2/tools/apply_x2.py include this
+// header; no header the base objects were compiled against changes.
+#pragma once
+#include "runtime/cpu_context.h"
+#include <cstdint>
+#include <cstring>
+
+namespace nwii {
+namespace runtime {
+
+struct alignas(64) WgInline {
+    uint32_t n;          // bytes in buf (R16w s_wg_n)
+    uint32_t lim;        // s_wg_cap while the inline paths may be used, else 0
+    int32_t sn_st;       // LOAD_INDX / CP / CALL_DL sniffer state (R16w s_sn_st)
+    uint32_t sn_a;       // its pending byte / address (s_sn_a)
+    bool bp_armed;       // last write was Write8(0x61) (s_bp_armed)
+    bool idx_on;         // NWII_IDXSNAP (s_idx_on), copied at the first write
+    bool flush_all_bp;   // NWII_WGP_FLUSH_ALL_BP
+    uint64_t writes;     // pipe writes (s_wg_writes_l)
+    uint32_t sn_base[4]; // CP array bases / strides seen in the pipe (s_sn_base / s_sn_stride)
+    uint32_t sn_stride[4];
+    alignas(64) uint8_t buf[4096];  // the write-gather buffer (s_wg)
+};
+// hidden: the sites reach it PC-relative (adrp+add), not through the GOT
+extern WgInline g_wgi __attribute__((visibility("hidden")));
+
+// R16w idx_sniff8 (with NWII_IDXSNAP on): the one copy of the state machine.
+NWII_FORCEINLINE void x2_sniff8(WgInline &g, uint8_t b) {
+    switch (g.sn_st) {
+    case 1: g.sn_st = 2; g.sn_a = b; return;
+    case 6: g.sn_st = 7; return;
+    case 7: g.sn_st = 0; return;
+    default: break;
+    }
+    g.sn_st = b == 0x08 ? 1 : (b & 0xE7) == 0x20 ? 3 : b == 0x40 ? 4 : b == 0x78 ? 6 : 0;
+    g.sn_a = b;
+}
+// BPs that hand the buffer over (R16w wg_bp_hands_over)
+NWII_FORCEINLINE bool x2_bp_hands_over(const WgInline &g, uint8_t reg) {
+    return reg == 0x52 || reg == 0x45 || reg == 0x47 || reg == 0x48 || g.flush_all_bp;
+}
+
+#define NWII_X2_PIPE(a) ((((a) & 0x3FFFF000u) == 0x0C008000u))
+
+NWII_FORCEINLINE void x2_w8(MemView &mv, uint32_t addr, uint8_t v) {
+    WgInline &g = g_wgi;
+    const uint32_t n = g.n;
+    if (NWII_LIKELY(NWII_X2_PIPE(addr) && n < g.lim)) {
+        g.bp_armed = v == 0x61;
+        if (g.idx_on) x2_sniff8(g, v);
+        ++g.writes;
+        g.buf[n] = v;
+        g.n = n + 1;
+        return;
+    }
+    mv.write8_io(addr, v);
+}
+NWII_FORCEINLINE void x2_w16(MemView &mv, uint32_t addr, uint16_t v) {
+    WgInline &g = g_wgi;
+    const uint32_t n = g.n;
+    if (NWII_LIKELY(NWII_X2_PIPE(addr) && n + 2 <= g.lim)) {
+        g.bp_armed = false;
+        g.sn_st = 0;
+        ++g.writes;
+        const uint16_t be = __builtin_bswap16(v);
+        std::memcpy(g.buf + n, &be, 2);
+        g.n = n + 2;
+        return;
+    }
+    mv.write16_io(addr, v);
+}
+NWII_FORCEINLINE void x2_wf32(MemView &mv, uint32_t addr, float f) {
+    WgInline &g = g_wgi;
+    const uint32_t n = g.n;
+    if (NWII_LIKELY(NWII_X2_PIPE(addr) && n + 4 <= g.lim)) {
+        uint32_t u;
+        std::memcpy(&u, &f, 4);
+        g.bp_armed = false;
+        g.sn_st = 0;
+        ++g.writes;
+        const uint32_t be = __builtin_bswap32(u);
+        std::memcpy(g.buf + n, &be, 4);
+        g.n = n + 4;
+        return;
+    }
+    mv.write_f32_io(addr, f);
+}
+// Integer word: data (nothing pending), a BP that needs no hand-over and the
+// value of a CP register write go in line, as in GX_WGPIPE_Write32 (R16w w4);
+// the word after a LOAD_INDX / CALL_DL opcode and a hand-over BP take the old
+// path.
+NWII_FORCEINLINE void x2_w32(MemView &mv, uint32_t addr, uint32_t v) {
+    WgInline &g = g_wgi;
+    const uint32_t n = g.n;
+    if (NWII_LIKELY(NWII_X2_PIPE(addr) && n + 4 <= g.lim)) {
+        const int32_t st = g.sn_st;
+        if (NWII_LIKELY(st == 0 && (!g.bp_armed || !x2_bp_hands_over(g, (uint8_t)(v >> 24))))) {
+            g.bp_armed = false;
+        } else if (st == 2 && !g.bp_armed) {
+            g.sn_st = 0;
+            const uint32_t a = g.sn_a;
+            if (a >= 0xAC && a <= 0xAF) g.sn_base[a - 0xAC] = v & 0x3FFFFFFF;
+            else if (a >= 0xBC && a <= 0xBF) g.sn_stride[a - 0xBC] = v & 0xFF;
+        } else {
+            mv.write32_io(addr, v);
+            return;
+        }
+        ++g.writes;
+        const uint32_t be = __builtin_bswap32(v);
+        std::memcpy(g.buf + n, &be, 4);
+        g.n = n + 4;
+        return;
+    }
+    mv.write32_io(addr, v);
+}
+
+// psq_st at a listed MMIO site (GXLoadPosMtxImm / GXLoadTexMtxImm copy the
+// matrix rows into the pipe with psq_l/psq_st). The out-of-line
+// CPUContext::psq_store with a float GQR stores ps0 (and ps1 if W == 0) as
+// MMU::write_f32 of ConvertToSingleFTZ; for the pipe page that reaches
+// write_f32_slow -> GX_WGPIPE_WriteF32, so x2_wf32 does the same (and falls
+// back to write_f32_slow, which also covers RAM, as MMU::write_f32 does once
+// its fast test fails). Other GQR types: the original call.
+NWII_FORCEINLINE void x2_psq_st(CPUContext &ctx, MemView &mv, uint32_t S, uint32_t ea, uint32_t W, uint32_t I) {
+    if (NWII_LIKELY((ctx.gqr[I] & 0x7u) == 0 && NWII_X2_PIPE(ea))) {
+        const double p0 = ctx.fpr[S], p1 = ctx.ps1[S];
+        x2_wf32(mv, ea, f32_from(ppc_single_bits_ftz(p0)));
+        if (W == 0) x2_wf32(mv, ea + 4, f32_from(ppc_single_bits_ftz(p1)));
+        return;
+    }
+    ctx.psq_store(S, ea, W, I);
+}
+
+}  // namespace runtime
+}  // namespace nwii
