+// X2 self-test (NWII_X2_SELFTEST=1, at the first pipe write): the same random
+// write sequence goes (A) through the generated sites' inline functions
+// (x2_wgpipe.h, with their fallback to the old call) and (B) through the
+// R16w GX_WGPIPE_* entry points; the hand-over streams, the sniffer state,
+// the CP array state and the write counters must be equal. The hand-overs
+// are captured (not sent to the host) and the state is restored afterwards.
+// The sequence avoids what has side effects outside this state (BPs that
+// signal the PE or end a frame, LOAD_INDX and CALL_DL values).
+static void x2_selftest() {
+    if (!g_mmu) return;
+    struct St { WgInline g; uint32_t base[4], stride[4]; };
+    auto save = [](St &t) {
+        std::memcpy(&t.g, &g_wgi, sizeof g_wgi);
+        std::memcpy(t.base, s_sn_base, sizeof t.base);
+        std::memcpy(t.stride, s_sn_stride, sizeof t.stride);
+    };
+    auto load = [](const St &t) {
+        std::memcpy(&g_wgi, &t.g, sizeof g_wgi);
+        std::memcpy(s_sn_base, t.base, sizeof t.base);
+        std::memcpy(s_sn_stride, t.stride, sizeof t.stride);
+    };
+    St *orig = new St, *ra = new St, *rb = new St;
+    save(*orig);
+    struct Op { uint8_t kind, nolim; uint32_t v; };
+    std::vector<Op> ops;
+    std::vector<uint8_t> ca, cb;
+    const int kOps = 400000;
+    ops.reserve(kOps);
+    uint64_t rng = 0x9E3779B97F4A7C15ull;
+    auto rnd = [&rng]() { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return (uint32_t)(rng >> 16); };
+    static const uint8_t kB[] = {0x61, 0x61, 0x08, 0x20, 0x28, 0x30, 0x38, 0x40, 0x78,
+                                 0xAC, 0xAD, 0xBC, 0xBF, 0x90, 0x98, 0x00, 0xFF};
+    MemView mv(*g_mmu);
+    const uint32_t A = 0xCC008000u;
+    // (A) inline functions
+    s_x2_cap = &ca;
+    const uint32_t lim = g_wgi.lim;
+    for (int i = 0; i < kOps; ++i) {
+        Op o;
+        o.kind = rnd() % 4;  // 0 w8, 1 w16, 2 w32, 3 f32
+        o.nolim = (rnd() % 16) == 0;
+        uint32_t r = rnd();
+        o.v = (r & 1) ? kB[(r >> 1) % sizeof kB] : rnd();
+        if (o.kind == 2) {
+            if (g_wgi.sn_st >= 3 && g_wgi.sn_st <= 5) o.kind = 3;  // no LOAD_INDX / CALL_DL value
+            else {
+                o.v = (rnd() << 8) | (rnd() & 0xFF);
+                if (g_wgi.bp_armed) {
+                    uint8_t reg = rnd() & 0xFF;
+                    if (reg == 0x45 || reg == 0x47 || reg == 0x48 || reg == 0x52) reg = 0x49;
+                    o.v = (o.v & 0x00FFFFFFu) | ((uint32_t)reg << 24);
+                }
+            }
+        }
+        ops.push_back(o);
+        g_wgi.lim = o.nolim ? 0 : lim;
+        float f;
+        switch (o.kind) {
+        case 0: x2_w8(mv, A, (uint8_t)o.v); break;
+        case 1: x2_w16(mv, A + (rnd() & 0xFFC), (uint16_t)o.v); break;
+        case 2: x2_w32(mv, A, o.v); break;
+        default: std::memcpy(&f, &o.v, 4); x2_wf32(mv, A, f); break;
+        }
+    }
+    g_wgi.lim = lim;
+    if (s_wg_n) wg_flush_now();
+    save(*ra);
+    // (B) the R16w entry points
+    load(*orig);
+    s_x2_cap = &cb;
+    for (const Op &o : ops) {
+        float f;
+        switch (o.kind) {
