+          s = pm[0] * v[0] + pm[1] * v[1] + pm[2] * v[2] + pm[3];
+          tt = pm[4] * v[0] + pm[5] * v[1] + pm[6] * v[2] + pm[7];
+          q = stq ? pm[8] * v[0] + pm[9] * v[1] + pm[10] * v[2] + pm[11] : 1.0f;
+        } else {
