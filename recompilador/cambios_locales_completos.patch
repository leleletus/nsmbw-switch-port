+    auto &c = cfg.c[t];
+    c.stq = (info >> 1) & 1;
+    c.abc1 = (info >> 2) & 1;
+    c.mtx = ((info >> 4) & 7) == 0;
+    c.row = (info >> 7) & 0x1F;
+    c.post = c.mtx && dual;
