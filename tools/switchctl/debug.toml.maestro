# debug.toml — SOLO para pruebas (no va en la release). Bórralo para jugar normal.
fps_log = true          # fps, memoria, hilos y audio cada 5 s en logs/nwii.log
profile = false         # 15-nov 18:10: APAGADO. Medido M12 frente a M10 (m6e): con el perfilador el agua dibuja 43 fps y sin él 47 (castillo 54→57). Poner true solo para sacar profile_*.txt
#cpu_boost = true       # experimental: CPU a 1785 MHz
NWII_POLL_STATS = "1"   # contadores del sondeo de interrupciones en la línea de fps
#NWII_NORING = "0"      # anillo de vértices: en r10e el mapa bajó de 17 a 11-13 fps con él; desactivado
MESA_NO_ERROR = "1"     # r10e: OpenGL sin comprobación de errores en cada llamada (ahorra CPU)
NWII_NX_TILT_INVERT = "1"   # 15-nov: la inclinación por movimiento de los Joy-Con iba al revés (pedido del usuario); borrar esta línea para volver al signo anterior

# 16-nov: binario m6q instalado; trae de fábrica todo lo anterior (fusión del agua, agua nativa, audio, registro en segundo plano) más la fusión de dibujos de listas. Para apagar algo: <NOMBRE>_OFF = "1".
