+// r15dk parche 4: los mismos bytes que OutputDksh, a un buffer que da el llamador.
+void DekoCompiler::OutputDkshMem(void* (*grow)(void* user, size_t size), void* user)
+{
+	DkshHeader hdr = {};
+	hdr.magic        = DKSH_MAGIC;
+	hdr.header_sz    = sizeof(DkshHeader);
+	hdr.control_sz   = Align256(sizeof(DkshHeader) + sizeof(DkshProgramHeader));
+	hdr.code_sz      = Align256((m_stage != pipeline_stage_compute ? 0x80 : 0x00) + m_codeSize) + Align256(m_dataSize);
+	hdr.programs_off = sizeof(DkshHeader);
+	hdr.num_programs = 1;
+	size_t total = hdr.control_sz + hdr.code_sz;
+	uint8_t* p = (uint8_t*)grow(user, total);
+	if (!p) return;
+	memset(p, 0, total);
+	memcpy(p, &hdr, sizeof(hdr));
+	memcpy(p + sizeof(hdr), &m_dkph, sizeof(m_dkph));
+	size_t off = hdr.control_sz;
+	if (m_stage != pipeline_stage_compute)
+	{
+		static const char s_padding[s_shaderStartOffset] = "lol nvidia why did you make us waste space here";
+		memcpy(p + off, s_padding, sizeof(s_padding)); off += sizeof(s_padding);
+		memcpy(p + off, &m_nvsh, sizeof(m_nvsh)); off += sizeof(m_nvsh);
+	}
+	memcpy(p + off, m_code, m_codeSize); off += m_codeSize;
+	off = Align256(off);
+	if (m_dataSize)
+		memcpy(p + off, m_data, m_dataSize);
+}
