+static NWII_NOINLINE void nwii_a2_axfx_report() {
+  const A2AxStat& s = g_a2_ax;
+  const double tpu = a2_ticks_per_us();
+  std::printf("[A2] axfx %llu calls: kernel1 %.1f us/call (%llu), kernel2 %.1f us/call (%llu), kernel2+next %.1f us/call (%llu), "
+              "kcheck ok=%llu bad=%llu, overlap check skipped %llu\n",
+              (unsigned long long)s.calls, s.n[1] ? s.t[1] / tpu / s.n[1] : 0.0, (unsigned long long)s.n[1],
+              s.n[2] ? s.t[2] / tpu / s.n[2] : 0.0, (unsigned long long)s.n[2],
+              s.n[3] ? s.t[3] / tpu / s.n[3] : 0.0, (unsigned long long)s.n[3], (unsigned long long)s.kc_ok,
+              (unsigned long long)s.kc_bad, (unsigned long long)s.ov_skip);
+  std::fflush(stdout);
+}
