+// NWII_AXFX_KCHECK round: kernel 2 vs kernel 1 on the same input. All writable regions are
+// disjoint (checked before), so saving and restoring them is enough.
+static NWII_NOINLINE void nwii_a2_axfx_kcheck(A2AxK& K, const R9AxRgn* rg, int nr,
+                                             uint8_t* (*hp)(void*, uint32_t), void* hpctx) {
+  static std::vector<uint8_t> save, res;
+  size_t tot = 0;
+  for (int i = 0; i < nr; ++i) if (rg[i].w) tot += rg[i].n;
+  save.resize(tot);
