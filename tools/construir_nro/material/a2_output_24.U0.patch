+// kernel 2: the same in float, with prefetch (see the header comment)
+static inline float a2_rf(const uint8_t* q) {
+  uint32_t v;
+  std::memcpy(&v, q, 4);
+  v = __builtin_bswap32(v);
+  float f;
+  std::memcpy(&f, &v, 4);
+  return f;
+}
+static inline void a2_wf(uint8_t* q, float f) {
+  uint32_t v;
+  std::memcpy(&v, &f, 4);
+  v = __builtin_bswap32(v);
+  std::memcpy(q, &v, 4);
+}
+// prefetch the line holding element i+d of a ring of n 4-byte elements (wrapping to 0)
+static inline void a2_pf(const uint8_t* base, uint32_t i, uint32_t n, uint32_t d) {
+  uint32_t j = i + d;
+  if (j >= n) { j -= n; if (j >= n) j %= n; }
+  __builtin_prefetch(base + 4u * j, 1, 3);
+}
+static inline void a2_pf2(const uint8_t* base, uint32_t i, uint32_t n, uint32_t d) {
+  uint32_t j = i + d;
+  if (j >= n) { j -= n; if (j >= n) j %= n; }
+  __builtin_prefetch(base + 4u * j, 1, 2);
+}
+static NWII_NOINLINE void nwii_a2_axfx_k2(A2AxK& K, bool pf_next = false) {
+  static const bool pf_on = [] { const char* e = NWII_ENV("NWII_AXFX_PREFETCH"); return !(e && e[0] == '0'); }();
+  uint8_t *const *in = K.in, *const *sd = K.sd, *const *E = K.E, *const *PD = K.PD, *const *B3 = K.B3, *const *ou = K.ou;
+  uint32_t ei0 = K.ei[0], ei1 = K.ei[1], ei2 = K.ei[2], pdi = K.pdi;
+  uint32_t ci[3] = {K.ci[0], K.ci[1], K.ci[2]}, ai[2] = {K.ai[0], K.ai[1]};
+  uint32_t b3i[3] = {K.b3i[0], K.b3i[1], K.b3i[2]};
+  const uint32_t esz = K.esz, pdn = K.pdn, g29 = K.g29;
+  const uint32_t cn[3] = {K.cn[0], K.cn[1], K.cn[2]}, an[2] = {K.an[0], K.an[1]};
+  const uint32_t b3n[3] = {K.b3n[0], K.b3n[1], K.b3n[2]};
+  const bool send = K.send != 0, outp = K.outp != 0;
+  const float k32 = (float)K.k32, k36 = (float)K.k36, k40 = (float)K.k40;
+  const float kc[3] = {(float)K.kc[0], (float)K.kc[1], (float)K.kc[2]};
+  const double k320 = K.k320, k324 = K.k324;
+  const float z = (float)K.z;
+  const float f1 = (float)K.f1, f3 = (float)K.f3, f4 = (float)K.f4, f5 = (float)K.f5, f6 = (float)K.f6;
+  const double f0 = K.f0;
+  float lp[3] = {(float)K.lp[0], (float)K.lp[1], (float)K.lp[2]};
+  const uint64_t hi = K.hi;
+  // prefetch of every stream d elements ahead
+  auto prefetch = [&](uint32_t n, uint32_t d) {
+    for (int ch = 0; ch < 3; ++ch) {
+      if (n + d < 96) {
+        __builtin_prefetch(in[ch] + 4 * (n + d), 1, 3);
+        if (send) __builtin_prefetch(sd[ch] + 4 * (n + d), 0, 3);
+        if (outp) __builtin_prefetch(ou[ch] + 4 * (n + d), 1, 3);
+      }
+      a2_pf(E[ch], ei0, esz, d);
+      a2_pf(E[ch], ei1, esz, d);
+      a2_pf(E[ch], ei2, esz, d);
+      if (pdn != 0) a2_pf(PD[ch], pdi, pdn, d);
+      for (int k = 0; k < 3; ++k) a2_pf(K.C[ch][k], ci[k], cn[k], d);
+      for (int k = 0; k < 2; ++k) a2_pf(K.A[ch][k], ai[k], an[k], d);
+      a2_pf(B3[ch], b3i[ch], b3n[ch], d);
+    }
+  };
+  if (pf_on) { prefetch(0, 0); prefetch(0, 16); }
+  for (uint32_t n = 0; n < 95; ++n) {
+    if (pf_on && (n & 15) == 0) prefetch(n, 32);
+    float acc[3];
+    for (int ch = 0; ch < 3; ++ch) {
+      uint32_t x;
+      std::memcpy(&x, in[ch] + 4 * n, 4);
+      x = __builtin_bswap32(x);
+      if (send) { uint32_t y; std::memcpy(&y, sd[ch] + 4 * n, 4); x = x + __builtin_bswap32(y); }
+      const float f11 = (float)(nwii::runtime::f64_from(hi | (uint32_t)(x ^ 0x80000000u)) - f0);
+      // early reflections
+      uint8_t* const e = E[ch];
+      float f8 = a2_rf(e + 4 * ei0);
+      float f2 = a2_rf(e + 4 * ei1);
+      f8 = k32 * f8;
+      float f9 = a2_rf(e + 4 * ei2);
+      f2 = k36 * f2;
+      a2_wf(e + 4 * ei2, f11);
+      float f7 = k40 * f9;
+      f2 = f8 + f2;
+      f2 = f7 + f2;
+      // pre-delay
+      if (pdn != 0) {
+        f9 = a2_rf(PD[ch] + 4 * pdi);
+        a2_wf(PD[ch] + 4 * pdi, f11);
+      } else {
+        f9 = f11;
+      }
+      // combs
+      float f10 = z;
+      for (int k = 0; k < 3; ++k) {
+        uint8_t* const q = K.C[ch][k] + 4 * ci[k];
+        f8 = a2_rf(q);
+        f7 = f8 * kc[k];
+        f10 = f10 + f8;
+        f7 = f9 + f7;
+        a2_wf(q, f7);
+      }
+      // all-passes
+      {
+        uint8_t* const q = K.A[ch][0] + 4 * ai[0];
+        f8 = a2_rf(q);
+        f7 = f8 * f3;
+        f7 = f10 + f7;
+        a2_wf(q, f7);
+        f7 = f7 * f3;
+        f8 = f8 - f7;
+      }
+      {
+        uint8_t* const q = K.A[ch][1] + 4 * ai[1];
+        f9 = a2_rf(q);
+        f7 = f9 * f3;
+        f7 = f8 + f7;
+        a2_wf(q, f7);
+        f8 = f7 * f3;
+      }
+      // low-pass
+      f7 = lp[ch];
+      f8 = f9 - f8;
+      f7 = f1 * f7;
+      f8 = f4 * f8;
+      f9 = f8 + f7;
+      lp[ch] = f9;
+      // per-channel all-pass
+      {
+        uint8_t* const q = B3[ch] + 4 * b3i[ch];
+        f8 = a2_rf(q);
+        f7 = f8 * f3;
+        f7 = f9 + f7;
+        a2_wf(q, f7);
+        f7 = f7 * f3;
+        if (++b3i[ch] >= b3n[ch]) b3i[ch] = g29;
+        f7 = f8 - f7;
+      }
+      f7 = f7 * f5;
+      f2 = f7 + f2;
+      acc[ch] = f2;
+    }
+    // cross-talk and outputs (L = ch0, R = ch1, S = ch2)
+    const float f10 = acc[0], f12 = acc[1], f11 = acc[2];
+    float f2 = f12 + f11;
+    float f7 = f10 + f11;
+    float f9 = f2 * f6;
+    float f8 = f7 * f6;
+    const float f13 = f10 + f12;
+    f9 = f10 + f9;
+    f8 = f12 + f8;
+    f7 = f13 * f6;
+    f7 = f11 + f7;
+    auto fct = [](float v) -> uint32_t { return __builtin_bswap32(nwii::runtime::ppc_fctiwz((double)v)); };
+    auto st = [](uint8_t* q, uint32_t v) { std::memcpy(q, &v, 4); };
+    st(in[0] + 4 * n, fct(f9 * (float)k320));
+    st(in[1] + 4 * n, fct(f8 * (float)k320));
+    st(in[2] + 4 * n, fct(f7 * (float)k320));
+    if (outp) {
+      st(ou[0] + 4 * n, fct(f9 * (float)k324));
+      st(ou[1] + 4 * n, fct(f8 * (float)k324));
+      st(ou[2] + 4 * n, fct(f7 * (float)k324));
+    }
+    // indices
+    if (++ei0 >= esz) ei0 = g29;
+    if (++ei1 >= esz) ei1 = g29;
+    if (++ei2 >= esz) ei2 = g29;
+    if (pdn != 0 && ++pdi >= pdn) pdi = g29;
+    for (int k = 0; k < 3; ++k) if (++ci[k] >= cn[k]) ci[k] = g29;
+    for (int k = 0; k < 2; ++k) if (++ai[k] >= an[k]) ai[k] = g29;
+  }
+  K.ei[0] = ei0; K.ei[1] = ei1; K.ei[2] = ei2; K.pdi = pdi;
+  for (int k = 0; k < 3; ++k) { K.ci[k] = ci[k]; K.b3i[k] = b3i[k]; K.lp[k] = (double)lp[k]; }
+  K.ai[0] = ai[0]; K.ai[1] = ai[1];
+  // [a2pfnext] the next call (3 ms later) reads the following 95 elements of every delay line:
+  // ask for them now, into L2 only (PSTL2KEEP), so that call starts with them near.
+  if (pf_next) {
+    auto pr = [](const uint8_t* b, uint32_t i, uint32_t n) {
+      for (uint32_t d = 0; d < 96 + 16; d += 16) a2_pf2(b, i, n, d);
+    };
+    for (int ch = 0; ch < 3; ++ch) {
+      pr(E[ch], ei0, esz); pr(E[ch], ei1, esz); pr(E[ch], ei2, esz);
+      if (pdn != 0) pr(PD[ch], pdi, pdn);
+      for (int k = 0; k < 3; ++k) pr(K.C[ch][k], ci[k], cn[k]);
+      for (int k = 0; k < 2; ++k) pr(K.A[ch][k], ai[k], an[k]);
+      pr(B3[ch], b3i[ch], b3n[ch]);
+    }
+  }
+}
